  have case11 (h : ∀ v ∈ ([(1, 0, 0), (0, 1, -1)] : List (ℤ × ℤ × ℤ)), φ v = 0) : good := by
    apply testWord G φ e (fun i j z => z + δ i j) latticeEdge (n := 8) (by decide)
