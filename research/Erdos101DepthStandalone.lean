import FormalConjectures.ErdosProblems.«101»
import Mathlib

/-! # Two-round anchor bounds for Erdős 101

A positive-density counterexample would have a positive-density subset in which every
point is obtained by two rounds of intersections of joins, starting with at most
`O(n^(3/8))` of its own points. `Erdos101OverlapExponent.extract` proves the finite
extraction and `Erdos101OverlapExponent.gap_iff` gives the equivalence to the original
little-o conjecture. The one-round anchor proof is included to make this file standalone. -/

-- Reduction Erdos101.erdos_101.R3 of Erdős Problem 101
-- Credit: @ubuwaits

/-
# Four-point lines generated by a small set of anchors

The first step extracts a large subset in which every point outside a set of
anchors is the intersection of two distinct lines through pairs of anchors.
The extraction retains a positive density of four-point lines. We give an
unconditional proof of this step by sampling pairs in the pencils through
individual points. The second step asks for sparsity just for configurations
generated in this one intersection step from at most a constant times the
square root of the number of points.
-/

namespace OMA.R_Erdos101_erdos_101_R3
open EuclideanGeometry Filter Asymptotics
open scoped Classical

/-- At fixed positive density one can retain a positive fraction of the points
and a positive density of four-point lines in a subset generated by few anchors. -/
def H1 : Prop :=
  ∀ s : ℕ, 0 < s → ∃ N : ℕ, ∀ S : Finset ℝ², N ≤ S.card →
    NonCollinearFor 5 (S : Set ℝ²) →
    S.card ^ 2 ≤ s * (linesWithPointsFor 4 (S : Set ℝ²)).ncard →
    ∃ T B : Finset ℝ², T ⊆ S ∧ B ⊆ T ∧ S.card ≤ 4 * s * T.card ∧
      B.card ^ 2 ≤ 4096 * s ^ 3 * T.card ∧
      T.card ^ 2 ≤ 4 * s * (linesWithPointsFor 4 (T : Set ℝ²)).ncard ∧
      ∀ p ∈ T, p ∈ B ∨ ∃ a ∈ B, ∃ b ∈ B, ∃ c ∈ B, ∃ d ∈ B,
        a ≠ b ∧ c ≠ d ∧ line[ℝ,a,b] ≠ line[ℝ,c,d] ∧
        p ∈ line[ℝ,a,b] ∧ p ∈ line[ℝ,c,d]

/-- Uniform sparsity for sets generated in one intersection step from few anchors. -/
def H2 : Prop :=
  ∀ s C : ℕ, 0 < s → ∃ N : ℕ, ∀ T B : Finset ℝ², N ≤ T.card →
    NonCollinearFor 5 (T : Set ℝ²) → B ⊆ T → B.card ^ 2 ≤ C * T.card →
    (∀ p ∈ T, p ∈ B ∨ ∃ a ∈ B, ∃ b ∈ B, ∃ c ∈ B, ∃ d ∈ B,
      a ≠ b ∧ c ≠ d ∧ line[ℝ,a,b] ≠ line[ℝ,c,d] ∧
      p ∈ line[ℝ,a,b] ∧ p ∈ line[ℝ,c,d]) →
    s * (linesWithPointsFor 4 (T : Set ℝ²)).ncard < T.card ^ 2

theorem main : H1 → H2 → type_of% @Erdos101.erdos_101 := by
  intro extract sparse
  apply IsLittleO.of_bound
  intro ε ep
  obtain ⟨s,inv⟩ := exists_nat_gt (1 / ε)
  have pos : (0 : ℝ) < s := (one_div_pos.mpr ep).trans inv
  have sp := Nat.cast_pos.mp pos
  have prod : 1 ≤ ε * s := by simpa [mul_comm] using ((div_lt_iff₀ ep).mp inv).le
  obtain ⟨N,take⟩ := extract s sp
  obtain ⟨M,gap⟩ := sparse (4*s) (4096*s^3) (by positivity)
  filter_upwards [eventually_ge_atTop (max N (4*s*M))] with n large
  rw [Real.norm_of_nonneg (Nat.cast_nonneg _), Real.norm_of_nonneg (sq_nonneg _)]
  have upper : Erdos101.numLinesWithFourPointMax n ≤ ⌊ε * (n : ℝ)^2⌋₊ := by
    apply csSup_le'
    rintro _ ⟨U,uc,finite,cap,rfl⟩
    let S := finite.toFinset
    have eq : (S : Set ℝ²) = U := finite.coe_toFinset
    have sc : S.card = n := (Set.ncard_eq_toFinset_card U finite).symm.trans uc
    have small : s * (linesWithPointsFor 4 U).ncard < n^2 := by
      by_contra! dense
      obtain ⟨T,B,ts,bt,size,cheap,count,generated⟩ := take S
        (sc ▸ (le_max_left ..).trans large) (eq ▸ cap) (by simpa only [eq,sc] using dense)
      rw [sc] at size
      have mt := Nat.le_of_mul_le_mul_left (((le_max_right ..).trans large).trans size)
        (show 0 < 4*s by positivity)
      have tcap := NonCollinearFor.subset (Finset.coe_subset.mpr ts) (show NonCollinearFor 5 (S : Set ℝ²) from eq ▸ cap)
      exact (gap T B mt tcap bt cheap generated).not_ge count
    apply Nat.le_floor
    have rr : (s : ℝ) * (linesWithPointsFor 4 U).ncard ≤ (n : ℝ)^2 := by exact_mod_cast small.le
    apply le_of_mul_le_mul_left (a := (s : ℝ)) _ pos
    calc (s : ℝ) * (linesWithPointsFor 4 U).ncard ≤ (n : ℝ)^2 := rr
         _ = 1 * (n : ℝ)^2 := (one_mul _).symm
         _ ≤ (ε * s) * (n : ℝ)^2 := mul_le_mul_of_nonneg_right prod (sq_nonneg _)
         _ = s * (ε * (n : ℝ)^2) := by ring
  exact (Nat.cast_le.mpr upper).trans (Nat.floor_le (mul_nonneg ep.le (sq_nonneg _)))

end OMA.R_Erdos101_erdos_101_R3

noncomputable section
namespace Erdos101AnchorGeometry
open EuclideanGeometry Finset
open scoped Classical

abbrev Weight := Fin 3 → ℝ
abbrev Line := AffineSubspace ℝ ℝ²

def ev (p : ℝ²) : Weight →ₗ[ℝ] ℝ where
  toFun w := w 0+p 0*w 1+p 1*w 2
  map_add' u v := by simp; ring
  map_smul' t w := by simp; ring

def normal (p q : ℝ²) : Weight := ![p 0*q 1-q 0*p 1,p 1-q 1,q 0-p 0]

theorem on_line {p q r : ℝ²} (ne : p≠q) : ev r (normal p q)=0 ↔ r∈line[ℝ,p,q] := by
  change p 0*q 1-q 0*p 1+r 0*(p 1-q 1)+r 1*(q 0-p 0)=0 ↔ _
  rw [mem_affineSpan_pair_iff_exists_lineMap_eq]
  constructor
  · intro h
    by_cases xeq : q 0=p 0
    · have dy : q 1-p 1≠0 := by
        apply sub_ne_zero.mpr; intro he; apply ne; ext i; fin_cases i <;> symm <;> assumption
      have rx : r 0=p 0 := by
        apply sub_eq_zero.mp ((mul_eq_zero.mp (show (r 0-p 0)*(q 1-p 1)=0 by rw [xeq] at h; linear_combination -h)).resolve_right dy)
      refine ⟨(r 1-p 1)/(q 1-p 1),?_⟩
      ext i; fin_cases i <;> simp [AffineMap.lineMap_apply_module,xeq,rx] <;> field_simp [dy] <;> ring
    · have dx := sub_ne_zero.mpr xeq
      refine ⟨(r 0-p 0)/(q 0-p 0),?_⟩
      ext i; fin_cases i <;> simp [AffineMap.lineMap_apply_module] <;> field_simp [dx] <;>
        first | linear_combination -h | ring
  · rintro ⟨t,rfl⟩
    simp [AffineMap.lineMap_apply_module]
    ring

def pencil (p : ℝ²) (I : Finset ℝ²) := I.image (fun q => line[ℝ,p,q])

def determined (S : Finset ℝ²) : Finset Line := S.offDiag.image (fun e => line[ℝ,e.1,e.2])
def incident (S : Finset ℝ²) (L : Line) := S.filter (fun p => p∈L)
def mult (S : Finset ℝ²) (L : Line) := (incident S L).card

theorem mem_determined {S : Finset ℝ²} {L : Line} :
    L∈determined S ↔ ∃ a∈S, ∃ b∈S, a≠b ∧ line[ℝ,a,b]=L := by
  constructor
  · intro h
    obtain ⟨⟨a,b⟩,hab,eq⟩ := Finset.mem_image.mp h
    obtain ⟨ha,hb,ne⟩ := Finset.mem_offDiag.mp hab
    exact ⟨a,ha,b,hb,ne,eq⟩
  · rintro ⟨a,ha,b,hb,ne,eq⟩
    exact Finset.mem_image.mpr ⟨(a,b),Finset.mem_offDiag.mpr ⟨ha,hb,ne⟩,eq⟩

theorem unique_line {S : Finset ℝ²} {L : Line} (hL : L∈determined S) {p q : ℝ²}
    (hp : p∈L) (hq : q∈L) (ne : p≠q) : line[ℝ,p,q]=L := by
  obtain ⟨_,_,_,_,_,rfl⟩ := mem_determined.mp hL
  exact affineSpan_pair_eq_of_mem_of_mem_of_ne hp hq ne

theorem mult_two {S : Finset ℝ²} {L : Line} (hL : L∈determined S) : 2 ≤ mult S L := by
  obtain ⟨a,ha,b,hb,ne,rfl⟩ := mem_determined.mp hL
  exact Finset.one_lt_card.mpr ⟨a,Finset.mem_filter.mpr ⟨ha,left_mem_affineSpan_pair ..⟩,
    b,Finset.mem_filter.mpr ⟨hb,right_mem_affineSpan_pair ..⟩,ne⟩

private theorem through_insert {I S : Finset ℝ²} {p : ℝ²} (sub : I⊆S) (ps : p∈S) (new : p∉I) :
    (determined S).filter (fun L => p∈L ∧ (incident I L).Nonempty) = pencil p I := by
  ext L
  constructor
  · intro h
    obtain ⟨ld,pl,q,hq⟩ := Finset.mem_filter.mp h
    obtain ⟨qi,ql⟩ := Finset.mem_filter.mp hq
    exact Finset.mem_image.mpr ⟨q,qi,unique_line ld pl ql (fun e => new (e ▸ qi))⟩
  · intro h
    obtain ⟨q,qi,rfl⟩ := Finset.mem_image.mp h
    exact Finset.mem_filter.mpr ⟨mem_determined.mpr ⟨p,ps,q,sub qi,fun e => new (e ▸ qi),rfl⟩,
      left_mem_affineSpan_pair ..,q,Finset.mem_filter.mpr ⟨qi,right_mem_affineSpan_pair ..⟩⟩

theorem full_pencil {S : Finset ℝ²} {p : ℝ²} (ps : p∈S) :
    pencil p (S.erase p)=(determined S).filter (fun L => p∈L) := by
  rw [← through_insert (Finset.erase_subset ..) ps (Finset.notMem_erase p S)]
  apply Finset.filter_congr
  intro L hl
  constructor
  · exact And.left
  · intro pl
    obtain ⟨a,ha,b,hb,ne,rfl⟩ := mem_determined.mp hl
    refine ⟨pl,?_⟩
    by_cases e : a=p
    · exact ⟨b,Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨fun eq => ne (e.trans eq.symm),hb⟩,
        right_mem_affineSpan_pair ..⟩⟩
    · exact ⟨a,Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨e,ha⟩,left_mem_affineSpan_pair ..⟩⟩

def count (S : Finset ℝ²) (k : ℕ) := ((determined S).filter (fun L => mult S L=k)).card

theorem count_eq (S : Finset ℝ²) (k : ℕ) : count S k=(linesWithPointsFor k (S : Set ℝ²)).ncard := by
  have eq : (↑((determined S).filter (fun L => mult S L=k)) : Set Line)=linesWithPointsFor k (S : Set ℝ²) := by
    ext L
    have coe : (incident S L : Set ℝ²)=(L : Set ℝ²) ∩ S := by ext p; simp [incident,and_comm]
    simp only [Finset.mem_coe,Finset.mem_filter,mem_determined,linesWithPointsFor,Set.mem_ofPred_eq,
      mult,← Set.ncard_coe_finset,coe]
    simp [exists_prop]
  rw [← eq,Set.ncard_coe_finset,count]

theorem capped {S : Finset ℝ²} (hcap : NonCollinearFor 5 (S : Set ℝ²)) {a b : ℝ²} :
    mult S (line[ℝ,a,b]) ≤ 4 := by
  by_contra! h
  obtain ⟨U,sub,size⟩ := Finset.exists_subset_card_eq (show 5 ≤ (incident S (line[ℝ,a,b])).card from h)
  apply hcap (U : Set ℝ²) (Finset.coe_subset.mpr (sub.trans (Finset.filter_subset ..))) U.finite_toSet (by simpa using size)
  apply (collinear_iff_exists_forall_eq_smul_vadd _).mpr
  refine ⟨a,b -ᵥ a,?_⟩
  intro p hp
  obtain ⟨t,ht⟩ := mem_affineSpan_pair_iff_exists_lineMap_eq.mp (Finset.mem_filter.mp (sub hp)).2
  exact ⟨t,ht.symm⟩

end Erdos101AnchorGeometry

/- Sampling a common set of anchors. Disjoint pairs on the lines through
one point give pairwise independent events. A second-moment bound controls
the number of points with fewer than two available lines. -/
noncomputable section
namespace Erdos101AnchorSampling
open Finset
open scoped BigOperators Classical
variable {α : Type*} [Fintype α] [DecidableEq α]

def anchors {k : ℕ} [NeZero k] (c : α → Fin k) := Finset.univ.filter (fun a => c a=0)
def indicator {k : ℕ} [NeZero k] (T : Finset α) (c : α → Fin k) : ℝ :=
  if T⊆anchors c then 1 else 0

private theorem fixed_count {k : ℕ} [NeZero k] (T : Finset α) :
    (Finset.univ.filter (fun c : α → Fin k => T⊆anchors c)).card=k^(Fintype.card α-T.card) := by
  let P (a : α) : Finset (Fin k) := if a∈T then {0} else Finset.univ
  have eq : Finset.univ.filter (fun c : α → Fin k => T⊆anchors c)=Fintype.piFinset P := by
    ext c
    simp only [Finset.mem_filter,Finset.mem_univ,true_and,Fintype.mem_piFinset]
    constructor
    · intro sub a
      by_cases h : a∈T
      · simpa [P,h] using (Finset.mem_filter.mp (sub h)).2
      · simp [P,h]
    · intro all a h
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,by simpa [P,h] using all a⟩
  rw [eq,Fintype.card_piFinset]
  have split := Finset.prod_sdiff (f:=fun a => (P a).card) (Finset.subset_univ T)
  rw [← split]
  have a : (∏ i∈T, (P i).card)=1 := Finset.prod_eq_one (fun i hi => by simp [P,hi])
  have b : ∀ i∈Finset.univ\T, (P i).card=k := fun i hi => by simp [P,(Finset.mem_sdiff.mp hi).2]
  rw [a,mul_one,Finset.prod_congr rfl b]
  simp [Finset.card_sdiff_of_subset (Finset.subset_univ T)]

theorem mean_indicator {k : ℕ} [NeZero k] (T : Finset α) :
    (𝔼 c : α → Fin k, indicator T c)=1/(k:ℝ)^T.card := by
  rw [Fintype.expect_eq_sum_div_card]
  simp only [indicator,Finset.sum_boole,fixed_count,Fintype.card_fun,Fintype.card_fin,Nat.cast_pow]
  have le := Finset.card_le_univ T
  have eq : Fintype.card α=Fintype.card α-T.card+T.card := (Nat.sub_add_cancel le).symm
  nth_rw 2 [eq]
  rw [pow_add]
  have pos : 0<(k:ℝ) := by exact_mod_cast NeZero.pos k
  field_simp

private theorem multiply {k : ℕ} [NeZero k] (A B : Finset α) (c : α → Fin k) :
    indicator A c*indicator B c=indicator (A∪B) c := by
  by_cases ha : A⊆anchors c <;> by_cases hb : B⊆anchors c <;> simp [indicator,Finset.union_subset_iff,ha,hb]

def hits {k : ℕ} [NeZero k] (B : Finset (Finset α)) (c : α → Fin k) :=
  (B.filter (fun T => T⊆anchors c)).card

private theorem sum_indicator {k : ℕ} [NeZero k] (B : Finset (Finset α)) (c : α → Fin k) :
    (∑ T∈B, indicator T c)=(hits B c:ℝ) := by simp [indicator,hits]

private theorem centered {k : ℕ} [NeZero k] {A B : Finset α} (ha : A.card=2) (hb : B.card=2) :
    (𝔼 c : α → Fin k, (indicator A c-1/(k:ℝ)^2)*(indicator B c-1/(k:ℝ)^2)) =
      1/(k:ℝ)^(A∪B).card-(1/(k:ℝ)^2)^2 := by
  let a := 1/(k:ℝ)^2
  have expand (c : α → Fin k) : (indicator A c-a)*(indicator B c-a) =
      (indicator (A∪B) c-indicator A c*a)-a*indicator B c+a*a := by rw [← multiply]; ring
  change (𝔼 c : α → Fin k, (indicator A c-a)*(indicator B c-a))=_
  simp_rw [expand]
  rw [Finset.expect_add_distrib,Finset.expect_sub_distrib,Finset.expect_sub_distrib,
    ← Finset.expect_mul,← Finset.mul_expect,Fintype.expect_const,mean_indicator,mean_indicator,
    mean_indicator,ha,hb]
  dsimp [a]; ring

theorem variance_bound {k : ℕ} [NeZero k] (B : Finset (Finset α))
    (two : ∀ T∈B,T.card=2) (dis : (B : Set (Finset α)).PairwiseDisjoint id) :
    (𝔼 c : α → Fin k, ((hits B c:ℝ)-(B.card:ℝ)/(k:ℝ)^2)^2) ≤ (B.card:ℝ)/(k:ℝ)^2 := by
  let a := 1/(k:ℝ)^2
  have expand (c : α → Fin k) :
      ((hits B c:ℝ)-(B.card:ℝ)/(k:ℝ)^2)^2 =
        ∑ T∈B, ∑ U∈B, (indicator T c-a)*(indicator U c-a) := by
    rw [← Finset.sum_mul_sum]
    have sub : (∑ T∈B, (indicator T c-a))=(hits B c:ℝ)-(B.card:ℝ)/(k:ℝ)^2 := by
      rw [Finset.sum_sub_distrib,sum_indicator]; simp [a,div_eq_mul_inv]
    rw [sub,pow_two]
  simp_rw [expand,Finset.expect_sum_comm]
  have off (T) (ht : T∈B) (U) (hu : U∈B) (ne : U≠T) :
      (𝔼 c : α → Fin k, (indicator T c-a)*(indicator U c-a))=0 := by
    rw [centered (two T ht) (two U hu),Finset.card_union_of_disjoint (show Disjoint T U from dis ht hu ne.symm),two T ht,two U hu]
    dsimp [a]; ring
  have diag (T) (ht : T∈B) : (𝔼 c : α → Fin k, (indicator T c-a)*(indicator T c-a)) ≤ a := by
    rw [centered (two T ht) (two T ht),Finset.union_idempotent,two T ht]
    exact sub_le_self _ (sq_nonneg _)
  calc (∑ T∈B, ∑ U∈B, 𝔼 c : α → Fin k, (indicator T c-a)*(indicator U c-a)) ≤ ∑ _T∈B, a := by
         apply Finset.sum_le_sum; intro T ht
         rw [Finset.sum_eq_single_of_mem T ht (off T ht)]
         exact diag T ht
       _ = _ := by simp [a,div_eq_mul_inv]

/-- If d disjoint pairs are available, a uniform 1/k sample misses the
two-pair threshold with probability at most 2k²/d. -/
theorem miss_bound {k : ℕ} [NeZero k] (B : Finset (Finset α))
    (two : ∀ T∈B,T.card=2) (dis : (B : Set (Finset α)).PairwiseDisjoint id)
    (degree : 4*k^2 ≤ B.card) :
    (𝔼 c : α → Fin k, if hits B c < 2 then (1:ℝ) else 0) ≤ 2*(k:ℝ)^2/B.card := by
  let mu := (B.card:ℝ)/(k:ℝ)^2
  have kp : 0<(k:ℝ) := by exact_mod_cast NeZero.pos k
  have hm : 4 ≤ mu := (le_div_iff₀ (sq_pos_of_pos kp)).mpr (by exact_mod_cast degree)
  have pos : 0 < mu := by linarith
  have per (c : α → Fin k) : (if hits B c<2 then (1:ℝ) else 0)*(mu^2/2) ≤ ((hits B c:ℝ)-mu)^2 := by
    split_ifs with small
    · have val : (hits B c:ℝ)≤1 := by exact_mod_cast (show hits B c≤1 by omega)
      have b : 3*mu/4 ≤ mu-(hits B c:ℝ) := by linarith
      nlinarith only [sq_nonneg mu,sq_le_sq' (by linarith : -(mu-(hits B c:ℝ)) ≤ 3*mu/4) b]
    · simpa using sq_nonneg ((hits B c:ℝ)-mu)
  have ineq := Finset.expect_le_expect (s:=Finset.univ) (fun c _ => per c)
  rw [← Finset.expect_mul] at ineq
  have h := ineq.trans (variance_bound B two dis)
  have bound : (𝔼 c : α → Fin k, if hits B c<2 then (1:ℝ) else 0) ≤ 2/mu := by
    apply (le_div_iff₀ pos).mpr
    apply le_of_mul_le_mul_right (a:=mu) _ pos
    nlinarith only [h]
  exact bound.trans_eq (by simp [mu,div_eq_mul_inv,mul_comm,mul_assoc])

theorem mean_anchors {k : ℕ} [NeZero k] :
    (𝔼 c : α → Fin k, ((anchors c).card:ℝ))=(Fintype.card α:ℝ)/k := by
  have eq (c : α → Fin k) : ((anchors c).card:ℝ)=∑ p : α, indicator {p} c := by
    simp [indicator,anchors]
  simp_rw [eq,Finset.expect_sum_comm,mean_indicator]
  simp [div_eq_mul_inv]

end Erdos101AnchorSampling

/- Coordinate fields of intersections of lines joining prescribed anchors. -/
noncomputable section
namespace Erdos101AnchorField
open Erdos101AnchorGeometry EuclideanGeometry Finset
open scoped Classical

def coords (B : Finset ℝ²) := B.image (fun p => p 0) ∪ B.image (fun p => p 1)
def field (B : Finset ℝ²) := IntermediateField.adjoin ℚ (coords B : Set ℝ)

def determinedBy (B : Finset ℝ²) (p : ℝ²) := ∃ a∈B, ∃ b∈B, ∃ c∈B, ∃ d∈B,
  a≠b ∧ c≠d ∧ line[ℝ,a,b]≠line[ℝ,c,d] ∧ p∈line[ℝ,a,b] ∧ p∈line[ℝ,c,d]

theorem point_coords {B : Finset ℝ²} {p : ℝ²} (hp : p∈B) (i : Fin 2) : p i∈field B := by
  apply IntermediateField.subset_adjoin
  fin_cases i
  · exact Finset.mem_union_left _ (Finset.mem_image_of_mem _ hp)
  · exact Finset.mem_union_right _ (Finset.mem_image_of_mem _ hp)

/-- The lines may be vertical. Only their distinctness and a genuine finite
intersection are used in solving for the two coordinates. -/
theorem intersection_field {B : Finset ℝ²} {p : ℝ²} (h : determinedBy B p) (i : Fin 2) :
    p i∈field B := by
  obtain ⟨a,ha,b,hb,c,hc,d,hd,ab,cd,ne,hp,hq⟩ := h
  let u := normal a b
  let v := normal c d
  let D := u 1*v 2-u 2*v 1
  have ep : u 0+p 0*u 1+p 1*u 2=0 := (on_line ab).mpr hp
  have eq : v 0+p 0*v 1+p 1*v 2=0 := (on_line cd).mpr hq
  have det : D≠0 := by
    intro zero
    let r : ℝ² := !₂[p 0+u 2,p 1-u 1]
    have r1 : r∈line[ℝ,a,b] := by
      apply (on_line ab).mp
      change u 0+(p 0+u 2)*u 1+(p 1-u 1)*u 2=0
      linear_combination ep
    have r2 : r∈line[ℝ,c,d] := by
      apply (on_line cd).mp
      change v 0+(p 0+u 2)*v 1+(p 1-u 1)*v 2=0
      dsimp only [D] at zero
      linear_combination eq-zero
    have diff : p≠r := by
      intro e
      have ex := congrArg (fun x : ℝ² => x 0) e
      have ey := congrArg (fun x : ℝ² => x 1) e
      change p 0=p 0+(b 0-a 0) at ex
      change p 1=p 1-(a 1-b 1) at ey
      apply ab; ext j; fin_cases j
      · change a 0=b 0; linarith only [ex]
      · change a 1=b 1; linarith only [ey]
    apply ne
    exact (affineSpan_pair_eq_of_mem_of_mem_of_ne hp r1 diff).symm.trans
      (affineSpan_pair_eq_of_mem_of_mem_of_ne hq r2 diff)
  let K := field B
  have nm {s t : ℝ²} (hs : s∈B) (ht : t∈B) (k : Fin 3) : normal s t k∈K := by
    fin_cases k
    · exact K.sub_mem (K.mul_mem (point_coords hs 0) (point_coords ht 1))
        (K.mul_mem (point_coords ht 0) (point_coords hs 1))
    · exact K.sub_mem (point_coords hs 1) (point_coords ht 1)
    · exact K.sub_mem (point_coords ht 0) (point_coords hs 0)
  have um (k : Fin 3) : u k∈K := nm ha hb k
  have vm (k : Fin 3) : v k∈K := nm hc hd k
  have dm : D∈K := K.sub_mem (K.mul_mem (um 1) (vm 2)) (K.mul_mem (um 2) (vm 1))
  fin_cases i
  · have value : p 0=(u 2*v 0-u 0*v 2)/D := (eq_div_iff det).mpr (by
      dsimp only [D]; linear_combination v 2*ep-u 2*eq)
    change p 0∈K
    rw [value]
    exact K.div_mem (K.sub_mem (K.mul_mem (um 2) (vm 0)) (K.mul_mem (um 0) (vm 2))) dm
  · have value : p 1=(u 0*v 1-u 1*v 0)/D := (eq_div_iff det).mpr (by
      dsimp only [D]; linear_combination u 1*eq-v 1*ep)
    change p 1∈K
    rw [value]
    exact K.div_mem (K.sub_mem (K.mul_mem (um 0) (vm 1)) (K.mul_mem (um 1) (vm 0))) dm

/-- Finite algebraically independent scalars in a field of rational functions
of g given real generators number at most g. -/
theorem independent_in_generated (X G : Finset ℝ)
    (ind : AlgebraicIndependent ℚ (fun x : X => (x:ℝ)))
    (incl : ∀ x∈X, x∈IntermediateField.adjoin ℚ (G : Set ℝ)) : X.card≤G.card := by
  let M := AlgebraicIndependent.matroid ℚ ℝ
  have mi : M.Indep (X : Set ℝ) := AlgebraicIndependent.matroid_indep_iff.mpr ind
  have sub : (X : Set ℝ)⊆M.closure (G : Set ℝ) := by
    intro x hx
    rw [show M=AlgebraicIndependent.matroid ℚ ℝ from rfl,AlgebraicIndependent.matroid_closure_eq]
    change IsAlgebraic (Algebra.adjoin ℚ (G : Set ℝ)) x
    obtain ⟨r,hr,s,hs,rfl⟩ := IntermediateField.mem_adjoin_iff_div.mp (incl x hx)
    let A := Algebra.adjoin ℚ (G : Set ℝ)
    have ar : IsAlgebraic A r := isAlgebraic_algebraMap (⟨r,hr⟩ : A)
    have as' : IsAlgebraic A s := isAlgebraic_algebraMap (⟨s,hs⟩ : A)
    rw [div_eq_mul_inv]
    exact (Subalgebra.algebraicClosure A ℝ).mul_mem ar as'.inv
  have h := M.eRk_mono sub
  rw [mi.eRk_eq_encard,M.eRk_closure_eq] at h
  have hc := h.trans (M.eRk_le_encard _)
  simpa using hc

def independentX (U : Finset ℝ²) := AlgebraicIndependent ℚ (fun p : U => p.val 0)

theorem independent_subset {U T : Finset ℝ²} (ind : independentX U) (sub : T⊆U) : independentX T := by
  let inc (p : T) : U := ⟨p.val,sub p.property⟩
  exact ind.comp inc (fun a b h => Subtype.ext (congrArg (fun p : U => p.val) h))

theorem count_determined {U : Finset ℝ²} (ind : independentX U) (B : Finset ℝ²) :
    (U.filter (determinedBy B)).card≤2*B.card := by
  let T := U.filter (determinedBy B)
  let x (p : ℝ²) := p 0
  have it : AlgebraicIndependent ℚ (fun p : T => x p.val) := independent_subset ind (Finset.filter_subset (determinedBy B) U)
  have inj : (T : Set ℝ²).InjOn x := by
    intro a ha b hb eq
    exact congrArg Subtype.val (it.injective (a₁:=⟨a,ha⟩) (a₂:=⟨b,hb⟩) eq)
  have independentImage : AlgebraicIndependent ℚ (fun z : T.image x => (z:ℝ)) := by
    change AlgebraicIndependent ℚ (fun z : (↑(T.image x) : Set ℝ) => (z:ℝ))
    rw [Finset.coe_image]
    exact AlgebraicIndependent.image (s := (T : Set ℝ²)) (f := x) it
  have h := independent_in_generated (T.image x) (coords B) independentImage (by
    intro z hz
    obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp hz
    exact intersection_field (Finset.mem_filter.mp hp).2 0)
  rw [Finset.card_image_of_injOn inj] at h
  exact h.trans ((Finset.card_union_le ..).trans (by
    have h0 := Finset.card_image_le (s:=B) (f:=fun p : ℝ² => p 0)
    have h1 := Finset.card_image_le (s:=B) (f:=fun p : ℝ² => p 1)
    omega))

end Erdos101AnchorField

/- Simultaneous reconstruction by one round of intersections of joins.
The same random anchors are used for every point and every line. -/
noncomputable section
namespace Erdos101AnchorJoins
open Erdos101AnchorSampling Erdos101AnchorField Erdos101AnchorGeometry EuclideanGeometry Finset
open scoped BigOperators Classical

def sample {k : ℕ} [NeZero k] {U : Finset ℝ²} (color : U → Fin k) : Finset ℝ² :=
  (anchors color).image Subtype.val
def missed (U B : Finset ℝ²) := U.filter (fun p => ¬determinedBy B p)
def star (A : Finset Line) (p : ℝ²) := A.filter (fun L => p∈L)

theorem sample_sub {k : ℕ} [NeZero k] {U : Finset ℝ²} (c : U → Fin k) : sample c⊆U := by
  intro p hp
  obtain ⟨a,_,rfl⟩ := Finset.mem_image.mp hp
  exact a.property

theorem sample_card {k : ℕ} [NeZero k] {U : Finset ℝ²} (c : U → Fin k) :
    (sample c).card=(anchors c).card := Finset.card_image_of_injective _ Subtype.val_injective

private theorem pair_at {U : Finset ℝ²} {L : Line} {p : U} (onL : p.val∈L)
    (three : 3 ≤ mult U L) :
    ∃ T : Finset U, T.card=2 ∧ ∀ t∈T, t≠p ∧ t.val∈L := by
  let I := (incident U L).erase p.val
  have many : 1<I.card := by
    have h : ((incident U L).erase p.val).card=(incident U L).card-1 :=
      Finset.card_erase_of_mem (Finset.mem_filter.mpr ⟨p.property,onL⟩)
    change 1<((incident U L).erase p.val).card
    change 3≤(incident U L).card at three
    omega
  obtain ⟨a,ha,b,hb,ne⟩ := Finset.one_lt_card.mp many
  obtain ⟨ap,am⟩ := Finset.mem_erase.mp ha
  obtain ⟨bp,bm⟩ := Finset.mem_erase.mp hb
  obtain ⟨au,al⟩ := Finset.mem_filter.mp am
  obtain ⟨bu,bl⟩ := Finset.mem_filter.mp bm
  let a' : U := ⟨a,au⟩
  let b' : U := ⟨b,bu⟩
  have ne' : a'≠b' := fun e => ne (congrArg Subtype.val e)
  refine ⟨{a',b'},Finset.card_pair ne',?_⟩
  intro t ht
  rcases Finset.mem_insert.mp ht with rfl|h
  · exact ⟨fun e => ap (congrArg Subtype.val e),al⟩
  · obtain rfl := Finset.mem_singleton.mp h
    exact ⟨fun e => bp (congrArg Subtype.val e),bl⟩

theorem pair_family {S U : Finset ℝ²} {A : Finset Line} (proper : A⊆determined S)
    (three : ∀ L∈A,3 ≤ mult U L) (p : U) :
    ∃ B : Finset (Finset U), B.card=(star A p.val).card ∧
      (∀T∈B,T.card=2) ∧ (B : Set (Finset U)).PairwiseDisjoint id ∧
      ∀ {k : ℕ} [NeZero k] (c : U → Fin k), 2≤hits B c → determinedBy (sample c) p.val := by
  classical
  let H := star A p.val
  have properties (L : H) := Finset.mem_filter.mp L.property
  choose mask size data using fun L : H => pair_at (p:=p) (properties L).2 (three L.val (properties L).1)
  have dis {L M : H} (ne : L≠M) : Disjoint (mask L) (mask M) := by
    apply Finset.disjoint_left.mpr
    intro w wl wm
    obtain ⟨wp,wL⟩ := data L w wl
    have wM := (data M w wm).2
    have sep : p.val≠w.val := fun e => wp (Subtype.ext e.symm)
    exact ne (Subtype.ext ((unique_line (proper (properties L).1) (properties L).2 wL sep).symm.trans
      (unique_line (proper (properties M).1) (properties M).2 wM sep)))
  have inj : Function.Injective mask := by
    intro L M eq
    by_contra ne
    obtain ⟨w,hw⟩ := Finset.card_pos.mp (by rw [size L]; decide)
    exact Finset.disjoint_left.mp (dis ne) hw (eq ▸ hw)
  let B := Finset.univ.image mask
  refine ⟨B,by simp [B,H,Finset.card_image_of_injective _ inj],?_,?_,?_⟩
  · intro T ht
    obtain ⟨L,_,rfl⟩ := Finset.mem_image.mp ht
    exact size L
  · intro T ht V hv ne
    obtain ⟨L,_,rfl⟩ := Finset.mem_image.mp ht
    obtain ⟨M,_,rfl⟩ := Finset.mem_image.mp hv
    exact dis (fun e => ne (congrArg mask e))
  · intro k _ c many
    obtain ⟨T,ht,V,hv,ne⟩ := Finset.one_lt_card.mp many
    obtain ⟨tm,ts⟩ := Finset.mem_filter.mp ht
    obtain ⟨vm,vs⟩ := Finset.mem_filter.mp hv
    obtain ⟨L,_,rfl⟩ := Finset.mem_image.mp tm
    obtain ⟨M,_,rfl⟩ := Finset.mem_image.mp vm
    have join (J : H) (inside : mask J⊆anchors c) :
        ∃ a∈sample c, ∃ b∈sample c, a≠b ∧ line[ℝ,a,b]=J.val := by
      obtain ⟨u,hu,v,hv,uv⟩ := Finset.one_lt_card.mp (show 1<(mask J).card by rw [size J]; decide)
      have diff : u.val≠v.val := fun eq => uv (Subtype.ext eq)
      exact ⟨u.val,Finset.mem_image_of_mem _ (inside hu),v.val,Finset.mem_image_of_mem _ (inside hv),diff,
        unique_line (proper (properties J).1) (data J u hu).2 (data J v hv).2 diff⟩
    obtain ⟨a,ha,b,hb,ab,lab⟩ := join L ts
    obtain ⟨d,hd,e,he,de,lde⟩ := join M vs
    refine ⟨a,ha,b,hb,d,hd,e,he,ab,de,?_,lab ▸ (properties L).2,lde ▸ (properties M).2⟩
    rw [lab,lde]
    exact fun eq => ne (congrArg mask (Subtype.ext eq))

theorem mean_missed {S U : Finset ℝ²} {A : Finset Line} (proper : A⊆determined S)
    (three : ∀ L∈A,3 ≤ mult U L) {k d : ℕ} [NeZero k] (threshold : 4*k^2≤d)
    (minimum : ∀p∈U, d≤(star A p).card) :
    (𝔼 c : U → Fin k, ((missed U (sample c)).card:ℝ)) ≤
        U.card*(2*(k:ℝ)^2/d) := by
  classical
  have hk := NeZero.pos k
  have dp : 0<(d:ℝ) := by exact_mod_cast (lt_of_lt_of_le (by positivity : 0<4*k^2) threshold)
  have point (p : U) : (𝔼 c : U → Fin k, if ¬determinedBy (sample c) p.val then (1:ℝ) else 0)
      ≤ 2*(k:ℝ)^2/d := by
    obtain ⟨B,count,two,dis,good⟩ := pair_family proper three p
    have deg : d≤B.card := count ▸ minimum p.val p.property
    have per (c : U → Fin k) : (if ¬determinedBy (sample c) p.val then (1:ℝ) else 0) ≤
        if hits B c<2 then (1:ℝ) else 0 := by
      by_cases small : hits B c<2
      · simp [small]; split_ifs <;> norm_num
      · simp [small,good c (le_of_not_gt small)]
    apply (Finset.expect_le_expect (fun c _ => per c)).trans
    exact (miss_bound B two dis (threshold.trans deg)).trans
      (div_le_div_of_nonneg_left (by positivity) dp (by exact_mod_cast deg))
  have num (c : U → Fin k) : ((missed U (sample c)).card:ℝ) =
      ∑ p : U, if ¬determinedBy (sample c) p.val then (1:ℝ) else 0 := by
    rw [Finset.sum_boole]
    change _ = ((U.attach.filter (fun p : U => ¬determinedBy (sample c) p.val)).card:ℝ)
    rw [Finset.filter_attach (fun p : ℝ² => ¬determinedBy (sample c) p) U]
    simp [missed]
  simp_rw [num,Finset.expect_sum_comm]
  exact (Finset.sum_le_sum (fun p _ => point p)).trans_eq (by simp)

theorem common_anchors {S U : Finset ℝ²} {A : Finset Line} (proper : A⊆determined S)
    (three : ∀ L∈A,3 ≤ mult U L) {k d : ℕ} [NeZero k] (threshold : 4*k^2≤d)
    (minimum : ∀p∈U, d≤(star A p).card) :
    ∃ B⊆U, k*B.card≤2*U.card ∧ d*(missed U B).card≤4*k^2*U.card := by
  let w := (d:ℝ)/(2*(k:ℝ)^2)
  have kp : 0<(k:ℝ) := by exact_mod_cast NeZero.pos k
  have hk := NeZero.pos k
  have dp : 0<(d:ℝ) := by exact_mod_cast (lt_of_lt_of_le (by positivity : 0<4*k^2) threshold)
  have wp : 0≤w := by dsimp [w]; positivity
  have mean := mean_missed proper three threshold minimum (k:=k)
  have scaled := mul_le_mul_of_nonneg_left mean wp
  have clean : w*(U.card*(2*(k:ℝ)^2/d))=(U.card:ℝ) := by dsimp [w]; field_simp
  rw [clean] at scaled
  have total : (𝔼 c : U → Fin k, ((k:ℝ)*(anchors c).card+w*(missed U (sample c)).card))≤2*U.card := by
    rw [Finset.expect_add_distrib,← Finset.mul_expect,← Finset.mul_expect,mean_anchors]
    simp only [Fintype.card_coe]
    have cancel : (k:ℝ)*(U.card/k)=U.card := by field_simp
    rw [cancel]; linarith
  obtain ⟨c,_,hc⟩ := Finset.exists_le_of_expect_le Finset.univ_nonempty total
  refine ⟨sample c,sample_sub c,?_,?_⟩
  · rw [sample_card]
    have a : (k:ℝ)*(anchors c).card ≤ 2*U.card := by linarith only [hc,mul_nonneg wp (Nat.cast_nonneg (missed U (sample c)).card)]
    exact_mod_cast a
  · have b : w*(missed U (sample c)).card ≤ 2*U.card := by linarith only [hc,mul_nonneg kp.le (Nat.cast_nonneg (anchors c).card)]
    have t := mul_le_mul_of_nonneg_left b (show 0≤2*(k:ℝ)^2 by positivity)
    dsimp [w] at t
    have eq : (2*(k:ℝ)^2)*(d/(2*k^2)*(missed U (sample c)).card)=d*(missed U (sample c)).card := by field_simp
    rw [eq] at t
    exact_mod_cast (by linarith only [t] : (d:ℝ)*(missed U (sample c)).card ≤ 4*(k:ℝ)^2*U.card)

end Erdos101AnchorJoins

/- A core with enough lines through each point, the linear bound for
algebraically independent abscissae, and compression of arbitrary dense
families to one intersection step from a common set of anchors. -/
noncomputable section
namespace Erdos101AnchorCore
open Erdos101AnchorGeometry Erdos101AnchorField Erdos101AnchorJoins Erdos101AnchorSampling
open EuclideanGeometry Finset
open scoped BigOperators Classical

def active (r : ℕ) (A : Finset Line) (U : Finset ℝ²) := A.filter (fun L => r ≤ mult U L)

theorem peel (S : Finset ℝ²) (A : Finset Line) (r d : ℕ) (rich : ∀L∈A, r ≤ mult S L) :
    ∃ U⊆S, ∃ F⊆A, (∀L∈F,r ≤ mult U L) ∧
      A.card≤F.card+d*(S.card-U.card) ∧ ∀p∈U, d≤(star F p).card := by
  let score (U : Finset ℝ²) : ℤ := ((active r A U).card:ℤ)-(d:ℤ)*U.card
  obtain ⟨U,us,best⟩ := S.powerset.exists_max_image score ⟨S,Finset.mem_powerset.mpr Finset.Subset.rfl⟩
  have sub := Finset.mem_powerset.mp us
  let F := active r A U
  have init := best S (Finset.mem_powerset.mpr Finset.Subset.rfl)
  have full : active r A S=A := Finset.filter_true_of_mem rich
  dsimp only [score] at init
  rw [full] at init
  refine ⟨U,sub,F,Finset.filter_subset ..,fun L hl => (Finset.mem_filter.mp hl).2,?_,?_⟩
  · have eq := Nat.sub_add_cancel (Finset.card_le_card sub)
    have z : ((S.card-U.card:ℕ):ℤ)=(S.card:ℤ)-U.card := by omega
    have goal : (A.card:ℤ) ≤ (F.card:ℤ)+(d:ℤ)*((S.card-U.card:ℕ):ℤ) := by
      rw [z]; dsimp only [F]; linarith only [init]
    exact_mod_cast goal
  · intro p hp
    let F' := active r A (U.erase p)
    have inc : F.filter (fun L => p∉L)⊆F' := by
      intro L hl
      obtain ⟨inF,off⟩ := Finset.mem_filter.mp hl
      obtain ⟨inA,count⟩ := Finset.mem_filter.mp inF
      have eq : incident (U.erase p) L=incident U L := by
        ext q
        simp only [incident,Finset.mem_filter,Finset.mem_erase]
        exact ⟨fun h => ⟨h.1.2,h.2⟩,fun h => ⟨⟨fun e => off (e ▸ h.2),h.1⟩,h.2⟩⟩
      exact Finset.mem_filter.mpr ⟨inA,by simpa only [mult,eq] using count⟩
    have card : F.card ≤ (star F p).card+F'.card := by
      have split := Finset.card_filter_add_card_filter_not (s:=F) (fun L => p∈L)
      exact split ▸ Nat.add_le_add_left (Finset.card_le_card inc) _
    have drop := best (U.erase p) (Finset.mem_powerset.mpr ((Finset.erase_subset ..).trans sub))
    change (F'.card:ℤ)-d*(U.erase p).card≤(F.card:ℤ)-d*U.card at drop
    have size : ((U.erase p).card:ℤ)=(U.card:ℤ)-1 := by
      have h := Finset.card_erase_add_one hp; omega
    rw [size] at drop
    have cc : (F.card:ℤ)≤(star F p).card+(F'.card:ℤ) := by exact_mod_cast card
    exact_mod_cast (by linarith only [drop,cc] : (d:ℤ)≤(star F p).card)

/-- Every family of distinct proper real lines containing at least three
points with algebraically independent first coordinates has size at most 55n.
The second coordinates are arbitrary. -/
theorem three_independent {S : Finset ℝ²} (ind : independentX S) (A : Finset Line)
    (proper : A⊆determined S) (rich : ∀ L∈A, 3 ≤ mult S L) : A.card≤55*S.card := by
  classical
  obtain ⟨U,us,F,fa,three,retain,minimum⟩ := peel S A 3 55 rich
  by_cases empty : U=∅
  · have no : F=∅ := Finset.eq_empty_iff_forall_notMem.mpr (fun L h => by simpa [empty,mult,incident] using three L h)
    simpa [empty,no] using retain
  · have uPos : 0<(U.card:ℝ) := by exact_mod_cast Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr empty)
    exfalso
    have vi := independent_subset ind us
    have mean := mean_missed (fa.trans proper) three (k:=3) (d:=55) (by decide) minimum
    have per (c : U → Fin 3) : (U.card:ℝ) ≤ (missed U (sample c)).card+2*(anchors c).card := by
      have cnt := count_determined vi (sample c)
      rw [sample_card] at cnt
      have part : (U.filter (determinedBy (sample c))).card+(missed U (sample c)).card=U.card :=
        Finset.card_filter_add_card_filter_not ..
      exact_mod_cast (by omega : U.card ≤ (missed U (sample c)).card+2*(anchors c).card)
    have avg := Finset.expect_le_expect (s:=Finset.univ) (fun c _ => per c)
    rw [Fintype.expect_const,Finset.expect_add_distrib,← Finset.mul_expect,mean_anchors] at avg
    simp only [Fintype.card_coe,Nat.cast_ofNat] at mean avg
    linarith only [mean,avg,uPos]

end Erdos101AnchorCore

/- Exceptional points cost at most one four-point line per exceptional pair. -/
noncomputable section
namespace Erdos101AnchorCore
open Erdos101AnchorGeometry Erdos101AnchorField Erdos101AnchorJoins
open EuclideanGeometry Finset
open scoped Classical

def fourFamily (S : Finset ℝ²) := (determined S).filter (fun L => mult S L=4)

theorem fourFamily_eq (S : Finset ℝ²) : (fourFamily S).card=(linesWithPointsFor 4 (S : Set ℝ²)).ncard := count_eq S 4

theorem determined_of_two {S U : Finset ℝ²} {L : Line} (proper : L∈determined S) (two : 2 ≤ mult U L) :
    L∈determined U := by
  obtain ⟨a,ha,b,hb,ne⟩ := Finset.one_lt_card.mp two
  obtain ⟨au,al⟩ := Finset.mem_filter.mp ha
  obtain ⟨bu,bl⟩ := Finset.mem_filter.mp hb
  exact mem_determined.mpr ⟨a,au,b,bu,ne,unique_line proper al bl ne⟩

theorem incident_mono {U S : Finset ℝ²} (sub : U⊆S) (L : Line) : incident U L ⊆ incident S L :=
  Finset.filter_subset_filter _ sub

theorem near_independent (S I : Finset ℝ²) (sub : I⊆S) (ind : independentX I) :
    (linesWithPointsFor 4 (S : Set ℝ²)).ncard ≤ 55*I.card+(S\I).card.choose 2 := by
  classical
  let A := fourFamily S
  let good := A.filter (fun L => 3 ≤ mult I L)
  let bad := A.filter (fun L => ¬3 ≤ mult I L)
  have proper {L} (h : L∈A) := (Finset.mem_filter.mp h).1
  have small : good.card≤55*I.card := three_independent ind good (by
    intro L hl
    obtain ⟨ha,hs⟩ := Finset.mem_filter.mp hl
    exact determined_of_two (proper ha) (by omega)) (fun _ h => (Finset.mem_filter.mp h).2)
  have key (L : bad) : ∃ T : Finset ℝ², T⊆S\I ∧ T.card=2 ∧ ∀p∈T,p∈L.val := by
    obtain ⟨ha,no⟩ := Finset.mem_filter.mp L.property
    have size : mult S L.val=4 := (Finset.mem_filter.mp ha).2
    have diff : incident (S\I) L.val=incident S L.val\incident I L.val := by
      ext p; simp [incident,Finset.mem_sdiff]; tauto
    have n : (incident (S\I) L.val).card=mult S L.val-mult I L.val := by
      rw [diff,Finset.card_sdiff_of_subset (incident_mono sub _)]
      rfl
    obtain ⟨T,ts,tc⟩ := Finset.exists_subset_card_eq (show 2≤(incident (S\I) L.val).card by omega)
    exact ⟨T,ts.trans (Finset.filter_subset ..),tc,fun p hp => (Finset.mem_filter.mp (ts hp)).2⟩
  choose pair incl size on using key
  have inject : Function.Injective pair := by
    intro L M eq
    obtain ⟨p,hp,q,hq,ne⟩ := Finset.one_lt_card.mp (show 1<(pair L).card by rw [size L]; decide)
    exact Subtype.ext ((unique_line (proper (Finset.mem_filter.mp L.property).1) (on L p hp) (on L q hq) ne).symm.trans
      (unique_line (proper (Finset.mem_filter.mp M.property).1) (on M p (eq ▸ hp)) (on M q (eq ▸ hq)) ne))
  have bound : bad.card≤(S\I).card.choose 2 := by
    have inc : Finset.univ.image pair ⊆ (S\I).powersetCard 2 := by
      intro T hT; obtain ⟨L,_,rfl⟩ := Finset.mem_image.mp hT
      exact Finset.mem_powersetCard.mpr ⟨incl L,size L⟩
    simpa only [Finset.card_image_of_injective _ inject,Finset.card_univ,Fintype.card_coe,Finset.card_powersetCard] using Finset.card_le_card inc
  have parts : good.card+bad.card=A.card := Finset.card_filter_add_card_filter_not ..
  rw [← fourFamily_eq S]
  change A.card≤_
  omega

end Erdos101AnchorCore

/- Positive-density four-point line families contain a positive-density
subfamily whose points are all intersections of two joins of a single
set of order square root of the ambient size. -/
noncomputable section
namespace Erdos101AnchorCore
open Erdos101AnchorGeometry Erdos101AnchorField Erdos101AnchorJoins
open EuclideanGeometry Finset
open scoped Classical

private theorem star_le {S : Finset ℝ²} {A : Finset Line} (prop : A⊆determined S) {p : ℝ²} (hp : p∈S) :
    (star A p).card≤S.card := by
  have sub : star A p ⊆ (determined S).filter (fun L => p∈L) := Finset.filter_subset_filter _ prop
  rw [← full_pencil hp] at sub
  exact (Finset.card_le_card sub).trans (Finset.card_image_le.trans (Finset.card_le_card (Finset.erase_subset ..)))

theorem compress {S : Finset ℝ²} {A : Finset Line} (four : A⊆fourFamily S)
    (s k : ℕ) (sp : 0<s) (kp : 0<k) (large : 32*s^2*k^2 ≤ S.card)
    (dense : S.card^2 ≤ s*A.card) :
    ∃ B⊆S, k*B.card≤2*S.card ∧ ∃ G⊆A, A.card≤4*G.card ∧
      ∀L∈G, ∀p∈S, p∈L → determinedBy B p := by
  classical
  let d := 16*s*k^2
  have sp' : s≥1 := sp
  have threshold : 4*k^2≤d := by
    dsimp [d]
    exact Nat.mul_le_mul_right _ (by omega)
  have prop : A⊆determined S := four.trans (Finset.filter_subset ..)
  have size (L) (hl : L∈A) : mult S L=4 := (Finset.mem_filter.mp (four hl)).2
  obtain ⟨U,us,F,fa,rich,keep,minD⟩ := peel S A 4 d (fun L h => (size L h).ge)
  have : NeZero k := ⟨kp.ne'⟩
  obtain ⟨B,bu,cheap,miss⟩ := common_anchors (fa.trans prop)
    (fun L hl => (by decide : 3≤4).trans (rich L hl)) threshold minD
  let M := missed U B
  have uc := Finset.card_le_card us
  have few : 4*s*M.card≤S.card := by
    apply Nat.le_of_mul_le_mul_left (c:=4*k^2) _ (by positivity)
    calc 4*k^2*(4*s*M.card) = d*M.card := by dsimp only [d]; ring
         _ ≤ 4*k^2*U.card := miss
         _ ≤ 4*k^2*S.card := Nat.mul_le_mul_left _ uc
  have half : A.card≤2*F.card := by
    have dSize : 2*d*S.card ≤ A.card := by
      apply Nat.le_of_mul_le_mul_left (c:=s) _ sp
      calc s*(2*d*S.card)=(32*s^2*k^2)*S.card := by dsimp only [d]; ring
           _ ≤ S.card*S.card := Nat.mul_le_mul_right _ large
           _ ≤ s*A.card := by simpa only [pow_two] using dense
    have cost := Nat.mul_le_mul_left d (Nat.sub_le S.card U.card)
    have dd : 2*d*S.card=2*(d*S.card) := by ring
    omega
  let bad := M.biUnion (star F)
  let G := F\bad
  have badsize : bad.card≤M.card*S.card := by
    apply (Finset.card_biUnion_le (s:=M) (t:=star F)).trans
    exact (Finset.sum_le_sum (fun p hp => star_le (fa.trans prop) (us (Finset.mem_filter.mp hp).1))).trans_eq (by simp [M,missed])
  have q : 4*bad.card≤A.card := by
    apply Nat.le_of_mul_le_mul_left (c:=s) _ sp
    calc s*(4*bad.card) ≤ s*(4*(M.card*S.card)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ badsize)
         _ = (4*s*M.card)*S.card := by ring
         _ ≤ S.card*S.card := Nat.mul_le_mul_right _ few
         _ ≤ s*A.card := by simpa only [pow_two] using dense
  have dis : bad⊆F := by
    intro L hL
    obtain ⟨p,_,h⟩ := Finset.mem_biUnion.mp hL
    exact (Finset.mem_filter.mp h).1
  have sum : G.card+bad.card=F.card := Finset.card_sdiff_add_card_eq_card dis
  refine ⟨B,bu.trans us,cheap.trans (Nat.mul_le_mul_left _ uc),G,(Finset.sdiff_subset).trans fa,by omega,?_⟩
  intro L hl p ps pl
  obtain ⟨lf,avoid⟩ := Finset.mem_sdiff.mp hl
  have inc := incident_mono us L
  have eq : incident U L=incident S L :=
    Finset.eq_of_subset_of_card_le inc (by change mult S L ≤ mult U L; rw [size _ (fa lf)]; exact rich L lf)
  have inside : p∈incident U L := by rw [eq]; exact Finset.mem_filter.mpr ⟨ps,pl⟩
  have pu : p∈U := (Finset.mem_filter.mp inside).1
  by_contra no
  exact avoid (Finset.mem_biUnion.mpr ⟨p,Finset.mem_filter.mpr ⟨pu,no⟩,Finset.mem_filter.mpr ⟨lf,pl⟩⟩)

private theorem choose_scale (n s : ℕ) (sp : 0<s) (large : (8*s)^2≤n) :
    ∃ k : ℕ, 0<k ∧ 32*s^2*k^2≤n ∧ n≤256*s^2*k^2 := by
  let k := n.sqrt/(8*s)
  have ep : 0<8*s := by positivity
  have es : 8*s≤n.sqrt := Nat.le_sqrt'.mpr large
  have kp : 0<k := (Nat.div_pos es ep)
  have lo : k*(8*s)≤n.sqrt := Nat.div_mul_le_self _ _
  have upper := Nat.mod_lt n.sqrt ep
  have division := Nat.mod_add_div n.sqrt (8*s)
  change n.sqrt%(8*s)+8*s*k=n.sqrt at division
  have next : n.sqrt+1≤2*(k*(8*s)) := by
    have small := Nat.mul_le_mul_left (8*s) (show 1≤k from kp)
    rw [Nat.mul_one, Nat.mul_comm (8*s) k] at small
    rw [Nat.mul_comm (8*s) k] at division
    omega
  refine ⟨k,kp,?_,?_⟩
  · have sq := (Nat.pow_le_pow_left lo 2).trans (Nat.sqrt_le' n)
    nlinarith only [sq,Nat.zero_le (32*s^2*k^2)]
  · have sq := (Nat.lt_succ_sqrt' n).le.trans (Nat.pow_le_pow_left next 2)
    nlinarith only [sq]

/-- At fixed density n²/s, at least one quarter of the lines are retained,
and every one of their original points is recovered in a single intersection
step. The number b of chosen anchors satisfies b² ≤ 1024 s² n. -/
theorem sqrt_anchors {S : Finset ℝ²} {A : Finset Line} (four : A⊆fourFamily S)
    (s : ℕ) (sp : 0<s) (large : (8*s)^2≤S.card) (dense : S.card^2 ≤ s*A.card) :
    ∃ B⊆S, B.card^2≤1024*s^2*S.card ∧ ∃ G⊆A, A.card≤4*G.card ∧
      ∀L∈G, ∀p∈S, p∈L → determinedBy B p := by
  obtain ⟨k,kp,lo,hi⟩ := choose_scale S.card s sp large
  obtain ⟨B,bs,cheap,G,ga,keep,points⟩ := compress four s k sp kp lo dense
  refine ⟨B,bs,?_,G,ga,keep,points⟩
  apply Nat.le_of_mul_le_mul_left (c:=k^2) _ (by positivity)
  calc k^2*B.card^2=(k*B.card)^2 := (mul_pow ..).symm
       _ ≤ (2*S.card)^2 := Nat.pow_le_pow_left cheap 2
       _ = 4*S.card*S.card := by ring
       _ ≤ 4*(256*s^2*k^2)*S.card := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 4 hi)
       _ = k^2*(1024*s^2*S.card) := by ring

end Erdos101AnchorCore

/- Unconditional extraction for the third reduction of Erdős 101, and the
converse implication from the original statement to its remaining hypothesis. -/

noncomputable section
namespace Erdos101AnchorCore
open Erdos101AnchorGeometry Erdos101AnchorField
open EuclideanGeometry Finset Filter Asymptotics
open scoped Classical

theorem fourFamily_le_square (T : Finset ℝ²) : (fourFamily T).card ≤ T.card^2 := by
  calc (fourFamily T).card ≤ (determined T).card := Finset.card_filter_le ..
       _ ≤ T.offDiag.card := Finset.card_image_le
       _ ≤ T.card^2 := by rw [Finset.offDiag_card,pow_two]; omega

/-- A counterexample of density 1/s would give another of density at least
1/(4s) on a positive fraction of its points, with all nonanchors reconstructed
by one intersection from a common set of at most O_s(√n) anchors. -/
theorem anchored_witness : OMA.R_Erdos101_erdos_101_R3.H1 := by
  intro s sp
  refine ⟨(8*s)^2,?_⟩
  intro S large _cap dense
  rw [← fourFamily_eq] at dense
  obtain ⟨B,bs,cheap,G,ga,keep,points⟩ := sqrt_anchors (A:=fourFamily S) Finset.Subset.rfl s sp large dense
  let T := B ∪ S.filter (determinedBy B)
  have ts : T ⊆ S := Finset.union_subset bs (Finset.filter_subset ..)
  have bt : B ⊆ T := Finset.subset_union_left
  have rich : G ⊆ fourFamily T := by
    intro L hl
    obtain ⟨proper,card⟩ := Finset.mem_filter.mp (ga hl)
    have eq : incident T L = incident S L := by
      apply Finset.Subset.antisymm (incident_mono ts L)
      intro p hp
      obtain ⟨ps,pl⟩ := Finset.mem_filter.mp hp
      exact Finset.mem_filter.mpr ⟨Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨ps,points L hl p ps pl⟩),pl⟩
    have four : mult T L = 4 := (congrArg Finset.card eq).trans card
    exact Finset.mem_filter.mpr ⟨determined_of_two proper (by omega),four⟩
  have sd : S.card^2 ≤ 4*s*(fourFamily T).card := calc
    S.card^2 ≤ s*(fourFamily S).card := dense
    _ ≤ s*(4*G.card) := Nat.mul_le_mul_left _ keep
    _ ≤ s*(4*(fourFamily T).card) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Finset.card_le_card rich))
    _ = 4*s*(fourFamily T).card := by ring
  have tc := Finset.card_le_card ts
  have positive : 0 < S.card := lt_of_lt_of_le (by positivity : 0 < (8*s)^2) large
  have size : S.card ≤ 4*s*T.card := by
    apply Nat.le_of_mul_le_mul_right _ positive
    rw [← pow_two]
    apply sd.trans
    calc 4*s*(fourFamily T).card ≤ 4*s*T.card^2 := Nat.mul_le_mul_left _ (fourFamily_le_square _)
         _ = 4*s*T.card*T.card := by ring
         _ ≤ 4*s*T.card*S.card := Nat.mul_le_mul_left _ tc
  refine ⟨T,B,ts,bt,size,?_,?_,?_⟩
  · exact cheap.trans ((Nat.mul_le_mul_left (1024*s^2) size).trans_eq (by ring))
  · rw [← fourFamily_eq]
    exact (Nat.pow_le_pow_left tc 2).trans sd
  · intro p hp
    rcases Finset.mem_union.mp hp with h|h
    · exact Or.inl h
    · exact Or.inr (show determinedBy B p from (Finset.mem_filter.mp h).2)

theorem count_le_max (T : Finset ℝ²) (cap : NonCollinearFor 5 (T : Set ℝ²)) :
    (linesWithPointsFor 4 (T : Set ℝ²)).ncard ≤ Erdos101.numLinesWithFourPointMax T.card := by
  apply le_csSup
  · refine ⟨T.card^2,?_⟩
    rintro _ ⟨U,uc,finite,_,rfl⟩
    let S := finite.toFinset
    have eq : (S : Set ℝ²)=U := finite.coe_toFinset
    have sc : S.card=T.card := (Set.ncard_eq_toFinset_card U finite).symm.trans uc
    rw [← eq,← fourFamily_eq,← sc]
    exact fourFamily_le_square _
  · exact ⟨(T : Set ℝ²),Set.ncard_coe_finset _,T.finite_toSet,cap,rfl⟩

theorem anchored_iff : (type_of% @Erdos101.erdos_101) ↔ OMA.R_Erdos101_erdos_101_R3.H2 := by
  refine ⟨?_,OMA.R_Erdos101_erdos_101_R3.main anchored_witness⟩
  intro full s C sp
  obtain ⟨N,bound⟩ := eventually_atTop.mp (isLittleO_iff_nat_mul_le.mp full (2*s))
  refine ⟨max N 1,?_⟩
  intro T B large cap _ _ _
  have num := bound T.card ((le_max_left ..).trans large)
  change ((2*s : ℕ) : ℝ)*‖(Erdos101.numLinesWithFourPointMax T.card : ℝ)‖ ≤ ‖(T.card : ℝ)^2‖ at num
  rw [Real.norm_of_nonneg (Nat.cast_nonneg _),Real.norm_of_nonneg (sq_nonneg _)] at num
  have h : (2*s)*Erdos101.numLinesWithFourPointMax T.card ≤ T.card^2 := by exact_mod_cast num
  have hh := (Nat.mul_le_mul_left (2*s) (count_le_max T cap)).trans h
  have pos : 0<T.card^2 := Nat.pow_pos ((le_max_right ..).trans large)
  rw [Nat.mul_assoc] at hh
  omega

end Erdos101AnchorCore

/- Conditions forced on the anchors in the one-step reduction. -/

noncomputable section
namespace Erdos101AnchorGeneric
open EuclideanGeometry Finset Erdos101AnchorGeometry Erdos101AnchorField
open scoped Classical

def definedOver (K : IntermediateField ℚ ℝ) (p : ℝ²) := ∀ i, p i ∈ K

def constrained (B : Finset ℝ²) (a : ℝ²) := ∃ u v : ℝ²,
  definedOver (field (B.erase a)) u ∧ definedOver (field (B.erase a)) v ∧ u ≠ v ∧ a ∈ line[ℝ,u,v]

def generic (B : Finset ℝ²) := AlgebraicIndependent ℚ (fun z : B × Fin 2 => z.1.val z.2)

theorem generated_field_le {K : IntermediateField ℚ ℝ} {A : Finset ℝ²}
    (h : ∀ a ∈ A, definedOver K a) : field A ≤ K := by
  apply IntermediateField.adjoin_le_iff.mpr
  intro x hx
  rcases Finset.mem_union.mp hx with hh|hh
  · obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp hh
    exact h a ha 0
  · obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp hh
    exact h a ha 1

theorem meet_over {K : IntermediateField ℚ ℝ} {u v w z p : ℝ²}
    (hu : definedOver K u) (hv : definedOver K v) (hw : definedOver K w) (hz : definedOver K z)
    (uv : u≠v) (wz : w≠z) (diff : line[ℝ,u,v]≠line[ℝ,w,z])
    (on1 : p∈line[ℝ,u,v]) (on2 : p∈line[ℝ,w,z]) : definedOver K p := by
  let A : Finset ℝ² := {u,v,w,z}
  have sub := generated_field_le (A:=A) (K:=K) (by
    intro a ha
    simp only [A,Finset.mem_insert,Finset.mem_singleton] at ha
    rcases ha with rfl|rfl|rfl|rfl <;> assumption)
  have point : determinedBy A p := ⟨u,by simp [A],v,by simp [A],w,by simp [A],z,by simp [A],uv,wz,diff,on1,on2⟩
  exact fun i => sub (intersection_field point i)

theorem independent_at {B : Finset ℝ²} (gi : generic B) (a : B) :
    AlgebraicIndependent (field (B.erase a.val)) (fun i : Fin 2 => a.val i) := by
  let f (z : B × Fin 2) : ℝ := z.1.val z.2
  let S : Set (B × Fin 2) := {z | z.1 ≠ a}
  let T : Set (B × Fin 2) := {z | z.1 = a}
  have dis : Disjoint S T := Set.disjoint_left.mpr (fun _ h k => h k)
  have im : f '' S = (coords (B.erase a.val) : Set ℝ) := by
    ext v
    constructor
    · rintro ⟨⟨p,i⟩,hp,rfl⟩
      have ne : p.val ≠ a.val := fun e => hp (Subtype.ext e)
      have es := Finset.mem_erase.mpr ⟨ne,p.property⟩
      fin_cases i
      · exact Finset.mem_union_left _ (Finset.mem_image_of_mem _ es)
      · exact Finset.mem_union_right _ (Finset.mem_image_of_mem _ es)
    · intro h
      rcases Finset.mem_union.mp h with hh|hh
      · obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp hh
        obtain ⟨ne,pb⟩ := Finset.mem_erase.mp hp
        exact ⟨(⟨p,pb⟩,0),fun e => ne (congrArg Subtype.val e),rfl⟩
      · obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp hh
        obtain ⟨ne,pb⟩ := Finset.mem_erase.mp hp
        exact ⟨(⟨p,pb⟩,1),fun e => ne (congrArg Subtype.val e),rfl⟩
  have ga : AlgebraicIndependent (Algebra.adjoin ℚ (f '' S)) (fun i : T => f i.val) :=
    gi.adjoin_of_disjoint dis
  let inc (i : Fin 2) : T := ⟨(a,i),rfl⟩
  have inj : Function.Injective inc := fun i j e => congrArg (fun q : T => q.val.2) e
  have result := ga.comp inc inj
  rw [im] at result
  exact IntermediateField.algebraicIndependent_adjoin_iff.mpr result

theorem generic_free {B : Finset ℝ²} (gi : generic B) {a : ℝ²} (ab : a∈B) : ¬constrained B a := by
  rintro ⟨u,v,hu,hv,ne,on⟩
  let K := field (B.erase a)
  let A : K := ⟨u 0*v 1-v 0*u 1,K.sub_mem (K.mul_mem (hu 0) (hv 1)) (K.mul_mem (hv 0) (hu 1))⟩
  let D : K := ⟨u 1-v 1,K.sub_mem (hu 1) (hv 1)⟩
  let E : K := ⟨v 0-u 0,K.sub_mem (hv 0) (hu 0)⟩
  let F : MvPolynomial (Fin 2) K := MvPolynomial.C A+MvPolynomial.C D*MvPolynomial.X 0+MvPolynomial.C E*MvPolynomial.X 1
  have geom := (on_line ne).mpr on
  change u 0*v 1-v 0*u 1+a 0*(u 1-v 1)+a 1*(v 0-u 0)=0 at geom
  have zero : MvPolynomial.aeval (fun i : Fin 2 => a i) F = 0 := by
    simp only [F,map_add,map_mul,MvPolynomial.aeval_C,MvPolynomial.aeval_X]
    change u 0*v 1-v 0*u 1+(u 1-v 1)*a 0+(v 0-u 0)*a 1=0
    linarith only [geom]
  have z := (independent_at gi ⟨a,ab⟩).eq_zero_of_aeval_eq_zero F zero
  have at0 := congrArg (MvPolynomial.eval (fun _ : Fin 2 => (0 : K))) z
  have atX := congrArg (MvPolynomial.eval (![1,0] : Fin 2 → K)) z
  have atY := congrArg (MvPolynomial.eval (![0,1] : Fin 2 → K)) z
  simp [F] at at0 atX atY
  have dx : E=0 := by simpa [at0] using atY
  have dy : D=0 := by simpa [at0] using atX
  have vx := congrArg Subtype.val dx
  have vy := congrArg Subtype.val dy
  apply ne
  ext i; fin_cases i
  · exact (sub_eq_zero.mp (show v 0-u 0=0 from vx)).symm
  · exact sub_eq_zero.mp (show u 1-v 1=0 from vy)

end Erdos101AnchorGeneric

/- A four-point line avoiding all anchors forces a dependence on an anchor
unless another of its points lies on a join through that same anchor. -/

noncomputable section
namespace Erdos101AnchorGeneric
open EuclideanGeometry Finset Erdos101AnchorGeometry Erdos101AnchorField
open Erdos101AnchorCore Erdos101AnchorJoins
open scoped Classical

def fan (T B : Finset ℝ²) (a : ℝ²) := B.biUnion (fun b => incident T (line[ℝ,a,b]))

theorem fan_card {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²)) (a : ℝ²) :
    (fan T B a).card ≤ B.card*4 := by
  apply (Finset.card_biUnion_le ..).trans
  exact (Finset.sum_le_sum (fun b _ => capped (a:=a) (b:=b) cap)).trans_eq (by simp)

private theorem in_fan {T B : Finset ℝ²} {p a b : ℝ²} (pt : p∈T) (bb : b∈B) (on : p∈line[ℝ,a,b]) :
    p∈fan T B a := Finset.mem_biUnion.mpr ⟨b,bb,Finset.mem_filter.mpr ⟨pt,on⟩⟩

/-- Successive straightedge constructions, counting each intersection of two
joins as one round. The initial level consists of the specified anchor points. -/
def levels (B : Finset ℝ²) : ℕ → Set ℝ²
  | 0 => (B : Set ℝ²)
  | k+1 => levels B k ∪ {p | ∃ u∈levels B k, ∃ v∈levels B k, ∃ w∈levels B k, ∃ z∈levels B k,
      u≠v ∧ w≠z ∧ line[ℝ,u,v]≠line[ℝ,w,z] ∧ p∈line[ℝ,u,v] ∧ p∈line[ℝ,w,z]}

theorem initial_level {B : Finset ℝ²} {p : ℝ²} (hp : p∈B) (k : ℕ) : p∈levels B k := by
  induction k with
  | zero => exact hp
  | succ k ih => exact Or.inl ih

theorem level_field {B : Finset ℝ²} (k : ℕ) {p : ℝ²} (hp : p∈levels B k) : definedOver (field B) p := by
  induction k generalizing p with
  | zero => exact point_coords hp
  | succ k ih =>
    rcases hp with h|⟨u,hu,v,hv,w,hw,z,hz,uv,wz,ne,h1,h2⟩
    · exact ih h
    · exact meet_over (ih hu) (ih hv) (ih hw) (ih hz) uv wz ne h1 h2

private theorem other_generated {T B : Finset ℝ²} {a q : ℝ²} (ab : a∈B) (qt : q∈T)
    (off : q∉fan T B a) (gen : q∈B ∨ determinedBy B q) : q∈levels (B.erase a) 1 := by
  rcases gen with qb|⟨b,hb,c,hc,d,hd,e,he,bc,de,ne,one,two⟩
  · have qa : q≠a := by rintro rfl; exact off (in_fan qt ab (left_mem_affineSpan_pair ..))
    exact Or.inl (Finset.mem_erase.mpr ⟨qa,qb⟩)
  · have diff {x y : ℝ²} (yb : y∈B) (pl : q∈line[ℝ,x,y]) : x≠a := by
      rintro rfl; exact off (in_fan qt yb pl)
    have one' : q∈line[ℝ,c,b] := by rwa [Set.pair_comm]
    have two' : q∈line[ℝ,e,d] := by rwa [Set.pair_comm]
    exact Or.inr ⟨b,Finset.mem_erase.mpr ⟨diff hc one,hb⟩,
      c,Finset.mem_erase.mpr ⟨diff hb one',hc⟩,d,Finset.mem_erase.mpr ⟨diff he two,hd⟩,
      e,Finset.mem_erase.mpr ⟨diff hd two',he⟩,bc,de,ne,one,two⟩

/-- A point on a four-point line that avoids the other points of an anchor
fan can be reconstructed in two rounds after that anchor is removed. -/
theorem recover_without {T B : Finset ℝ²} {p a b c d : ℝ²} {L : Line}
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) (pt : p∈T) (pb : p∉B)
    (ab : a∈B) (_bb : b∈B) (cb : c∈B) (db : d∈B) (ne1 : a≠b) (ne2 : c≠d)
    (diff : line[ℝ,a,b]≠line[ℝ,c,d]) (one : p∈line[ℝ,a,b]) (two : p∈line[ℝ,c,d])
    (lf : L∈fourFamily T) (pl : p∈L) (miss : ∀x∈B,x∉L)
    (only : ∀q∈incident T L,q≠p → q∉fan T B a) : p∈levels (B.erase a) 2 := by
  have pa : p≠a := fun e => pb (e ▸ ab)
  have off : a∉line[ℝ,c,d] := by
    intro on
    exact diff ((affineSpan_pair_eq_of_mem_of_mem_of_ne one (left_mem_affineSpan_pair ..) pa).symm.trans
      (affineSpan_pair_eq_of_mem_of_mem_of_ne two on pa))
  have cc : c≠a := by rintro rfl; exact off (left_mem_affineSpan_pair ..)
  have dc : d≠a := by rintro rfl; exact off (right_mem_affineSpan_pair ..)
  have ck := initial_level (Finset.mem_erase.mpr ⟨cc,cb⟩) 1
  have dk := initial_level (Finset.mem_erase.mpr ⟨dc,db⟩) 1
  obtain ⟨proper,count⟩ := Finset.mem_filter.mp lf
  have rich : 1 < ((incident T L).erase p).card := by
    rw [Finset.card_erase_of_mem (s:=incident T L) (Finset.mem_filter.mpr ⟨pt,pl⟩)]
    change 1 < mult T L-1
    rw [count]; decide
  obtain ⟨u,hu,v,hv,uv⟩ := Finset.one_lt_card.mp rich
  obtain ⟨up,iu⟩ := Finset.mem_erase.mp hu
  obtain ⟨vp,iv⟩ := Finset.mem_erase.mp hv
  obtain ⟨ut,ul⟩ := Finset.mem_filter.mp iu
  obtain ⟨vt,vl⟩ := Finset.mem_filter.mp iv
  have vu : line[ℝ,u,v]=L := unique_line proper ul vl uv
  have uk := other_generated ab ut (only u iu up) (gen u ut)
  have vk := other_generated ab vt (only v iv vp) (gen v vt)
  have lines : line[ℝ,u,v] ≠ line[ℝ,c,d] := by
    intro eq
    apply miss c cb
    rw [← vu,eq]
    exact left_mem_affineSpan_pair ..
  exact Or.inr ⟨u,uk,v,vk,c,ck,d,dk,uv,ne2,lines,vu ▸ pl,two⟩

theorem constrains {T B : Finset ℝ²} {p a b c d : ℝ²} {L : Line}
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) (pt : p∈T) (pb : p∉B)
    (ab : a∈B) (bb : b∈B) (cb : c∈B) (db : d∈B) (ne1 : a≠b) (ne2 : c≠d)
    (diff : line[ℝ,a,b]≠line[ℝ,c,d]) (one : p∈line[ℝ,a,b]) (two : p∈line[ℝ,c,d])
    (lf : L∈fourFamily T) (pl : p∈L) (miss : ∀x∈B,x∉L)
    (only : ∀q∈incident T L,q≠p → q∉fan T B a) : constrained B a := by
  have pk := level_field 2 (recover_without gen pt pb ab bb cb db ne1 ne2 diff one two lf pl miss only)
  have bk := point_coords (Finset.mem_erase.mpr ⟨ne1.symm,bb⟩)
  have nb : p≠b := fun e => pb (e ▸ bb)
  refine ⟨p,b,pk,bk,nb,?_⟩
  rw [affineSpan_pair_eq_of_mem_of_mem_of_ne one (right_mem_affineSpan_pair ..) nb]
  exact left_mem_affineSpan_pair ..

def cleanLines (T B : Finset ℝ²) := (fourFamily T).filter (fun L => ∀a∈B,a∉L)

theorem low_unless_recovered {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) {p a b c d : ℝ²} (pt : p∈T) (pb : p∉B)
    (ab : a∈B) (bb : b∈B) (cb : c∈B) (db : d∈B) (ne1 : a≠b) (ne2 : c≠d)
    (diff : line[ℝ,a,b]≠line[ℝ,c,d]) (one : p∈line[ℝ,a,b]) (two : p∈line[ℝ,c,d])
    (free : p∉levels (B.erase a) 2) : (star (cleanLines T B) p).card ≤ B.card*4 := by
  have sub : star (cleanLines T B) p ⊆ (fan T B a).image (fun q => line[ℝ,p,q]) := by
    intro L hl
    obtain ⟨good,pl⟩ := Finset.mem_filter.mp hl
    obtain ⟨lf,miss⟩ := Finset.mem_filter.mp good
    have exists_q : ∃ q∈incident T L, q≠p ∧ q∈fan T B a := by
      by_contra! no
      exact free (recover_without gen pt pb ab bb cb db ne1 ne2 diff one two lf pl miss no)
    obtain ⟨q,hq,qp,qf⟩ := exists_q
    exact Finset.mem_image.mpr ⟨q,qf,unique_line (Finset.mem_filter.mp lf).1 pl (Finset.mem_filter.mp hq).2 qp.symm⟩
  exact (Finset.card_le_card sub).trans (Finset.card_image_le.trans (fan_card cap a))

theorem clean_degree {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) {p a b c d : ℝ²} (pt : p∈T) (pb : p∉B)
    (ab : a∈B) (bb : b∈B) (cb : c∈B) (db : d∈B) (ne1 : a≠b) (ne2 : c≠d)
    (diff : line[ℝ,a,b]≠line[ℝ,c,d]) (one : p∈line[ℝ,a,b]) (two : p∈line[ℝ,c,d])
    (free : ¬constrained B a) : (star (cleanLines T B) p).card ≤ B.card*4 := by
  apply low_unless_recovered cap gen pt pb ab bb cb db ne1 ne2 diff one two
  intro recovered
  apply free
  have nb : p≠b := fun e => pb (e ▸ bb)
  refine ⟨p,b,level_field 2 recovered,point_coords (Finset.mem_erase.mpr ⟨ne1.symm,bb⟩),nb,?_⟩
  rw [affineSpan_pair_eq_of_mem_of_mem_of_ne one (right_mem_affineSpan_pair ..) nb]
  exact left_mem_affineSpan_pair ..

end Erdos101AnchorGeneric

/- A density bound in terms of how many anchors lie on a line over the
field generated by the other anchors. -/

noncomputable section
namespace Erdos101AnchorGeneric
open EuclideanGeometry Finset Erdos101AnchorGeometry Erdos101AnchorField
open Erdos101AnchorCore Erdos101AnchorJoins
open scoped Classical

def dependentAnchors (B : Finset ℝ²) := B.filter (constrained B)
def dependentJoins (T B : Finset ℝ²) := (dependentAnchors B).biUnion (fan T (dependentAnchors B))

theorem joins_card {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²)) :
    (dependentJoins T B).card ≤ 4*(dependentAnchors B).card^2 := by
  apply (Finset.card_biUnion_le ..).trans
  exact (Finset.sum_le_sum (fun a _ => fan_card (B:=dependentAnchors B) cap a)).trans_eq (by simp; ring)

private theorem few_through {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) {p : ℝ²} (pt : p∈T) (off : p∉dependentJoins T B) :
    (star (cleanLines T B) p).card ≤ B.card*4 := by
  by_cases pb : p∈B
  · have eq : star (cleanLines T B) p=∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro L hl
      obtain ⟨h,pl⟩ := Finset.mem_filter.mp hl
      exact (Finset.mem_filter.mp h).2 p pb pl
    rw [eq]; simp
  obtain ⟨a,ha,b,hb,c,hc,d,hd,ab,cd,diff,one,two⟩ := (gen p pt).resolve_left pb
  by_cases ac : constrained B a
  · have bc : ¬constrained B b := by
      intro h
      exact off (Finset.mem_biUnion.mpr ⟨a,Finset.mem_filter.mpr ⟨ha,ac⟩,
        Finset.mem_biUnion.mpr ⟨b,Finset.mem_filter.mpr ⟨hb,h⟩,Finset.mem_filter.mpr ⟨pt,one⟩⟩⟩)
    have flip : line[ℝ,b,a]=line[ℝ,a,b] := by rw [Set.pair_comm b a]
    exact clean_degree cap gen pt pb hb ha hc hd ab.symm cd (flip ▸ diff) (flip ▸ one) two bc
  · exact clean_degree cap gen pt pb ha hb hc hd ab cd diff one two ac

theorem pencil_size {T : Finset ℝ²} {p : ℝ²} (pt : p∈T) :
    (star (fourFamily T) p).card ≤ T.card := by
  have sub : star (fourFamily T) p ⊆ (determined T).filter (fun L => p∈L) :=
    Finset.filter_subset_filter _ (Finset.filter_subset ..)
  rw [← full_pencil pt] at sub
  exact (Finset.card_le_card sub).trans (Finset.card_image_le.trans (Finset.card_le_card (Finset.erase_subset ..)))

/-- Count lines from a local degree bound away from an exceptional point set
and a set that may contain entire four-point lines. -/
theorem local_to_global {T B W E : Finset ℝ²} (bt : B ⊆ T) (et : E ⊆ T)
    (degree : ∀p∈T,p∉W → p∉E → (star (cleanLines T B) p).card ≤ B.card*4) :
    (linesWithPointsFor 4 (T : Set ℝ²)).ncard ≤ (5*B.card+E.card)*T.card+W.card^2 := by
  let F := fourFamily T
  let H := (B∪E).biUnion (star F)
  let J := (T\(W∪E)).biUnion (star (cleanLines T B))
  have cover : F ⊆ (H ∪ J) ∪ determined W := by
    intro L hl
    by_cases b : ∃a∈B∪E,a∈L
    · obtain ⟨a,ab,al⟩ := b
      exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_biUnion.mpr
        ⟨a,ab,Finset.mem_filter.mpr ⟨hl,al⟩⟩))
    push Not at b
    have clean : L∈cleanLines T B := Finset.mem_filter.mpr ⟨hl,fun p hp => b p (Finset.mem_union_left _ hp)⟩
    by_cases hits : ∃p∈T\(W∪E),p∈L
    · obtain ⟨p,hp,pl⟩ := hits
      exact Finset.mem_union_left _ (Finset.mem_union_right _ (Finset.mem_biUnion.mpr
        ⟨p,hp,Finset.mem_filter.mpr ⟨clean,pl⟩⟩))
    push Not at hits
    have sub : incident T L ⊆ incident W L := by
      intro p hp
      obtain ⟨pt,pl⟩ := Finset.mem_filter.mp hp
      have pe : p∉E := fun h => b p (Finset.mem_union_right _ h) pl
      refine Finset.mem_filter.mpr ⟨?_,pl⟩
      by_contra pw
      exact hits p (Finset.mem_sdiff.mpr ⟨pt,fun he => (Finset.mem_union.mp he).elim pw pe⟩) pl
    obtain ⟨proper,card⟩ := Finset.mem_filter.mp hl
    have two : 2 ≤ mult W L := (show 2 ≤ mult T L by rw [card]; decide).trans (Finset.card_le_card sub)
    exact Finset.mem_union_right _ (determined_of_two proper two)
  have hh : H.card ≤ (B.card+E.card)*T.card := by
    apply (Finset.card_biUnion_le ..).trans
    calc _ ≤ ∑ _ ∈ B∪E, T.card := Finset.sum_le_sum (fun p hp => pencil_size ((Finset.union_subset bt et) hp))
         _ = (B∪E).card*T.card := by simp
         _ ≤ _ := Nat.mul_le_mul_right _ (Finset.card_union_le ..)
  have jj : J.card ≤ T.card*(B.card*4) := by
    apply (Finset.card_biUnion_le ..).trans
    calc _ ≤ ∑ _ ∈ T\(W∪E), B.card*4 := Finset.sum_le_sum (fun p hp => degree p (Finset.mem_sdiff.mp hp).1
            (fun h => (Finset.mem_sdiff.mp hp).2 (Finset.mem_union_left _ h))
            (fun h => (Finset.mem_sdiff.mp hp).2 (Finset.mem_union_right _ h)))
         _ = (T\(W∪E)).card*(B.card*4) := by simp
         _ ≤ _ := Nat.mul_le_mul_right _ (Finset.card_le_card Finset.sdiff_subset)
  have det : (determined W).card ≤ W.card^2 := calc
    _ ≤ W.offDiag.card := Finset.card_image_le
    _ ≤ _ := by rw [Finset.offDiag_card,pow_two]; omega
  rw [← fourFamily_eq]
  calc F.card ≤ ((H ∪ J) ∪ determined W).card := Finset.card_le_card cover
       _ ≤ H.card+J.card+(determined W).card := (Finset.card_union_le ..).trans (Nat.add_le_add_right (Finset.card_union_le ..) _)
       _ ≤ (B.card+E.card)*T.card+T.card*(B.card*4)+W.card^2 := Nat.add_le_add (Nat.add_le_add hh jj) det
       _ = _ := by ring

/-- If b anchors generate n points in one step and d of those anchors lie on
a line through two points defined over the other anchors, there are at most
5bn + 16d⁴ four-point lines. -/
theorem defect_bound {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²)) (bt : B⊆T)
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) :
    (linesWithPointsFor 4 (T : Set ℝ²)).ncard ≤ 5*B.card*T.card+16*(dependentAnchors B).card^4 := by
  have bound := local_to_global (W:=dependentJoins T B) (E:=∅) bt (Finset.empty_subset _)
    (fun p hp off _ => few_through cap gen hp off)
  simp only [Finset.card_empty,Nat.add_zero] at bound
  apply bound.trans
  apply Nat.add_le_add_left
  exact (Nat.pow_le_pow_left (joins_card (B:=B) cap) 2).trans_eq (by ring)

theorem generic_bound {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²)) (bt : B⊆T)
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) (gi : generic B) :
    (linesWithPointsFor 4 (T : Set ℝ²)).ncard ≤ 5*B.card*T.card := by
  have empty : dependentAnchors B=∅ := Finset.filter_false_of_mem (fun _ h => generic_free gi h)
  simpa [empty] using defect_bound cap bt gen

end Erdos101AnchorGeneric

/- For a point on many four-point lines, a generating anchor can be erased
from its construction. Two such points on different joins reconstruct the
anchor itself in three rounds. -/
noncomputable section
namespace Erdos101AnchorGeneric
open EuclideanGeometry Finset Erdos101AnchorGeometry Erdos101AnchorField
open Erdos101AnchorCore Erdos101AnchorJoins
open scoped Classical

def uses (B : Finset ℝ²) (a p : ℝ²) := ∃ b∈B, ∃ c∈B, ∃ d∈B,
  a≠b ∧ c≠d ∧ line[ℝ,a,b]≠line[ℝ,c,d] ∧ p∈line[ℝ,a,b] ∧ p∈line[ℝ,c,d]

def demanding (T B : Finset ℝ²) (a : ℝ²) := T.filter (fun p =>
  p∉B ∧ uses B a p ∧ B.card*4 < (star (cleanLines T B) p).card)

def recoverable (B : Finset ℝ²) := B.filter (fun a => a∈levels (B.erase a) 3)

private theorem switch {p a b c d : ℝ²} (ha : a≠b) (hc : c≠d) (diff : line[ℝ,a,b]≠line[ℝ,c,d])
    (on1 : p∈line[ℝ,a,b]) (on2 : p∈line[ℝ,c,d]) :
    b≠a ∧ c≠d ∧ line[ℝ,b,a]≠line[ℝ,c,d] ∧ p∈line[ℝ,b,a] ∧ p∈line[ℝ,c,d] := by
  rw [Set.pair_comm b a]; exact ⟨ha.symm,hc,diff,on1,on2⟩

theorem uses_if_lost {B : Finset ℝ²} {p a : ℝ²} (h : determinedBy B p)
    (lost : p∉levels (B.erase a) 1) : uses B a p := by
  obtain ⟨b,hb,c,hc,d,hd,e,he,bc,de,ne,h1,h2⟩ := h
  by_cases ba : b=a
  · subst b; exact ⟨c,hc,d,hd,e,he,bc,de,ne,h1,h2⟩
  by_cases ca : c=a
  · subst c; exact ⟨b,hb,d,hd,e,he,switch bc de ne h1 h2⟩
  by_cases da : d=a
  · subst d; exact ⟨e,he,b,hb,c,hc,de,bc,ne.symm,h2,h1⟩
  by_cases ea : e=a
  · subst e; exact ⟨d,hd,b,hb,c,hc,switch de bc ne.symm h2 h1⟩
  exact False.elim (lost (Or.inr ⟨b,Finset.mem_erase.mpr ⟨ba,hb⟩,c,Finset.mem_erase.mpr ⟨ca,hc⟩,
    d,Finset.mem_erase.mpr ⟨da,hd⟩,e,Finset.mem_erase.mpr ⟨ea,he⟩,bc,de,ne,h1,h2⟩))

private theorem data_of_demanding {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) {p a : ℝ²} (ab : a∈B) (hp : p∈demanding T B a) :
    ∃ b∈B.erase a, p≠b ∧ p∈levels (B.erase a) 2 ∧ line[ℝ,p,b]=line[ℝ,a,b] := by
  obtain ⟨pt,pb,ex,high⟩ := Finset.mem_filter.mp hp
  obtain ⟨b,hb,c,hc,d,hd,ab',cd,ne,h1,h2⟩ := ex
  have nb : p≠b := fun e => pb (e ▸ hb)
  have eq := affineSpan_pair_eq_of_mem_of_mem_of_ne h1 (right_mem_affineSpan_pair ..) nb
  refine ⟨b,Finset.mem_erase.mpr ⟨ab'.symm,hb⟩,nb,?_,eq⟩
  by_contra notRec
  exact high.not_ge (low_unless_recovered cap gen pt pb ab hb hc hd ab' cd ne h1 h2 notRec)

/-- If an anchor cannot be reconstructed from the others in three rounds,
all its high-degree users lie on at most one line. -/
theorem demanding_card {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) {a : ℝ²} (ab : a∈B) (nr : a∉levels (B.erase a) 3) :
    (demanding T B a).card ≤ 4 := by
  rcases (demanding T B a).eq_empty_or_nonempty with h|⟨p,hp⟩
  · simp [h]
  obtain ⟨b,hb,pb,pr,eqp⟩ := data_of_demanding cap gen ab hp
  have sub : demanding T B a ⊆ incident T (line[ℝ,p,b]) := by
    intro q hq
    obtain ⟨c,hc,qc,qr,eqq⟩ := data_of_demanding cap gen ab hq
    have la : a∈line[ℝ,p,b] := eqp ▸ left_mem_affineSpan_pair ..
    have lb : a∈line[ℝ,q,c] := eqq ▸ left_mem_affineSpan_pair ..
    have same : line[ℝ,p,b]=line[ℝ,q,c] := by
      by_contra diff
      exact nr (Or.inr ⟨p,pr,b,initial_level hb 2,q,qr,c,initial_level hc 2,pb,qc,diff,la,lb⟩)
    exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hq).1,same ▸ left_mem_affineSpan_pair ..⟩
  exact (Finset.card_le_card sub).trans (capped cap)

theorem recoverable_bound {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²)) (bt : B⊆T)
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) :
    (linesWithPointsFor 4 (T : Set ℝ²)).ncard ≤ 9*B.card*T.card+16*(recoverable B).card^4 := by
  let R := recoverable B
  let W := R.biUnion (fan T R)
  let E := (B\R).biUnion (demanding T B)
  have es : E⊆T := by
    intro p hp
    obtain ⟨_,_,h⟩ := Finset.mem_biUnion.mp hp
    exact (Finset.mem_filter.mp h).1
  have ee : E.card ≤ B.card*4 := by
    apply (Finset.card_biUnion_le ..).trans
    calc _ ≤ ∑ _ ∈ B\R, 4 := Finset.sum_le_sum (fun a ha => demanding_card cap gen (Finset.mem_sdiff.mp ha).1
            (fun h => (Finset.mem_sdiff.mp ha).2 (Finset.mem_filter.mpr ⟨(Finset.mem_sdiff.mp ha).1,h⟩)))
         _ = (B\R).card*4 := by simp
         _ ≤ _ := Nat.mul_le_mul_right _ (Finset.card_le_card Finset.sdiff_subset)
  have ww : W.card ≤ 4*R.card^2 := by
    apply (Finset.card_biUnion_le ..).trans
    exact (Finset.sum_le_sum (fun a _ => fan_card (B:=R) cap a)).trans_eq (by simp; ring)
  have deg (p) (pt : p∈T) (off : p∉W) (pe : p∉E) : (star (cleanLines T B) p).card ≤ B.card*4 := by
    by_contra! high
    have pb : p∉B := by
      intro h
      obtain ⟨L,hl⟩ := Finset.card_pos.mp (lt_of_le_of_lt (Nat.zero_le _) high)
      obtain ⟨hl,pl⟩ := Finset.mem_filter.mp hl
      exact (Finset.mem_filter.mp hl).2 p h pl
    obtain ⟨a,ha,b,hb,c,hc,d,hd,ab,cd,diff,one,two⟩ := (gen p pt).resolve_left pb
    have necessary {v : ℝ²} (vb : v∈B) (use : uses B v p) : v∈R := by
      by_contra vr
      exact pe (Finset.mem_biUnion.mpr ⟨v,Finset.mem_sdiff.mpr ⟨vb,vr⟩,Finset.mem_filter.mpr ⟨pt,pb,use,high⟩⟩)
    have ar := necessary ha ⟨b,hb,c,hc,d,hd,ab,cd,diff,one,two⟩
    have br := necessary hb ⟨a,ha,c,hc,d,hd,switch ab cd diff one two⟩
    exact off (Finset.mem_biUnion.mpr ⟨a,ar,Finset.mem_biUnion.mpr ⟨b,br,Finset.mem_filter.mpr ⟨pt,one⟩⟩⟩)
  apply (local_to_global bt es deg).trans
  apply Nat.add_le_add
  · exact Nat.mul_le_mul_right _ ((Nat.add_le_add_left ee (5*B.card)).trans_eq (by ring))
  · exact (Nat.pow_le_pow_left ww 2).trans_eq (by dsimp only [R]; ring)

end Erdos101AnchorGeneric

/- Erase an anchor that cannot be reconstructed from the others. Its
low-degree users lie in a small pencil and its high-degree users lie on
one line. Iteration leaves a self-reconstructing set of anchors. -/
noncomputable section
namespace Erdos101AnchorGeneric
open EuclideanGeometry Finset Erdos101AnchorGeometry Erdos101AnchorField
open Erdos101AnchorCore Erdos101AnchorJoins
open scoped Classical

/-- Points whose first-round reconstruction requires this particular anchor
and whose number of incident four-point lines avoiding all anchors exceeds q. -/
def essentialAt (T B : Finset ℝ²) (q : ℕ) (a : ℝ²) :=
  T.filter (fun p => p∉B ∧ p∉levels (B.erase a) 1 ∧ q < (star (cleanLines T B) p).card)

theorem essential_sub {T B : Finset ℝ²} {q : ℕ}
    (gen : ∀p∈T,p∈B ∨ determinedBy B p) (deg : B.card*4 ≤ q) (a : ℝ²) :
    essentialAt T B q a ⊆ demanding T B a := by
  intro p hp
  obtain ⟨pt,pb,lost,high⟩ := Finset.mem_filter.mp hp
  exact Finset.mem_filter.mpr ⟨pt,pb,uses_if_lost ((gen p pt).resolve_left pb) lost,deg.trans_lt high⟩

theorem erase_one (q h : ℕ) {T B : Finset ℝ²} {A : Finset Line} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (bt : B⊆T) (gen : ∀q∈T,q∈B ∨ determinedBy B q) (clean : A⊆cleanLines T B) {a : ℝ²}
    (_ab : a∈B) (few : (essentialAt T B q a).card ≤ h) :
    ∃ V⊆T, B.erase a ⊆ V ∧ (∀q∈V,q∈B.erase a ∨ determinedBy (B.erase a) q) ∧
      ∃ F⊆A, F⊆cleanLines V (B.erase a) ∧ A.card ≤ F.card+(4*B.card*q+h*T.card) := by
  let K := B.erase a
  let V := T.filter (fun p => p∈levels K 1)
  let F := A.filter (fun L => incident T L ⊆ V)
  have vt : V⊆T := Finset.filter_subset ..
  have kv : K⊆V := fun q h => Finset.mem_filter.mpr ⟨bt (Finset.mem_of_mem_erase h),Or.inl h⟩
  have fa : F⊆A := Finset.filter_subset ..
  have keep : F⊆cleanLines V K := by
    intro L hl
    obtain ⟨al,sub⟩ := Finset.mem_filter.mp hl
    obtain ⟨lf,miss⟩ := Finset.mem_filter.mp (clean al)
    obtain ⟨proper,card⟩ := Finset.mem_filter.mp lf
    have eq : incident V L=incident T L := Finset.Subset.antisymm (incident_mono vt L)
      (fun p hp => Finset.mem_filter.mpr ⟨sub hp,(Finset.mem_filter.mp hp).2⟩)
    have four : mult V L=4 := (congrArg Finset.card eq).trans card
    exact Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨determined_of_two proper (by omega),four⟩,
      fun q qk => miss q (Finset.mem_of_mem_erase qk)⟩
  let lo := (fan T B a).filter (fun p => (star (cleanLines T B) p).card ≤ q)
  let hi := essentialAt T B q a
  let lowLines := lo.biUnion (star (cleanLines T B))
  let highLines := hi.biUnion (star (fourFamily T))
  have cover : A\F ⊆ lowLines∪highLines := by
    intro L hl
    obtain ⟨al,nf⟩ := Finset.mem_sdiff.mp hl
    have notSub : ¬incident T L ⊆ V := fun h => nf (Finset.mem_filter.mpr ⟨al,h⟩)
    obtain ⟨p,hit,out⟩ := Finset.not_subset.mp notSub
    obtain ⟨pt,pl⟩ := Finset.mem_filter.mp hit
    obtain ⟨lf,miss⟩ := Finset.mem_filter.mp (clean al)
    have pb : p∉B := fun h => miss p h pl
    have lost : p∉levels K 1 := fun h => out (Finset.mem_filter.mpr ⟨pt,h⟩)
    have use := uses_if_lost ((gen p pt).resolve_left pb) lost
    by_cases small : (star (cleanLines T B) p).card ≤ q
    · obtain ⟨b,hb,_,_,_,_,_,_,_,one,_⟩ := use
      have pf : p∈fan T B a := Finset.mem_biUnion.mpr ⟨b,hb,Finset.mem_filter.mpr ⟨pt,one⟩⟩
      exact Finset.mem_union_left _ (Finset.mem_biUnion.mpr ⟨p,Finset.mem_filter.mpr ⟨pf,small⟩,
        Finset.mem_filter.mpr ⟨clean al,pl⟩⟩)
    · exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨p,Finset.mem_filter.mpr ⟨pt,pb,lost,Nat.lt_of_not_ge small⟩,
        Finset.mem_filter.mpr ⟨lf,pl⟩⟩)
  have lowSize : lowLines.card ≤ 4*B.card*q := by
    apply (Finset.card_biUnion_le ..).trans
    calc _ ≤ ∑ _ ∈ lo,q := Finset.sum_le_sum (fun _ hp => (Finset.mem_filter.mp hp).2)
         _ = lo.card*q := by simp
         _ ≤ (B.card*4)*q := Nat.mul_le_mul_right _ ((Finset.card_filter_le ..).trans (fan_card cap a))
         _ = _ := by ring
  have highSize : highLines.card ≤ h*T.card := by
    apply (Finset.card_biUnion_le ..).trans
    calc _ ≤ ∑ _ ∈ hi,T.card := Finset.sum_le_sum (fun _ hp => pencil_size (Finset.mem_filter.mp hp).1)
         _ = hi.card*T.card := by simp
         _ ≤ _ := Nat.mul_le_mul_right _ few
  have covered := (Finset.card_le_card cover).trans ((Finset.card_union_le ..).trans (Nat.add_le_add lowSize highSize))
  have sum := Finset.card_sdiff_add_card_eq_card fa
  exact ⟨V,vt,kv,fun _ h => (Finset.mem_filter.mp h).2,F,fa,keep,by omega⟩

/-- Keep removing anchors with at most h essential high-degree users.
The loss bound is uniform over the order of deletions. -/
theorem strip (q h : ℕ) {T B : Finset ℝ²} {A : Finset Line} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (bt : B⊆T) (gen : ∀q∈T,q∈B ∨ determinedBy B q) (clean : A⊆cleanLines T B) :
    ∃ V⊆T, ∃ K⊆B, K⊆V ∧ (∀q∈V,q∈K ∨ determinedBy K q) ∧ (∀a∈K,h < (essentialAt V K q a).card) ∧
      ∃ H⊆A, H⊆cleanLines V K ∧ A.card ≤ H.card+B.card*(4*B.card*q+h*T.card) := by
  induction B using Finset.strongInductionOn generalizing T A with
  | _ B ih =>
    by_cases all : ∀a∈B,h < (essentialAt T B q a).card
    · exact ⟨T,Finset.Subset.rfl,B,Finset.Subset.rfl,bt,gen,all,A,Finset.Subset.rfl,clean,Nat.le_add_right ..⟩
    push Not at all
    obtain ⟨a,ab,nr⟩ := all
    obtain ⟨V,vt,kv,vg,F,fa,fc,loss⟩ := erase_one q h cap bt gen clean ab nr
    have vc := NonCollinearFor.subset (Finset.coe_subset.mpr vt) cap
    obtain ⟨U,uv,K,ke,ku,ug,rec,H,hf,hc,remain⟩ := ih (B.erase a) (Finset.erase_ssubset ab) vc kv vg fc
    have scale : 4*(B.erase a).card*q+h*V.card ≤ 4*B.card*q+h*T.card := Nat.add_le_add
      (Nat.mul_le_mul_right q (Nat.mul_le_mul_left 4 (Finset.card_le_card (Finset.erase_subset ..))))
      (Nat.mul_le_mul_left _ (Finset.card_le_card vt))
    have sz := Finset.card_erase_add_one ab
    refine ⟨U,uv.trans vt,K,ke.trans (Finset.erase_subset ..),ku,ug,rec,H,hf.trans fa,hc,?_⟩
    calc A.card ≤ F.card+(4*B.card*q+h*T.card) := loss
         _ ≤ (H.card+(B.erase a).card*(4*B.card*q+h*T.card))+(4*B.card*q+h*T.card) :=
           Nat.add_le_add_right (remain.trans (Nat.add_le_add_left (Nat.mul_le_mul_left _ scale) _)) _
         _ = H.card+((B.erase a).card+1)*(4*B.card*q+h*T.card) := by ring
         _ = _ := by rw [sz]

theorem populated_core (q h : ℕ) {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (bt : B⊆T) (gen : ∀q∈T,q∈B ∨ determinedBy B q) :
    ∃ V⊆T, ∃ K⊆B, K⊆V ∧ (∀q∈V,q∈K ∨ determinedBy K q) ∧ (∀a∈K,h < (essentialAt V K q a).card) ∧
      (fourFamily T).card ≤ (fourFamily V).card+B.card*(4*B.card*q+h*T.card)+B.card*T.card := by
  let A := cleanLines T B
  obtain ⟨V,vt,K,kb,kv,vg,rec,H,_,ha,loss⟩ := strip q h (A:=A) cap bt gen Finset.Subset.rfl
  let D := B.biUnion (star (fourFamily T))
  have cover : fourFamily T ⊆ A∪D := by
    intro L hl
    by_cases good : ∀a∈B,a∉L
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hl,good⟩)
    push Not at good
    obtain ⟨a,ab,al⟩ := good
    exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨a,ab,Finset.mem_filter.mpr ⟨hl,al⟩⟩)
  have dc : D.card≤B.card*T.card := (Finset.card_biUnion_le ..).trans
    ((Finset.sum_le_sum (fun a h => pencil_size (bt h))).trans_eq (by simp))
  have size : H.card ≤ (fourFamily V).card := Finset.card_le_card (ha.trans (Finset.filter_subset ..))
  refine ⟨V,vt,K,kb,kv,vg,rec,?_⟩
  calc (fourFamily T).card ≤ A.card+D.card := (Finset.card_le_card cover).trans (Finset.card_union_le ..)
       _ ≤ ((fourFamily V).card+B.card*(4*B.card*q+h*T.card))+B.card*T.card :=
         Nat.add_le_add (loss.trans (Nat.add_le_add_right size _)) dc

theorem closed_core {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (bt : B⊆T) (gen : ∀q∈T,q∈B ∨ determinedBy B q) :
    ∃ V⊆T, ∃ K⊆B, K⊆V ∧ (∀q∈V,q∈K ∨ determinedBy K q) ∧ (∀a∈K,a∈levels (K.erase a) 3) ∧
      (fourFamily T).card ≤ (fourFamily V).card+16*B.card^3+5*B.card*T.card := by
  obtain ⟨V,vt,K,kb,kv,vg,rich,size⟩ := populated_core (B.card*4) 4 cap bt gen
  refine ⟨V,vt,K,kb,kv,vg,?_,size.trans_eq (by ring)⟩
  intro a ak
  by_contra nr
  have vc := NonCollinearFor.subset (Finset.coe_subset.mpr vt) cap
  have sub := essential_sub vg (Nat.mul_le_mul_right 4 (Finset.card_le_card kb)) a
  exact (rich a ak).not_ge ((Finset.card_le_card sub).trans (demanding_card vc vg ak nr))

end Erdos101AnchorGeneric

/- The full Erdős problem is equivalent to its restriction to sets
generated by square-root many anchors, each individually reconstructible
from the remaining anchors in three rounds of joins and intersections. -/
noncomputable section
namespace Erdos101AnchorGeneric
open EuclideanGeometry Finset Erdos101AnchorGeometry Erdos101AnchorField
open Erdos101AnchorCore
open scoped Classical

def closedGap : Prop :=
  ∀ s C : ℕ, 0 < s → ∃ N : ℕ, ∀ T B : Finset ℝ², N ≤ T.card →
    NonCollinearFor 5 (T : Set ℝ²) → B ⊆ T → B.card^2 ≤ C*T.card →
    (∀p∈T,p∈B ∨ determinedBy B p) → (∀a∈B,a∈levels (B.erase a) 3) →
    s*(fourFamily T).card < T.card^2

theorem restricted_iff : OMA.R_Erdos101_erdos_101_R3.H2 ↔ closedGap := by
  constructor
  · intro gap s C sp
    obtain ⟨N,test⟩ := gap s C sp
    refine ⟨N,fun T B size cap bt cheap gen _ => ?_⟩
    rw [fourFamily_eq]
    exact test T B size cap bt cheap gen
  · intro gap s C sp
    let D := 16*C+5
    obtain ⟨M,test⟩ := gap (2*s) (2*s*C) (by positivity)
    refine ⟨max 1 (max ((2*s*D)^2*C) (2*s*M)),?_⟩
    intro T B size cap bt cheap gen
    rw [← fourFamily_eq]
    by_contra! dense
    have pos : 0 < T.card := (le_max_left ..).trans size
    have large : (2*s*D)^2*C ≤ T.card := (le_max_left ..).trans ((le_max_right ..).trans size)
    have minimum : 2*s*M ≤ T.card := (le_max_right ..).trans ((le_max_right ..).trans size)
    have anchorSize : 2*s*D*B.card ≤ T.card := by
      apply (Nat.pow_le_pow_iff_left (by decide : 2≠0)).mp
      calc (2*s*D*B.card)^2 = (2*s*D)^2*B.card^2 := mul_pow .. 
           _ ≤ (2*s*D)^2*(C*T.card) := Nat.mul_le_mul_left _ cheap
           _ = ((2*s*D)^2*C)*T.card := by ring
           _ ≤ T.card*T.card := Nat.mul_le_mul_right _ large
           _ = _ := (pow_two _).symm
    obtain ⟨V,vt,K,kb,kv,vg,rec,remain⟩ := closed_core cap bt gen
    let loss := 16*B.card^3+5*B.card*T.card
    have lossBound : loss ≤ D*B.card*T.card := calc
      loss = B.card*(16*B.card^2+5*T.card) := by dsimp [loss]; ring
      _ ≤ B.card*(16*(C*T.card)+5*T.card) :=
        Nat.mul_le_mul_left _ (Nat.add_le_add_right (Nat.mul_le_mul_left _ cheap) _)
      _ = D*B.card*T.card := by dsimp [D]; ring
    have twice : 2*(s*loss) ≤ T.card^2 := calc
      2*(s*loss) ≤ 2*(s*(D*B.card*T.card)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ lossBound)
      _ = (2*s*D*B.card)*T.card := by ring
      _ ≤ T.card*T.card := Nat.mul_le_mul_right _ anchorSize
      _ = _ := (pow_two _).symm
    have both : T.card^2 ≤ s*(fourFamily V).card+s*loss := calc
      T.card^2 ≤ s*(fourFamily T).card := dense
      _ ≤ s*((fourFamily V).card+loss) := Nat.mul_le_mul_left _ (by simpa only [loss,Nat.add_assoc] using remain)
      _ = _ := Nat.mul_add .. 
    have keep : T.card^2 ≤ 2*s*(fourFamily V).card := by rw [Nat.mul_assoc]; omega
    have vc := Finset.card_le_card vt
    have ratio : T.card ≤ 2*s*V.card := by
      apply Nat.le_of_mul_le_mul_right _ pos
      rw [← pow_two]
      calc T.card^2 ≤ 2*s*(fourFamily V).card := keep
           _ ≤ 2*s*V.card^2 := Nat.mul_le_mul_left _ (fourFamily_le_square _)
           _ = (2*s*V.card)*V.card := by ring
           _ ≤ (2*s*V.card)*T.card := Nat.mul_le_mul_left _ vc
    have vcap := NonCollinearFor.subset (Finset.coe_subset.mpr vt) cap
    have enough := Nat.le_of_mul_le_mul_left (minimum.trans ratio) (show 0<2*s by positivity)
    have kcost : K.card^2 ≤ (2*s*C)*V.card := calc
      K.card^2 ≤ B.card^2 := Nat.pow_le_pow_left (Finset.card_le_card kb) 2
      _ ≤ C*T.card := cheap
      _ ≤ C*(2*s*V.card) := Nat.mul_le_mul_left _ ratio
      _ = _ := by ring
    exact (test V K enough vcap kv kcost vg rec).not_ge ((Nat.pow_le_pow_left vc 2).trans keep)

theorem closed_iff : (type_of% @Erdos101.erdos_101) ↔ closedGap := anchored_iff.trans restricted_iff

end Erdos101AnchorGeneric

/- In the remaining case each anchor is indispensable, in the first
intersection round, to a positive proportion of the anchor count in points.
Each such point is incident with a positive proportion of the point count
in four-point lines that avoid all anchors. -/
noncomputable section
namespace Erdos101AnchorGeneric
open EuclideanGeometry Finset Erdos101AnchorGeometry Erdos101AnchorField
open Erdos101AnchorCore Erdos101AnchorJoins
open scoped Classical

/-- At most two new nonanchors can lie on a join of two distinct anchors
under the no-five condition. The cruder count below is enough to identify
square-root order for the number of anchors. -/
theorem capacity {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀p∈T,p∈B ∨ determinedBy B p) : T.card ≤ B.card+4*B.card^2 := by
  let W := B.biUnion (fan T B)
  have sub : T⊆B∪W := by
    intro p pt
    rcases gen p pt with h|⟨a,ha,b,hb,_,_,_,_,_,_,_,on,_⟩
    · exact Finset.mem_union_left _ h
    · exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨a,ha,Finset.mem_biUnion.mpr
        ⟨b,hb,Finset.mem_filter.mpr ⟨pt,on⟩⟩⟩)
  have w : W.card ≤ 4*B.card^2 := (Finset.card_biUnion_le ..).trans
    ((Finset.sum_le_sum (fun a _ => fan_card (B:=B) cap a)).trans_eq (by simp; ring))
  exact (Finset.card_le_card sub).trans ((Finset.card_union_le ..).trans (Nat.add_le_add_left w _))

private theorem loss_budget (s C b n : ℕ) (sp : 0<s) (cheap : b^2 ≤ C*n)
    (big : (4*s*(16*C+5))^2*C ≤ n) :
    let L := 20*s*(C+1)
    2*(s*(b*(4*b*(4*b+n/L)+(4+b/L)*n)+b*n)) ≤ n^2 := by
  let D := 16*C+5
  let L := 20*s*(C+1)
  let base := 16*b^3+5*b*n
  let extra := 4*b^2*(n/L)+b*(b/L)*n
  have lp : 0<L := by dsimp [L]; positivity
  have small : 4*s*D*b ≤ n := by
    apply (Nat.pow_le_pow_iff_left (by decide : 2≠0)).mp
    calc (4*s*D*b)^2 = (4*s*D)^2*b^2 := mul_pow ..
         _ ≤ (4*s*D)^2*(C*n) := Nat.mul_le_mul_left _ cheap
         _ = ((4*s*D)^2*C)*n := by ring
         _ ≤ n*n := Nat.mul_le_mul_right _ big
         _ = _ := (pow_two _).symm
  have baseBound : base ≤ D*b*n := calc
    base = b*(16*b^2+5*n) := by dsimp [base]; ring
    _ ≤ b*(16*(C*n)+5*n) := Nat.mul_le_mul_left _ (Nat.add_le_add_right (Nat.mul_le_mul_left _ cheap) _)
    _ = D*b*n := by dsimp [D]; ring
  have first : 4*(s*base) ≤ n^2 := calc
    _ ≤ 4*(s*(D*b*n)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ baseBound)
    _ = (4*s*D*b)*n := by ring
    _ ≤ n*n := Nat.mul_le_mul_right _ small
    _ = _ := (pow_two _).symm
  have approx : L*extra ≤ 5*C*n^2 := calc
    L*extra = 4*b^2*((n/L)*L)+b*((b/L)*L)*n := by dsimp [extra]; ring
    _ ≤ 4*b^2*n+b*b*n := Nat.add_le_add (Nat.mul_le_mul_left _ (Nat.div_mul_le_self ..))
      (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ (Nat.div_mul_le_self ..)))
    _ = 5*b^2*n := by ring
    _ ≤ 5*(C*n)*n := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ cheap)
    _ = _ := by ring
  have second : 4*(s*extra) ≤ n^2 := by
    apply Nat.le_of_mul_le_mul_left (c:=L) _ lp
    calc L*(4*(s*extra)) = 4*s*(L*extra) := by ring
         _ ≤ 4*s*(5*C*n^2) := Nat.mul_le_mul_left _ approx
         _ = (20*s*C)*n^2 := by ring
         _ ≤ L*n^2 := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left (20*s) (Nat.le_succ C))
  have total : b*(4*b*(4*b+n/L)+(4+b/L)*n)+b*n = base+extra := by dsimp [base,extra]; ring
  change 2*(s*(b*(4*b*(4*b+n/L)+(4+b/L)*n)+b*n)) ≤ n^2
  rw [total,Nat.mul_add]
  omega

def heavilyUsed (T B : Finset ℝ²) (L : ℕ) := ∀a∈B, a∈levels (B.erase a) 3 ∧
  B.card ≤ L*(essentialAt T B (T.card/L) a).card

theorem essential_core (s C : ℕ) (sp : 0<s) {T B : Finset ℝ²}
    (cap : NonCollinearFor 5 (T : Set ℝ²)) (bt : B⊆T) (cheap : B.card^2 ≤ C*T.card)
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) (big : (4*s*(16*C+5))^2*C ≤ T.card) (positive : 0<T.card)
    (dense : T.card^2 ≤ s*(fourFamily T).card) :
    ∃ V⊆T, ∃ K⊆B, K⊆V ∧ (∀p∈V,p∈K ∨ determinedBy K p) ∧ heavilyUsed V K (20*s*(C+1)) ∧
      T.card ≤ 2*s*V.card ∧ K.card^2 ≤ 2*s*C*V.card ∧ T.card^2 ≤ 2*s*(fourFamily V).card := by
  let L := 20*s*(C+1)
  let q := 4*B.card+T.card/L
  let h := 4+B.card/L
  have lp : 0<L := by dsimp [L]; positivity
  obtain ⟨V,vt,K,kb,kv,vg,rich,remain⟩ := populated_core q h cap bt gen
  have vc := Finset.card_le_card vt
  have kc := Finset.card_le_card kb
  have vcap := NonCollinearFor.subset (Finset.coe_subset.mpr vt) cap
  let loss := B.card*(4*B.card*q+h*T.card)+B.card*T.card
  have twice : 2*(s*loss) ≤ T.card^2 := loss_budget s C B.card T.card sp cheap big
  have both : T.card^2 ≤ s*(fourFamily V).card+s*loss := calc
    _ ≤ s*(fourFamily T).card := dense
    _ ≤ s*((fourFamily V).card+loss) := Nat.mul_le_mul_left _ (by simpa only [loss,Nat.add_assoc] using remain)
    _ = _ := Nat.mul_add ..
  have keep : T.card^2 ≤ 2*s*(fourFamily V).card := by rw [Nat.mul_assoc]; omega
  have ratio : T.card ≤ 2*s*V.card := by
    apply Nat.le_of_mul_le_mul_right _ positive
    rw [← pow_two]
    calc T.card^2 ≤ 2*s*(fourFamily V).card := keep
         _ ≤ 2*s*V.card^2 := Nat.mul_le_mul_left _ (fourFamily_le_square _)
         _ = 2*s*V.card*V.card := by ring
         _ ≤ 2*s*V.card*T.card := Nat.mul_le_mul_left _ vc
  have ksize := (Nat.pow_le_pow_left kc 2).trans (cheap.trans (Nat.mul_le_mul_left C ratio))
  refine ⟨V,vt,K,kb,kv,vg,?_,ratio,ksize.trans_eq (by ring),keep⟩
  intro a ak
  change a∈levels (K.erase a) 3 ∧ K.card ≤ L*(essentialAt V K (V.card/L) a).card
  have x : 4+B.card/L < (essentialAt V K q a).card := rich a ak
  have small : V.card/L ≤ q := (Nat.div_le_div_right vc).trans (Nat.le_add_left ..)
  have sub : essentialAt V K q a ⊆ essentialAt V K (V.card/L) a := by
    intro z hz
    obtain ⟨zv,zk,loss,star⟩ := Finset.mem_filter.mp hz
    exact Finset.mem_filter.mpr ⟨zv,zk,loss,small.trans_lt star⟩
  have highDegree : K.card*4 ≤ q := calc
    K.card*4 ≤ B.card*4 := Nat.mul_le_mul_right 4 kc
    _ = 4*B.card := Nat.mul_comm ..
    _ ≤ q := Nat.le_add_right ..
  refine ⟨?_,?_⟩
  · by_contra nr
    have card := (Finset.card_le_card (essential_sub vg highDegree a)).trans (demanding_card vcap vg ak nr)
    exact (not_lt_of_ge card) ((Nat.le_add_right 4 (B.card/L)).trans_lt x)
  · have quot : B.card/L < (essentialAt V K (V.card/L) a).card :=
      ((Nat.le_add_left (B.card/L) 4).trans_lt x).trans_le (Finset.card_le_card sub)
    apply kc.trans
    rw [Nat.mul_comm L ((essentialAt V K (V.card/L) a).card)]
    exact ((Nat.div_lt_iff_lt_mul lp).mp quot).le

def essentialGap : Prop :=
  ∀s C L : ℕ, 0<s → 0<L → ∃ N : ℕ, ∀ T B : Finset ℝ², N ≤ T.card →
    NonCollinearFor 5 (T : Set ℝ²) → B⊆T → B.card^2 ≤ C*T.card →
    (∀p∈T,p∈B ∨ determinedBy B p) → heavilyUsed T B L →
    s*(fourFamily T).card < T.card^2

theorem essential_iff : (type_of% @Erdos101.erdos_101) ↔ essentialGap := by
  rw [anchored_iff]
  constructor
  · intro gap s C L sp _lp
    obtain ⟨N,test⟩ := gap s C sp
    refine ⟨N,fun T B size cap bt cheap gen _ => ?_⟩
    rw [fourFamily_eq]
    exact test T B size cap bt cheap gen
  · intro gap s C sp
    obtain ⟨M,test⟩ := gap (2*s) (2*s*C) (20*s*(C+1)) (by positivity) (by positivity)
    refine ⟨max 1 (max ((4*s*(16*C+5))^2*C) (2*s*M)),?_⟩
    intro T B large cap bt cheap gen
    rw [← fourFamily_eq]
    by_contra! dense
    obtain ⟨V,vt,K,_,kv,vg,used,scale,kcost,count⟩ := essential_core s C sp cap bt cheap gen
      ((le_max_left ..).trans ((le_max_right ..).trans large)) ((le_max_left ..).trans large) dense
    have minSize : 2*s*M ≤ T.card := (le_max_right ..).trans ((le_max_right ..).trans large)
    have enough := Nat.le_of_mul_le_mul_left (minSize.trans scale) (show 0<2*s by positivity)
    have vcap := NonCollinearFor.subset (Finset.coe_subset.mpr vt) cap
    exact (test V K enough vcap kv kcost vg used).not_ge ((Nat.pow_le_pow_left (Finset.card_le_card vt) 2).trans count)

end Erdos101AnchorGeneric

/- An indispensable anchor lies on an ordinary anchor line through its
user. The user is the intersection of exactly two anchor lines. -/
noncomputable section
namespace Erdos101AnchorGeneric
open EuclideanGeometry Finset Erdos101AnchorGeometry Erdos101AnchorField
open Erdos101AnchorCore Erdos101AnchorJoins
open scoped Classical

def joinsAt (B : Finset ℝ²) (p : ℝ²) := (determined B).filter (fun L => p∈L)

theorem joins_iff {B : Finset ℝ²} {p : ℝ²} : determinedBy B p ↔ 2 ≤ (joinsAt B p).card := by
  constructor
  · rintro ⟨a,ha,b,hb,c,hc,d,hd,ab,cd,diff,h1,h2⟩
    exact Finset.one_lt_card.mpr ⟨_,Finset.mem_filter.mpr ⟨mem_determined.mpr ⟨a,ha,b,hb,ab,rfl⟩,h1⟩,
      _,Finset.mem_filter.mpr ⟨mem_determined.mpr ⟨c,hc,d,hd,cd,rfl⟩,h2⟩,diff⟩
  · intro h
    obtain ⟨U,hu,V,hv,ne⟩ := Finset.one_lt_card.mp h
    obtain ⟨ud,up⟩ := Finset.mem_filter.mp hu
    obtain ⟨vd,vp⟩ := Finset.mem_filter.mp hv
    obtain ⟨a,ha,b,hb,ab,rfl⟩ := mem_determined.mp ud
    obtain ⟨c,hc,d,hd,cd,rfl⟩ := mem_determined.mp vd
    exact ⟨a,ha,b,hb,c,hc,d,hd,ab,cd,ne,up,vp⟩

/-- The anchor line through p and a has exactly two anchors on it. Erasing
a leaves just one of the two anchor lines at p. -/
theorem ordinary_at_essential {B : Finset ℝ²} {p a : ℝ²} (ab : a∈B) (pb : p∉B)
    (gen : determinedBy B p) (lost : p∉levels (B.erase a) 1) :
    (joinsAt B p).card=2 ∧ (joinsAt (B.erase a) p).card=1 ∧ mult B (line[ℝ,p,a])=2 := by
  let K := B.erase a
  let L := line[ℝ,p,a]
  change (joinsAt B p).card=2 ∧ (joinsAt K p).card=1 ∧ mult B L=2
  have pa : p≠a := fun e => pb (e ▸ ab)
  have lower := joins_iff.mp gen
  have upper : (joinsAt K p).card ≤ 1 := by
    by_contra! m
    exact lost (Or.inr (joins_iff.mpr m))
  have only : joinsAt B p ⊆ insert L (joinsAt K p) := by
    intro M h
    obtain ⟨md,mp⟩ := Finset.mem_filter.mp h
    by_cases ma : a∈M
    · exact Finset.mem_insert.mpr (Or.inl (unique_line md mp ma pa).symm)
    obtain ⟨b,hb,c,hc,bc,rfl⟩ := mem_determined.mp md
    have ba : b≠a := by rintro rfl; exact ma (left_mem_affineSpan_pair ..)
    have ca : c≠a := by rintro rfl; exact ma (right_mem_affineSpan_pair ..)
    exact Finset.mem_insert.mpr (Or.inr (Finset.mem_filter.mpr ⟨mem_determined.mpr
      ⟨b,Finset.mem_erase.mpr ⟨ba,hb⟩,c,Finset.mem_erase.mpr ⟨ca,hc⟩,bc,rfl⟩,mp⟩))
  have sum := (Finset.card_le_card only).trans (Finset.card_insert_le ..)
  have use := uses_if_lost gen lost
  obtain ⟨b,hb,_,_,_,_,ba,_,_,pon,_⟩ := use
  have eq : L=line[ℝ,a,b] := affineSpan_pair_eq_of_mem_of_mem_of_ne pon (left_mem_affineSpan_pair ..) pa
  have proper : L∈determined B := mem_determined.mpr ⟨a,ab,b,hb,ba,eq.symm⟩
  have two := mult_two proper
  refine ⟨by omega,by omega,le_antisymm ?_ two⟩
  by_contra! many
  have diff : incident K L=(incident B L).erase a := by
    ext z
    simp [K,incident,Finset.mem_filter,Finset.mem_erase,and_assoc]
  have erase : mult K L=mult B L-1 := by
    change (incident K L).card=(incident B L).card-1
    rw [diff,Finset.card_erase_of_mem (s:=incident B L) (Finset.mem_filter.mpr ⟨ab,right_mem_affineSpan_pair ..⟩)]
  have k2 : 2 ≤ mult K L := by rw [erase]; omega
  have inK : L∈joinsAt K p := Finset.mem_filter.mpr ⟨determined_of_two proper k2,left_mem_affineSpan_pair ..⟩
  rw [Finset.insert_eq_of_mem inK] at only
  have le := (Finset.card_le_card only).trans upper
  omega

/-- At each remaining anchor a, at least b/(4L) distinct ordinary anchor
lines through a carry a nonanchor incident to more than n/L four-point lines
avoiding all anchors. -/
theorem ordinary_rich_joins {T B : Finset ℝ²} {L : ℕ} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀p∈T,p∈B ∨ determinedBy B p) (heavy : heavilyUsed T B L) {a : ℝ²} (ab : a∈B) :
    ∃ J : Finset Line, B.card ≤ 4*L*J.card ∧ ∀H∈J, H∈determined B ∧ a∈H ∧ mult B H=2 ∧
      ∃p∈T,p∉B ∧ p∈H ∧ (joinsAt B p).card=2 ∧ T.card/L < (star (cleanLines T B) p).card := by
  let U := essentialAt T B (T.card/L) a
  let J := U.image (fun p => line[ℝ,p,a])
  have data {p : ℝ²} (hp : p∈U) := ordinary_at_essential ab (Finset.mem_filter.mp hp).2.1
    ((gen p (Finset.mem_filter.mp hp).1).resolve_left (Finset.mem_filter.mp hp).2.1) (Finset.mem_filter.mp hp).2.2.1
  have info (H) (h : H∈J) : H∈determined B ∧ a∈H ∧ mult B H=2 ∧
      ∃p∈T,p∉B ∧ p∈H ∧ (joinsAt B p).card=2 ∧ T.card/L < (star (cleanLines T B) p).card := by
    obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp h
    obtain ⟨pt,pb,lost,rich⟩ := Finset.mem_filter.mp hp
    have dd := data hp
    have proper : line[ℝ,p,a]∈determined (insert p B) := mem_determined.mpr
      ⟨p,Finset.mem_insert_self ..,a,Finset.mem_insert_of_mem ab,fun e => pb (e ▸ ab),rfl⟩
    exact ⟨determined_of_two proper dd.2.2.ge,right_mem_affineSpan_pair ..,dd.2.2,p,pt,pb,
      left_mem_affineSpan_pair ..,dd.1,rich⟩
  have cover : U⊆J.biUnion (incident T) := by
    intro p hp
    exact Finset.mem_biUnion.mpr ⟨_,Finset.mem_image_of_mem _ hp,
      Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hp).1,left_mem_affineSpan_pair ..⟩⟩
  have small : U.card ≤ J.card*4 := by
    apply (Finset.card_le_card cover).trans
    apply (Finset.card_biUnion_le ..).trans
    calc _ ≤ ∑ _ ∈ J, 4 := Finset.sum_le_sum (fun H h => by
            obtain ⟨p,_,rfl⟩ := Finset.mem_image.mp h
            exact capped (a:=p) (b:=a) cap)
         _ = _ := by simp
  refine ⟨J,(heavy a ab).2.trans ((Nat.mul_le_mul_left L small).trans_eq (by ring)),info⟩

end Erdos101AnchorGeneric

/- Sample disjoint sets of eight anchors, each of which constructs one line
through the target point. Two captured sets suffice for reconstruction. -/
noncomputable section
namespace Erdos101BlockSampling
open Erdos101AnchorSampling Finset
open scoped BigOperators Classical
variable {α : Type*} [Fintype α] [DecidableEq α]

private theorem multiply {k : ℕ} [NeZero k] (A B : Finset α) (c : α → Fin k) :
    indicator A c*indicator B c=indicator (A∪B) c := by
  by_cases ha : A⊆anchors c <;> by_cases hb : B⊆anchors c <;> simp [indicator,Finset.union_subset_iff,ha,hb]


private theorem sum_indicator {k : ℕ} [NeZero k] (B : Finset (Finset α)) (c : α → Fin k) :
    (∑ T∈B, indicator T c)=(hits B c:ℝ) := by simp [indicator,hits]


private theorem centered {k : ℕ} [NeZero k] {A B : Finset α} (ha : A.card=8) (hb : B.card=8) :
    (𝔼 c : α → Fin k, (indicator A c-1/(k:ℝ)^8)*(indicator B c-1/(k:ℝ)^8)) =
      1/(k:ℝ)^(A∪B).card-(1/(k:ℝ)^8)^2 := by
  let a := 1/(k:ℝ)^8
  have expand (c : α → Fin k) : (indicator A c-a)*(indicator B c-a) =
      (indicator (A∪B) c-indicator A c*a)-a*indicator B c+a*a := by rw [← multiply]; ring
  change (𝔼 c : α → Fin k, (indicator A c-a)*(indicator B c-a))=_
  simp_rw [expand]
  rw [Finset.expect_add_distrib,Finset.expect_sub_distrib,Finset.expect_sub_distrib,
    ← Finset.expect_mul,← Finset.mul_expect,Fintype.expect_const,mean_indicator,mean_indicator,
    mean_indicator,ha,hb]
  dsimp [a]; ring

theorem variance_blocks {k : ℕ} [NeZero k] (B : Finset (Finset α))
    (eight : ∀ T∈B,T.card=8) (dis : (B : Set (Finset α)).PairwiseDisjoint id) :
    (𝔼 c : α → Fin k, ((hits B c:ℝ)-(B.card:ℝ)/(k:ℝ)^8)^2) ≤ (B.card:ℝ)/(k:ℝ)^8 := by
  let a := 1/(k:ℝ)^8
  have expand (c : α → Fin k) :
      ((hits B c:ℝ)-(B.card:ℝ)/(k:ℝ)^8)^2 =
        ∑ T∈B, ∑ U∈B, (indicator T c-a)*(indicator U c-a) := by
    rw [← Finset.sum_mul_sum]
    have sub : (∑ T∈B, (indicator T c-a))=(hits B c:ℝ)-(B.card:ℝ)/(k:ℝ)^8 := by
      rw [Finset.sum_sub_distrib,sum_indicator]; simp [a,div_eq_mul_inv]
    rw [sub,pow_two]
  simp_rw [expand,Finset.expect_sum_comm]
  have off (T) (ht : T∈B) (U) (hu : U∈B) (ne : U≠T) :
      (𝔼 c : α → Fin k, (indicator T c-a)*(indicator U c-a))=0 := by
    rw [centered (eight T ht) (eight U hu),Finset.card_union_of_disjoint (show Disjoint T U from dis ht hu ne.symm),eight T ht,eight U hu]
    dsimp [a]; ring
  have diag (T) (ht : T∈B) : (𝔼 c : α → Fin k, (indicator T c-a)*(indicator T c-a)) ≤ a := by
    rw [centered (eight T ht) (eight T ht),Finset.union_idempotent,eight T ht]
    exact sub_le_self _ (sq_nonneg _)
  calc (∑ T∈B, ∑ U∈B, 𝔼 c : α → Fin k, (indicator T c-a)*(indicator U c-a)) ≤ ∑ _T∈B, a := by
         apply Finset.sum_le_sum; intro T ht
         rw [Finset.sum_eq_single_of_mem T ht (off T ht)]
         exact diag T ht
       _ = _ := by simp [a,div_eq_mul_inv]

/-- If d disjoint eight-element blocks are available, a uniform 1/k sample misses the
two-block threshold with probability at most 2k⁸/d. -/
theorem miss_blocks {k : ℕ} [NeZero k] (B : Finset (Finset α))
    (eight : ∀ T∈B,T.card=8) (dis : (B : Set (Finset α)).PairwiseDisjoint id)
    (degree : 4*k^8 ≤ B.card) :
    (𝔼 c : α → Fin k, if hits B c < 2 then (1:ℝ) else 0) ≤ 2*(k:ℝ)^8/B.card := by
  let mu := (B.card:ℝ)/(k:ℝ)^8
  have kp : 0<(k:ℝ) := by exact_mod_cast NeZero.pos k
  have hm : 4 ≤ mu := (le_div_iff₀ (pow_pos kp 8)).mpr (by exact_mod_cast degree)
  have pos : 0 < mu := by linarith
  have per (c : α → Fin k) : (if hits B c<2 then (1:ℝ) else 0)*(mu^2/2) ≤ ((hits B c:ℝ)-mu)^2 := by
    split_ifs with small
    · have val : (hits B c:ℝ)≤1 := by exact_mod_cast (show hits B c≤1 by omega)
      have b : 3*mu/4 ≤ mu-(hits B c:ℝ) := by linarith
      nlinarith only [sq_nonneg mu,sq_le_sq' (by linarith : -(mu-(hits B c:ℝ)) ≤ 3*mu/4) b]
    · simpa using sq_nonneg ((hits B c:ℝ)-mu)
  have ineq := Finset.expect_le_expect (s:=Finset.univ) (fun c _ => per c)
  rw [← Finset.expect_mul] at ineq
  have h := ineq.trans (variance_blocks B eight dis)
  have bound : (𝔼 c : α → Fin k, if hits B c<2 then (1:ℝ) else 0) ≤ 2/mu := by
    apply (le_div_iff₀ pos).mpr
    apply le_of_mul_le_mul_right (a:=mu) _ pos
    nlinarith only [h]
  exact bound.trans_eq (by simp [mu,div_eq_mul_inv,mul_comm,mul_assoc])

end Erdos101BlockSampling

/- Avoid any specified anchors when constructing a line through a point
on many four-point lines. A disjoint eight-anchor support gives one such
line after one round of intersections. -/
noncomputable section
namespace Erdos101DepthSupports
open EuclideanGeometry Finset Erdos101AnchorGeometry
open Erdos101AnchorField Erdos101AnchorJoins Erdos101AnchorCore Erdos101AnchorGeneric
open scoped Classical

theorem levels_mono {R B : Finset ℝ²} (sub : R⊆B) (i : ℕ) : levels R i ⊆ levels B i := by
  induction i with
  | zero => exact sub
  | succ i ih =>
    rintro p (h|⟨a,ha,b,hb,c,hc,d,hd,ab,cd,ne,one,two⟩)
    · exact Or.inl (ih h)
    · exact Or.inr ⟨a,ih ha,b,ih hb,c,ih hc,d,ih hd,ab,cd,ne,one,two⟩

private def shadow (T B E : Finset ℝ²) := E.biUnion (fan T B)

private lemma shadow_count {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²)) (E : Finset ℝ²) :
    (shadow T B E).card≤E.card*(B.card*4) := (Finset.card_biUnion_le ..).trans
      ((Finset.sum_le_sum (fun a _ => fan_card (B:=B) cap a)).trans_eq (by simp))

private lemma support {T B E : Finset ℝ²} {q : ℝ²} (qt : q∈T)
    (off : q∉shadow T B E) (gen : q∈B ∨ determinedBy B q) :
    ∃ V⊆B\E,V.card≤4 ∧ q∈levels V 1 := by
  have avoid {x y : ℝ²} (yb : y∈B) (on : q∈line[ℝ,x,y]) : x∉E := fun xe =>
    off (Finset.mem_biUnion.mpr ⟨x,xe,Finset.mem_biUnion.mpr ⟨y,yb,Finset.mem_filter.mpr ⟨qt,on⟩⟩⟩)
  rcases gen with qb|⟨a,ha,b,hb,c,hc,d,hd,ab,cd,ne,one,two⟩
  · exact ⟨{q},Finset.singleton_subset_iff.mpr (Finset.mem_sdiff.mpr ⟨qb,avoid qb (left_mem_affineSpan_pair ..)⟩),by simp,
      Or.inl (Finset.mem_singleton_self _)⟩
  · have ba : q∈line[ℝ,b,a] := by rwa [Set.pair_comm]
    have dc : q∈line[ℝ,d,c] := by rwa [Set.pair_comm]
    let V : Finset ℝ² := {a,b,c,d}
    have sub : V⊆B\E := by
      rintro x hx
      simp only [V,Finset.mem_insert,Finset.mem_singleton] at hx
      rcases hx with rfl|rfl|rfl|rfl
      · exact Finset.mem_sdiff.mpr ⟨ha,avoid hb one⟩
      · exact Finset.mem_sdiff.mpr ⟨hb,avoid ha ba⟩
      · exact Finset.mem_sdiff.mpr ⟨hc,avoid hd two⟩
      · exact Finset.mem_sdiff.mpr ⟨hd,avoid hc dc⟩
    have sz : V.card≤4 := by
      dsimp [V]; have h1 := Finset.card_insert_le a ({b,c,d} : Finset ℝ²)
      have h2 := Finset.card_insert_le b ({c,d} : Finset ℝ²); have h3 := Finset.card_insert_le c ({d} : Finset ℝ²)
      rw [Finset.card_singleton] at h3; omega
    exact ⟨V,sub,sz,Or.inr ⟨a,by simp [V,levels],b,by simp [V,levels],c,by simp [V,levels],d,by simp [V,levels],ab,cd,ne,one,two⟩⟩

def names {B : Finset ℝ²} (V : Finset B) := V.image Subtype.val

lemma names_sub {B : Finset ℝ²} (V : Finset B) : names V⊆B := by
  rintro q h; obtain ⟨v,_,rfl⟩ := Finset.mem_image.mp h; exact v.property

lemma names_card {B : Finset ℝ²} (V : Finset B) : (names V).card=V.card :=
  Finset.card_image_of_injective _ Subtype.val_injective

def lineFrom (R : Finset ℝ²) (L : Line) :=
  ∃u∈levels R 1,∃v∈levels R 1,u≠v ∧ line[ℝ,u,v]=L

/-- With `E` already used, every line that is unusable is either already
selected or passes through another point in the shadow of `E`. -/
lemma fresh {T B : Finset ℝ²} {A G : Finset Line} {p : ℝ²} (pt : p∈T)
    (E : Finset B) (cap : NonCollinearFor 5 (T : Set ℝ²)) (gen : ∀q∈T,q∈B ∨ determinedBy B q)
    (four : A⊆fourFamily T) (room : 8+E.card≤B.card)
    (many : G.card+E.card*(B.card*4)<(star A p).card) :
    ∃ (V : Finset B) (L : Line), V.card=8 ∧ Disjoint V E ∧ L∈star A p ∧ L∉G ∧ lineFrom (names V) L := by
  classical
  let D := shadow T B (names E)
  let forbidden := G ∪ D.image (fun q => line[ℝ,p,q])
  have fs : forbidden.card≤G.card+E.card*(B.card*4) := (Finset.card_union_le ..).trans
    (Nat.add_le_add_left (Finset.card_image_le.trans ((shadow_count cap _).trans_eq (by rw [names_card]))) _)
  obtain ⟨L,hl,usable⟩ := Finset.not_subset.mp (fun h => many.not_ge ((Finset.card_le_card h).trans fs))
  obtain ⟨al,pl⟩ := Finset.mem_filter.mp hl
  obtain ⟨proper,size⟩ := Finset.mem_filter.mp (four al)
  have enough : 1<((incident T L).erase p).card := by
    rw [Finset.card_erase_of_mem (s:=incident T L) (Finset.mem_filter.mpr ⟨pt,pl⟩)]; change 1 < mult T L-1; omega
  obtain ⟨u,hu,v,hv,uv⟩ := Finset.one_lt_card.mp enough
  have clear (q) (hq : q∈(incident T L).erase p) : ∃V⊆B\names E,V.card≤4 ∧ q∈levels V 1 := by
    obtain ⟨qp,qi⟩ := Finset.mem_erase.mp hq
    obtain ⟨qt,ql⟩ := Finset.mem_filter.mp qi
    apply support qt _ (gen q qt)
    intro h
    exact usable (Finset.mem_union_right G (Finset.mem_image.mpr ⟨q,h,unique_line proper pl ql qp.symm⟩))
  obtain ⟨U,us,uc,ur⟩ := clear u hu
  obtain ⟨V,vs,vc,vr⟩ := clear v hv
  let Q : Finset B := Finset.univ.filter (fun a => a.val∈U∪V)
  have eq : names Q=U∪V := by
    ext a
    constructor
    · intro h; obtain ⟨b,hb,rfl⟩ := Finset.mem_image.mp h; exact (Finset.mem_filter.mp hb).2
    · intro h; have ab := (Finset.union_subset us vs h)
      exact Finset.mem_image.mpr ⟨⟨a,(Finset.mem_sdiff.mp ab).1⟩,Finset.mem_filter.mpr ⟨Finset.mem_univ _,h⟩,rfl⟩
  have sub : Q⊆Finset.univ\E := by
    intro a ha
    have inside := Finset.union_subset us vs (Finset.mem_filter.mp ha).2
    exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ _,fun ae => (Finset.mem_sdiff.mp inside).2 (Finset.mem_image_of_mem Subtype.val ae)⟩
  have qsize : Q.card≤8 := by rw [←names_card,eq]; have := Finset.card_union_le U V; omega
  have space : 8≤(Finset.univ\E).card := by rw [Finset.card_sdiff_of_subset (Finset.subset_univ E),Finset.card_univ,Fintype.card_coe]; omega
  obtain ⟨M,qm,ms,mc⟩ := Finset.exists_subsuperset_card_eq sub qsize space
  have nm : U∪V⊆names M := eq ▸ Finset.image_mono Subtype.val qm
  exact ⟨M,L,mc,Finset.disjoint_left.mpr (fun x hx => (Finset.mem_sdiff.mp (ms hx)).2),hl,
    fun lg => usable (Finset.mem_union_left _ lg),u,levels_mono (Finset.subset_union_left.trans nm) 1 ur,
    v,levels_mono (Finset.subset_union_right.trans nm) 1 vr,uv,
    unique_line proper (Finset.mem_filter.mp (Finset.mem_erase.mp hu).2).2 (Finset.mem_filter.mp (Finset.mem_erase.mp hv).2).2 uv⟩

end Erdos101DepthSupports

/- A point of large incidence degree has many pairwise disjoint sets of
eight anchors determining different lines through it. -/
noncomputable section
namespace Erdos101DepthPacking
open EuclideanGeometry Finset Erdos101AnchorGeometry Erdos101AnchorJoins Erdos101AnchorCore
open Erdos101AnchorField Erdos101AnchorGeneric Erdos101DepthSupports Erdos101AnchorSampling
open scoped Classical

private abbrev Record (B : Finset ℝ²) := Finset B × Line

private def packing {B : Finset ℝ²} (X : Finset (Record B)) (H : Finset Line) :=
  (∀x∈X,x.1.card=8 ∧ x.2∈H ∧ lineFrom (names x.1) x.2) ∧
  (∀x∈X,∀y∈X,x≠y → Disjoint x.1 y.1 ∧ x.2≠y.2)

private theorem build {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) {A : Finset Line} (four : A⊆fourFamily T) {p : ℝ²} (pt : p∈T)
    (m : ℕ) (room : 8*m≤B.card) (degree : (1+32*B.card)*m≤(star A p).card) :
    ∃X : Finset (Record B), X.card=m ∧ packing X (star A p) := by
  induction m with
  | zero => exact ⟨∅,rfl,by simp [packing]⟩
  | succ m ih =>
    have rprev := (Nat.mul_le_mul_left 8 (Nat.le_succ m)).trans room
    have dprev := (Nat.mul_le_mul_left (1+32*B.card) (Nat.le_succ m)).trans degree
    obtain ⟨X,n,info,pairs⟩ := ih rprev dprev
    let E := X.biUnion Prod.fst
    let G := X.image Prod.snd
    have esz : E.card≤8*m := calc
      _ ≤ ∑x∈X,x.1.card := Finset.card_biUnion_le
      _ = 8*m := by rw [Finset.sum_congr rfl (fun x hx => (info x hx).1)]; simp [n,Nat.mul_comm]
    have gs : G.card ≤ m := Finset.card_image_le.trans n.le
    have avail : 8+E.card≤B.card := (Nat.add_le_add_left esz 8).trans (by omega)
    have many : G.card+E.card*(B.card*4)<(star A p).card := by
      apply lt_of_lt_of_le _ degree
      calc
        _ ≤ m+(8*m)*(B.card*4) := Nat.add_le_add gs (Nat.mul_le_mul_right _ esz)
        _ = (1+32*B.card)*m := by ring
        _ < (1+32*B.card)*(m+1) := Nat.mul_lt_mul_of_pos_left (Nat.lt_succ_self m) (by omega)
    obtain ⟨V,L,sz,dis,hl,out,join⟩ := fresh pt E cap gen four avail many
    let u : Record B := (V,L)
    have new : u∉X := fun h => out (Finset.mem_image_of_mem Prod.snd h)
    have sep (y : Record B) (hy : y∈X) : Disjoint V y.1 ∧ L≠y.2 :=
      ⟨dis.mono_right (Finset.subset_biUnion_of_mem Prod.fst hy),fun eq => out (eq ▸ Finset.mem_image_of_mem Prod.snd hy)⟩
    refine ⟨insert u X,by rw [Finset.card_insert_of_notMem new,n],?_,?_⟩
    · intro x hx
      rcases Finset.mem_insert.mp hx with rfl|h
      · exact ⟨sz,hl,join⟩
      · exact info x h
    · intro x hx y hy ne
      rcases Finset.mem_insert.mp hx with rfl|hx <;> rcases Finset.mem_insert.mp hy with rfl|hy
      · exact (ne rfl).elim
      · exact sep y hy
      · exact ⟨(sep x hx).1.symm,Ne.symm (sep x hx).2⟩
      · exact pairs x hx y hy ne

/-- The mask family is sampled on the common set of anchors. Any two hits
construct two different lines through the target, recovering it at depth two. -/
theorem family {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) {A : Finset Line} (four : A⊆fourFamily T) {p : ℝ²} (pt : p∈T)
    (m : ℕ) (room : 8*m≤B.card) (degree : (1+32*B.card)*m≤(star A p).card) :
    ∃ W : Finset (Finset B), W.card=m ∧ (∀Q∈W,Q.card=8) ∧ (W : Set (Finset B)).PairwiseDisjoint id ∧
      ∀{k : ℕ} [NeZero k] (c : B → Fin k), 2≤hits W c → p∈levels (sample c) 2 := by
  obtain ⟨X,n,info,pairs⟩ := build cap gen four pt m room degree
  let W := X.image Prod.fst
  have inj : Set.InjOn Prod.fst (↑X : Set (Record B)) := by
    intro x hx y hy same
    by_contra ne
    have dis := (pairs x hx y hy ne).1
    change x.1=y.1 at same
    rw [←same,Finset.disjoint_self_iff_empty] at dis
    have eight := (info x hx).1; rw [dis,Finset.card_empty] at eight; omega
  refine ⟨W,(Finset.card_image_of_injOn inj).trans n,?_,?_,?_⟩
  · rintro Q hq; obtain ⟨x,hx,rfl⟩ := Finset.mem_image.mp hq; exact (info x hx).1
  · intro Q hq R hr ne
    obtain ⟨x,hx,rfl⟩ := Finset.mem_image.mp hq
    obtain ⟨y,hy,rfl⟩ := Finset.mem_image.mp hr
    exact (pairs x hx y hy (fun eq => ne (congrArg Prod.fst eq))).1
  · intro k _ c many
    obtain ⟨Q,hq,R,hr,neq⟩ := Finset.one_lt_card.mp many
    obtain ⟨qm,qs⟩ := Finset.mem_filter.mp hq
    obtain ⟨rm,rs⟩ := Finset.mem_filter.mp hr
    obtain ⟨x,hx,rfl⟩ := Finset.mem_image.mp qm
    obtain ⟨y,hy,rfl⟩ := Finset.mem_image.mp rm
    obtain ⟨a,ha,b,hb,ab,e⟩ := (info x hx).2.2
    obtain ⟨d,hd,g,hg,dg,f⟩ := (info y hy).2.2
    have first : names x.1⊆sample c := Finset.image_mono Subtype.val qs
    have second : names y.1⊆sample c := Finset.image_mono Subtype.val rs
    refine Or.inr ⟨a,levels_mono first 1 ha,b,levels_mono first 1 hb,d,levels_mono second 1 hd,
      g,levels_mono second 1 hg,ab,dg,?_,?_,?_⟩
    · rw [e,f]; exact (pairs x hx y hy (fun eq => neq (congrArg Prod.fst eq))).2
    · rw [e]; exact (Finset.mem_filter.mp (info x hx).2.1).2
    · rw [f]; exact (Finset.mem_filter.mp (info y hy).2.1).2

end Erdos101DepthPacking

/- A single sample of the original anchors recovers almost all high-degree
points in two straightedge rounds. -/
noncomputable section
namespace Erdos101DepthSample
open Erdos101AnchorGeometry Erdos101AnchorSampling Erdos101BlockSampling Erdos101AnchorJoins
open Erdos101AnchorField Erdos101AnchorGeneric Erdos101AnchorCore Erdos101DepthPacking
open EuclideanGeometry Finset
open scoped BigOperators Classical

def missedTwo (U R : Finset ℝ²) := U.filter (fun p => p∉levels R 2)

private theorem mean {T B U : Finset ℝ²} {A : Finset Line} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) (four : A⊆fourFamily T) (sub : U⊆T)
    {k m : ℕ} [NeZero k] (thresh : 4*k^8 ≤ m) (room : 8*m≤B.card)
    (rich : ∀p∈U,(1+32*B.card)*m≤(star A p).card) :
    (𝔼 c : B → Fin k, ((missedTwo U (sample c)).card:ℝ)) ≤ U.card*(2*(k:ℝ)^8/m) := by
  classical
  have point (p : U) : (𝔼 c : B → Fin k, if p.val∉levels (sample c) 2 then (1:ℝ) else 0) ≤ 2*(k:ℝ)^8/m := by
    obtain ⟨W,sz,eight,dis,correct⟩ := family cap gen four (sub p.property) m room (rich p.val p.property)
    have per (c : B → Fin k) : (if p.val∉levels (sample c) 2 then (1:ℝ) else 0) ≤ if hits W c<2 then (1:ℝ) else 0 := by
      by_cases small : hits W c<2
      · simp [small]; split_ifs <;> norm_num
      · simp [small,correct c (le_of_not_gt small)]
    apply (Finset.expect_le_expect (fun c _ => per c)).trans
    simpa only [sz] using miss_blocks W eight dis (sz ▸ thresh)
  have num (c : B → Fin k) : ((missedTwo U (sample c)).card:ℝ)=∑p : U,if p.val∉levels (sample c) 2 then (1:ℝ) else 0 := by
    rw [Finset.sum_boole]
    change _=((U.attach.filter (fun p : U => p.val∉levels (sample c) 2)).card:ℝ)
    rw [Finset.filter_attach (fun p : ℝ² => p∉levels (sample c) 2) U]
    simp [missedTwo]
  simp_rw [num,Finset.expect_sum_comm]
  exact (Finset.sum_le_sum (fun p _ => point p)).trans_eq (by simp)

theorem choose_seed {T B U : Finset ℝ²} {A : Finset Line} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) (four : A⊆fourFamily T) (sub : U⊆T)
    {k m : ℕ} [NeZero k] (thresh : 4*k^8 ≤ m) (room : 8*m≤B.card)
    (rich : ∀p∈U,(1+32*B.card)*m≤(star A p).card) :
    ∃R⊆B,k*R.card≤2*B.card ∧ m*(missedTwo U R).card≤4*k^8*U.card := by
  classical
  by_cases posU : U.card=0
  · have uz := Finset.card_eq_zero.mp posU
    exact ⟨∅,Finset.empty_subset _,by simp,by simp [uz,missedTwo]⟩
  let t := (m:ℝ)/(2*(k:ℝ)^8)
  have kp : 0<(k:ℝ) := by exact_mod_cast NeZero.pos k
  have mp : 0 < (m:ℝ) := by exact_mod_cast (lt_of_lt_of_le (by have := NeZero.pos k; positivity : 0<4*k^8) thresh)
  have up : 0<(U.card:ℝ) := by exact_mod_cast Nat.pos_of_ne_zero posU
  have bp : 0<(B.card:ℝ) := by exact_mod_cast (lt_of_lt_of_le (by exact Nat.mul_pos (by decide) (by exact_mod_cast mp) : 0<8*m) room)
  have tp : 0<t := by dsimp [t]; positivity
  have mu := mean cap gen four sub thresh room rich (k:=k)
  have sc := mul_le_mul_of_nonneg_left mu tp.le
  have cancel : t*(U.card*(2*(k:ℝ)^8/m))=U.card := by dsimp [t]; field_simp
  rw [cancel] at sc
  have total : (𝔼 c : B → Fin k, ((U.card:ℝ)*(k:ℝ)*(anchors c).card+(B.card:ℝ)*t*(missedTwo U (sample c)).card))≤2*(U.card:ℝ)*B.card := by
    rw [Finset.expect_add_distrib,←Finset.mul_expect,←Finset.mul_expect,mean_anchors]
    simp only [Fintype.card_coe]
    have v : (U.card:ℝ)*k*(B.card/k)=U.card*B.card := by field_simp
    rw [v,mul_assoc (B.card:ℝ)]
    nlinarith only [mul_le_mul_of_nonneg_left sc bp.le]
  obtain ⟨c,_,hc⟩ := Finset.exists_le_of_expect_le Finset.univ_nonempty total
  refine ⟨sample c,sample_sub c,?_,?_⟩
  · rw [sample_card]
    have le : (U.card:ℝ)*((k:ℝ)*(anchors c).card)≤(U.card:ℝ)*(2*B.card) := by
      nlinarith only [hc,mul_nonneg (mul_nonneg bp.le tp.le) (Nat.cast_nonneg (missedTwo U (sample c)).card)]
    exact_mod_cast (le_of_mul_le_mul_left le up)
  · have le : (B.card:ℝ)*(t*(missedTwo U (sample c)).card)≤(B.card:ℝ)*(2*U.card) := by
      nlinarith only [hc,mul_nonneg (mul_nonneg up.le kp.le) (Nat.cast_nonneg (anchors c).card)]
    have v := mul_le_mul_of_nonneg_left (le_of_mul_le_mul_left le bp) (show 0≤2*(k:ℝ)^8 by positivity)
    have eq : 2*(k:ℝ)^8*(t*(missedTwo U (sample c)).card)=m*(missedTwo U (sample c)).card := by dsimp [t]; field_simp
    rw [eq] at v
    exact_mod_cast (by linarith only [v] : (m:ℝ)*(missedTwo U (sample c)).card≤4*(k:ℝ)^8*U.card)

end Erdos101DepthSample

/- Thin a one-round anchor set while keeping a positive fraction of the
original four-point lines after a second intersection round. -/
noncomputable section
namespace Erdos101DepthCompression
open Erdos101AnchorGeometry Erdos101AnchorJoins Erdos101AnchorCore Erdos101AnchorField
open Erdos101AnchorGeneric Erdos101DepthSample EuclideanGeometry Finset
open scoped Classical

theorem compress {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) (bp : 0<B.card) (s k : ℕ) (sp : 0 < s) (kp : 0<k)
    (large : 4096*s^2*B.card*k^8 ≤ T.card) (dense : T.card^2 ≤ s*(fourFamily T).card) :
    ∃ R⊆B, k*R.card ≤ 2*B.card ∧ ∃G⊆fourFamily T,(fourFamily T).card ≤ 4*G.card ∧
      ∀L∈G,∀p∈T,p∈L → p∈levels R 2 := by
  classical
  let A := fourFamily T
  let m := 16*s*k^8
  let d := (1+32*B.card)*m
  have thresh : 4*k^8 ≤ m := Nat.mul_le_mul_right _ (by omega)
  have capacity' : T.card ≤ B.card*(5*B.card) := (capacity cap gen).trans (by
    have sq : B.card ≤ B.card*B.card := Nat.le_mul_of_pos_right _ bp
    nlinarith only [sq])
  have factor : 4096*s^2*k^8 ≤ 5*B.card := Nat.le_of_mul_le_mul_left (c:=B.card) (by
    calc B.card*(4096*s^2*k^8) = 4096*s^2*B.card*k^8 := by ring
         _ ≤ _ := large.trans capacity') bp
  have room : 8*m ≤ B.card := by
    apply Nat.le_of_mul_le_mul_left (c:=5) _ (by decide)
    calc 5*(8*m) = (640*s)*k^8 := by dsimp [m]; ring
         _ ≤ (4096*s^2)*k^8 := Nat.mul_le_mul_right _ (by
           have sq : s ≤ s^2 := by rw [pow_two]; exact Nat.le_mul_of_pos_right s sp
           omega)
         _ ≤ _ := factor
  have small : 2*d*s ≤ T.card := by
    calc 2*d*s = 32*s^2*(1+32*B.card)*k^8 := by dsimp [d,m]; ring
         _ ≤ 32*s^2*(128*B.card)*k^8 := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ (by omega))
         _ = 4096*s^2*B.card*k^8 := by ring
         _ ≤ _ := large
  have full (L) (h : L∈A) : mult T L=4 := (Finset.mem_filter.mp h).2
  obtain ⟨U,us,F,fa,rich,keep,minD⟩ := peel T A 4 d (fun L h => (full L h).ge)
  let _ : NeZero k := ⟨kp.ne'⟩
  obtain ⟨R,rb,cheap,miss⟩ := choose_seed cap gen fa us thresh room minD
  let E := missedTwo U R
  have uc := Finset.card_le_card us
  have few : 4*s*E.card ≤ T.card := by
    apply Nat.le_of_mul_le_mul_left (c:=4*k^8) _ (by positivity)
    calc 4*k^8*(4*s*E.card) = m*E.card := by dsimp [m]; ring
         _ ≤ 4*k^8*U.card := miss
         _ ≤ _ := Nat.mul_le_mul_left _ uc
  have half : A.card ≤ 2*F.card := by
    have pay : 2*d*T.card ≤ A.card := by
      apply Nat.le_of_mul_le_mul_left (c:=s) _ sp
      calc s*(2*d*T.card) = (2*d*s)*T.card := by ring
           _ ≤ T.card*T.card := Nat.mul_le_mul_right _ small
           _ ≤ s*A.card := by simpa only [pow_two] using dense
    have cost := Nat.mul_le_mul_left d (Nat.sub_le T.card U.card)
    have dec : 2*d*T.card=2*(d*T.card) := by ring
    omega
  let bad := E.biUnion (star F)
  let G := F\bad
  have badsize : bad.card ≤ E.card*T.card := by
    apply Finset.card_biUnion_le.trans
    apply (Finset.sum_le_sum (g:=fun _ => T.card) _).trans_eq (by simp)
    intro p hp
    have sub : star F p⊆star (fourFamily T) p := Finset.filter_subset_filter _ fa
    exact (Finset.card_le_card sub).trans (pencil_size (us (Finset.mem_filter.mp hp).1))
  have quarter : 4*bad.card ≤ A.card := by
    apply Nat.le_of_mul_le_mul_left (c:=s) _ sp
    calc s*(4*bad.card) ≤ s*(4*(E.card*T.card)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ badsize)
         _ = (4*s*E.card)*T.card := by ring
         _ ≤ T.card*T.card := Nat.mul_le_mul_right _ few
         _ ≤ _ := by simpa only [pow_two] using dense
  have bf : bad⊆F := fun L h => by obtain ⟨p,_,hl⟩ := Finset.mem_biUnion.mp h; exact (Finset.mem_filter.mp hl).1
  have eq : G.card+bad.card=F.card := Finset.card_sdiff_add_card_eq_card bf
  refine ⟨R,rb,cheap,G,Finset.sdiff_subset.trans fa,by change A.card ≤ 4*G.card; omega,?_⟩
  intro L hl p pt pl
  obtain ⟨lf,off⟩ := Finset.mem_sdiff.mp hl
  have eqI : incident U L=incident T L := Finset.eq_of_subset_of_card_le (incident_mono us L)
    (by change mult T L ≤ mult U L; rw [full _ (fa lf)]; exact rich L lf)
  have pu : p∈U := (Finset.mem_filter.mp (show p∈incident U L by rw [eqI]; exact Finset.mem_filter.mpr ⟨pt,pl⟩)).1
  by_contra no
  exact off (Finset.mem_biUnion.mpr ⟨p,Finset.mem_filter.mpr ⟨pu,no⟩,Finset.mem_filter.mpr ⟨lf,pl⟩⟩)

end Erdos101DepthCompression

/- Two intersection rounds reduce the exponent for the number of anchors
from one half to seven sixteenths in every sufficiently large dense witness. -/
noncomputable section
namespace Erdos101DepthExponent
open Erdos101AnchorGeometry Erdos101AnchorField Erdos101AnchorCore Erdos101AnchorGeneric
open Erdos101DepthCompression EuclideanGeometry Finset Filter Asymptotics
open scoped Classical

lemma choose_scale (a n h : ℕ) (ap : 0<a) (hp : 0<h) (large : a ≤ n) :
    ∃k : ℕ,0<k ∧ a*k^h ≤ n ∧ n ≤ a*(2*k)^h := by
  have ex : ∃t : ℕ,n<a*t^h := by
    refine ⟨n+1,(Nat.lt_succ_self n).trans_le ?_⟩
    exact (le_self_pow₀ (by omega : 1 ≤ n+1) hp.ne').trans (Nat.le_mul_of_pos_left _ ap)
  let t := Nat.find ex
  have ht : n<a*t^h := Nat.find_spec ex
  have two : 2 ≤ t := by
    by_contra! tiny
    have le : t^h ≤ 1^h := Nat.pow_le_pow_left (by omega) h
    rw [one_pow] at le
    have bound := Nat.mul_le_mul_left a le
    rw [mul_one] at bound; omega
  let k := t-1
  have lt : k<t := by dsimp [k]; omega
  have upper := not_lt.mp (Nat.find_min ex lt)
  exact ⟨k,by dsimp [k]; omega,upper,ht.le.trans (Nat.mul_le_mul_left a (Nat.pow_le_pow_left (by dsimp [k]; omega) h))⟩

def cost (s C : ℕ) := (256*(4096*s^2))^2*2^16*C^9

private lemma saving (s C b n r k : ℕ) (positive : 0<n) (small : b^2 ≤ C*n)
    (cheap : k*r ≤ 2*b) (scale : n ≤ 4096*s^2*b*(2*k)^8) : r^16 ≤ cost s C*n^7 := by
  let d := 4096*s^2
  apply Nat.le_of_mul_le_mul_left (c:=n^2) _ (by positivity)
  calc
    n^2*r^16 ≤ (d*b*(2*k)^8)^2*r^16 := Nat.mul_le_mul_right _ (Nat.pow_le_pow_left scale 2)
    _ = (256*d)^2*b^2*(k*r)^16 := by ring
    _ ≤ (256*d)^2*b^2*(2*b)^16 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left cheap 16)
    _ = (256*d)^2*2^16*(b^2)^9 := by ring
    _ ≤ (256*d)^2*2^16*(C*n)^9 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left small 9)
    _ = n^2*(cost s C*n^7) := by dsimp [cost,d]; ring

/-- Extract a dense subset with all of its points generated by two
intersection rounds. The anchor bound is relative to the extracted set. -/
theorem extract (s C : ℕ) (sp : 0<s) {T B : Finset ℝ²}
    (large : (4096*s^2)^2*C ≤ T.card) (positive : 0<T.card)
    (cap : NonCollinearFor 5 (T : Set ℝ²)) (bt : B⊆T) (small : B.card^2 ≤ C*T.card)
    (gen : ∀p∈T,p∈B ∨ determinedBy B p) (dense : T.card^2 ≤ s*(fourFamily T).card) :
    ∃V⊆T, ∃R⊆V, (∀p∈V,p∈levels R 2) ∧ T.card ≤ 4*s*V.card ∧
      R.card^16 ≤ (cost s C*(4*s)^7)*V.card^7 ∧ T.card^2 ≤ 4*s*(fourFamily V).card := by
  have bp : 0<B.card := by
    have fromCap := capacity cap gen
    by_contra! zero
    have z : B.card=0 := by omega
    exact positive.not_ge (by simpa only [z,zero_pow (by decide : 2≠0),mul_zero,add_zero] using fromCap)
  have scale : 4096*s^2*B.card ≤ T.card := by
    apply (Nat.pow_le_pow_iff_left (by decide : 2≠0)).mp
    calc (4096*s^2*B.card)^2=(4096*s^2)^2*B.card^2 := mul_pow ..
         _ ≤ (4096*s^2)^2*(C*T.card) := Nat.mul_le_mul_left _ small
         _ = ((4096*s^2)^2*C)*T.card := by ring
         _ ≤ T.card*T.card := Nat.mul_le_mul_right _ large
         _ = _ := (pow_two _).symm
  obtain ⟨k,kp,lo,hi⟩ := choose_scale (4096*s^2*B.card) T.card 8 (by positivity) (by decide) scale
  obtain ⟨R,rb,cheap,G,ga,keep,recover⟩ := Erdos101DepthCompression.compress cap gen bp s k sp kp lo dense
  let V := R ∪ T.filter (fun p => p∈levels R 2)
  have vs : V⊆T := Finset.union_subset (rb.trans bt) (Finset.filter_subset ..)
  have hits : G⊆fourFamily V := by
    intro L hl
    obtain ⟨proper,size⟩ := Finset.mem_filter.mp (ga hl)
    have eq : incident V L=incident T L := by
      apply Finset.Subset.antisymm (incident_mono vs L)
      intro p hp; obtain ⟨pt,pl⟩ := Finset.mem_filter.mp hp
      exact Finset.mem_filter.mpr ⟨Finset.mem_union_right R (Finset.mem_filter.mpr ⟨pt,recover L hl p pt pl⟩),pl⟩
    have four : mult V L=4 := (congrArg Finset.card eq).trans size
    exact Finset.mem_filter.mpr ⟨determined_of_two proper (by omega),four⟩
  have remain : T.card^2 ≤ 4*s*(fourFamily V).card := calc
    _ ≤ s*(fourFamily T).card := dense
    _ ≤ s*(4*G.card) := Nat.mul_le_mul_left _ keep
    _ ≤ s*(4*(fourFamily V).card) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Finset.card_le_card hits))
    _ = _ := by ring
  have size : T.card ≤ 4*s*V.card := by
    apply Nat.le_of_mul_le_mul_right _ positive
    rw [←pow_two]
    calc _ ≤ 4*s*(fourFamily V).card := remain
         _ ≤ 4*s*V.card^2 := Nat.mul_le_mul_left _ (fourFamily_le_square _)
         _ = 4*s*V.card*V.card := by ring
         _ ≤ _ := Nat.mul_le_mul_left _ (Finset.card_le_card vs)
  refine ⟨V,vs,R,Finset.subset_union_left,?_,size,?_,remain⟩
  · intro p hp
    rcases Finset.mem_union.mp hp with h|h
    · exact initial_level h 2
    · exact (Finset.mem_filter.mp h).2
  · exact (saving s C _ _ _ _ positive small cheap hi).trans
      ((Nat.mul_le_mul_left _ (Nat.pow_le_pow_left size 7)).trans_eq (by ring))

/-- It suffices to rule out positive density on sets generated in two rounds
by `O(n^(7/16))` of their points. -/
def gap : Prop := ∀s C : ℕ,0<s → ∃N : ℕ,∀T R : Finset ℝ²,N ≤ T.card →
  NonCollinearFor 5 (T : Set ℝ²) → R⊆T → R.card^16 ≤ C*T.card^7 → (∀p∈T,p∈levels R 2) →
  s*(fourFamily T).card<T.card^2

theorem gap_iff : (type_of% @Erdos101.erdos_101) ↔ gap := by
  constructor
  · intro full s C sp
    obtain ⟨N,bound⟩ := eventually_atTop.mp (isLittleO_iff_nat_mul_le.mp full (2*s))
    refine ⟨max N 1,?_⟩
    intro T R large cap _ _ _
    have num := bound T.card ((le_max_left ..).trans large)
    change ((2*s : ℕ) : ℝ)*‖(Erdos101.numLinesWithFourPointMax T.card : ℝ)‖ ≤ ‖(T.card:ℝ)^2‖ at num
    rw [Real.norm_of_nonneg (Nat.cast_nonneg _),Real.norm_of_nonneg (sq_nonneg _)] at num
    have h : (2*s)*Erdos101.numLinesWithFourPointMax T.card ≤ T.card^2 := by exact_mod_cast num
    have less := (Nat.mul_le_mul_left (2*s) (count_le_max T cap)).trans h
    rw [←fourFamily_eq] at less
    have pos : 0<T.card := (le_max_right ..).trans large
    by_contra! bad
    have z := Nat.mul_le_mul_left 2 bad
    rw [←Nat.mul_assoc] at z; nlinarith only [z,less,Nat.pow_pos pos (n:=2)]
  · intro test
    apply anchored_iff.mpr
    intro s C sp
    obtain ⟨N,check⟩ := test (4*s) (cost s C*(4*s)^7) (by positivity)
    refine ⟨max 1 (max ((4096*s^2)^2*C) (4*s*N)),?_⟩
    intro T B big cap bt cheap gen
    rw [←fourFamily_eq]
    by_contra! dense
    obtain ⟨V,vt,R,rv,recover,size,pay,keep⟩ := extract s C sp ((le_max_left ..).trans ((le_max_right ..).trans big))
      ((le_max_left ..).trans big) cap bt cheap gen dense
    have minSize : 4*s*N ≤ T.card := (le_max_right ..).trans ((le_max_right ..).trans big)
    have enough := Nat.le_of_mul_le_mul_left (minSize.trans size) (show 0<4*s by positivity)
    have vcap := NonCollinearFor.subset (Finset.coe_subset.mpr vt) cap
    exact (check V R enough vcap rv pay recover).not_ge ((Nat.pow_le_pow_left (Finset.card_le_card vt) 2).trans keep)

end Erdos101DepthExponent

/- A second-moment bound for overlapping anchor supports. Normalize each
hit by the reciprocal of its probability, so supports can have different sizes. -/
noncomputable section
namespace Erdos101OverlapSampling
open Erdos101AnchorSampling Finset
open scoped BigOperators Classical
variable {α : Type*} [Fintype α] [DecidableEq α] {β : Type*} {k : ℕ} [NeZero k]

def score (A : Finset α) (c : α → Fin k) := (k:ℝ)^A.card*indicator A c

private lemma mean (A : Finset α) : (𝔼 c : α → Fin k, score A c)=1 := by
  simp only [score,←Finset.mul_expect,mean_indicator]
  have kp : 0<(k:ℝ) := by exact_mod_cast NeZero.pos k
  field_simp

lemma covariance (A B : Finset α) :
    (𝔼 c : α → Fin k, (score A c-1)*(score B c-1))=(k:ℝ)^(A∩B).card-1 := by
  have mul (c : α → Fin k) : indicator A c*indicator B c=indicator (A∪B) c := by
    by_cases a : A⊆anchors c <;> by_cases b : B⊆anchors c <;> simp [indicator,Finset.union_subset_iff,a,b]
  have exp (c : α → Fin k) : (score A c-1)*(score B c-1)=
      (k:ℝ)^(A.card+B.card)*indicator (A∪B) c-score A c-score B c+1 := by
    rw [←mul,pow_add]; unfold score; ring
  simp_rw [exp]
  rw [Finset.expect_add_distrib,Finset.expect_sub_distrib,Finset.expect_sub_distrib,←Finset.mul_expect,
    mean,mean,Fintype.expect_const,mean_indicator,←Finset.card_union_add_card_inter A B,pow_add]
  have kp : 0<(k:ℝ) := by exact_mod_cast NeZero.pos k
  field_simp; ring

def successes (H : Finset β) (Q : β → Finset α) (c : α → Fin k) := (H.filter (fun i => Q i⊆anchors c)).card

/-- Small nonempty overlaps cost at most `k⁴`, and the rarer large overlaps
cost at most `k⁸`. Either bound may also count the diagonal. -/
theorem miss {H : Finset β} (Q : β → Finset α) {d e : ℕ} (size : ∀i∈H,(Q i).card ≤ 8)
    (touch : ∀i∈H,(H.filter (fun j => 0<(Q i∩Q j).card)).card ≤ d)
    (large : ∀i∈H,(H.filter (fun j => 4<(Q i∩Q j).card)).card ≤ e) (enough : 2*k^8 ≤ H.card) :
    (𝔼 c : α → Fin k, if successes H Q c<2 then (1:ℝ) else 0) ≤ 4*(d*(k:ℝ)^4+e*(k:ℝ)^8)/H.card := by
  classical
  have kp : 1 ≤ (k:ℝ) := by exact_mod_cast NeZero.pos k
  have hp : 0<(H.card:ℝ) := by exact_mod_cast (lt_of_lt_of_le (by have := NeZero.pos k; positivity : 0<2*k^8) enough)
  let total (c : α → Fin k) := ∑i∈H,score (Q i) c
  have expand (c : α → Fin k) : (total c-H.card)^2=∑i∈H,∑j∈H,(score (Q i) c-1)*(score (Q j) c-1) := by
    rw [←Finset.sum_mul_sum,Finset.sum_sub_distrib]; simp [total,pow_two]
  have variance : (𝔼 c : α → Fin k, (total c-H.card)^2) ≤ H.card*(d*(k:ℝ)^4+e*(k:ℝ)^8) := by
    simp_rw [expand,Finset.expect_sum_comm,covariance]
    have each (i) (hi : i∈H) : (∑j∈H,((k:ℝ)^(Q i∩Q j).card-1)) ≤ d*(k:ℝ)^4+e*(k:ℝ)^8 := by
      let r (j : β) := (Q i∩Q j).card
      have one (j) (hj : j∈H) : (k:ℝ)^(r j)-1  ≤ 
          (if 0<r j then (k:ℝ)^4 else 0)+(if 4<r j then (k:ℝ)^8 else 0) := by
        have bound : r j ≤ 8 := (Finset.card_le_card Finset.inter_subset_left).trans (size i hi)
        by_cases first : 0<r j
        · by_cases second : 4<r j
          · simp only [if_pos first,if_pos second]
            have small := pow_le_pow_right₀ kp bound
            linarith only [small,show 0 ≤ (k:ℝ)^4 by positivity]
          · simp only [if_pos first,if_neg second,add_zero]
            linarith only [pow_le_pow_right₀ kp (le_of_not_gt second)]
        · have zero : r j=0 := by omega
          simp [zero]
      have tot := Finset.sum_le_sum one
      rw [Finset.sum_add_distrib,←Finset.sum_filter,←Finset.sum_filter] at tot
      simp only [Finset.sum_const,nsmul_eq_mul] at tot
      apply tot.trans
      exact add_le_add (mul_le_mul_of_nonneg_right (by exact_mod_cast touch i hi) (by positivity))
        (mul_le_mul_of_nonneg_right (by exact_mod_cast large i hi) (by positivity))
    exact (Finset.sum_le_sum each).trans_eq (by simp [mul_add])
  have maxHit (c : α → Fin k) : total c ≤ (successes H Q c:ℝ)*k^8 := by
    have per (i) (hi : i∈H) : score (Q i) c ≤ if Q i⊆anchors c then (k:ℝ)^8 else 0 := by
      by_cases h : Q i⊆anchors c
      · simpa [score,indicator,h] using pow_le_pow_right₀ kp (size i hi)
      · simp [score,indicator,h]
    exact (Finset.sum_le_sum per).trans_eq (by rw [←Finset.sum_filter]; simp [successes])
  have per (c : α → Fin k) : (if successes H Q c<2 then (1:ℝ) else 0)*(H.card:ℝ)^2 ≤ 4*(total c-H.card)^2 := by
    split_ifs with h
    · have hits : (successes H Q c:ℝ) ≤ 1 := by exact_mod_cast (show successes H Q c ≤ 1 by omega)
      have bound := (maxHit c).trans (mul_le_mul_of_nonneg_right hits (show 0 ≤ (k:ℝ)^8 by positivity))
      have twice : 2*(k:ℝ)^8 ≤ H.card := by exact_mod_cast enough
      have diff : (H.card:ℝ) ≤ 2*((H.card:ℝ)-total c) := by linarith
      have sq := sq_le_sq' (by linarith only [diff,hp] : -(2*((H.card:ℝ)-total c)) ≤ H.card) diff
      nlinarith only [sq]
    · simp; positivity
  have inequality := Finset.expect_le_expect (s:=Finset.univ) (fun c _ => per c)
  rw [←Finset.expect_mul,←Finset.mul_expect] at inequality
  apply (le_div_iff₀ hp).mpr
  apply le_of_mul_le_mul_right (a:=(H.card:ℝ)) _ hp
  nlinarith only [inequality,mul_le_mul_of_nonneg_left variance (by norm_num : (0:ℝ) ≤ 4)]

end Erdos101OverlapSampling

/- Among the anchor supports of different lines through one point, small
overlaps have linear multiplicity and overlaps of five have bounded multiplicity. -/
noncomputable section
namespace Erdos101OverlapSupports
open EuclideanGeometry Finset Erdos101AnchorGeometry Erdos101AnchorJoins Erdos101AnchorField
open Erdos101AnchorCore Erdos101AnchorGeneric Erdos101DepthSupports
open scoped Classical

def shadow (T F : Finset ℝ²) := F.biUnion (fan T F)

private lemma in_fan {T B : Finset ℝ²} {a b q : ℝ²} (qt : q∈T) (bb : b∈B) (h : q∈line[ℝ,a,b]) :
    q∈fan T B a := Finset.mem_biUnion.mpr ⟨b,bb,Finset.mem_filter.mpr ⟨qt,h⟩⟩

private lemma two_named {T B : Finset ℝ²} {F : Finset B} {a b : B} {q : ℝ²}
    (qt : q∈T) (ha : a∈F) (hb : b∈F) (h : q∈line[ℝ,a.val,b.val]) : q∈shadow T (names F) :=
  Finset.mem_biUnion.mpr ⟨a.val,Finset.mem_image_of_mem Subtype.val ha,in_fan qt (Finset.mem_image_of_mem Subtype.val hb) h⟩

private lemma few_pair {B : Finset ℝ²} (a b : B) (F : Finset B) (miss : ¬(a∈F ∧ b∈F)) :
    (({a,b}:Finset B)∩F).card ≤ 1 := by
  apply Finset.card_le_one.mpr
  intro x hx y hy
  simp only [Finset.mem_inter,Finset.mem_insert,Finset.mem_singleton] at hx hy
  rcases hx with ⟨rfl|rfl,hx⟩ <;> rcases hy with ⟨rfl|rfl,hy⟩ <;> tauto

private lemma point_support {T B : Finset ℝ²} {q : ℝ²} (qt : q∈T) (gen : q∈B ∨ determinedBy B q) :
    ∃Q : Finset B,Q.card ≤ 4 ∧ q∈levels (names Q) 1 ∧ (∀a∈Q,q∈fan T B a.val) ∧
      ∀F : Finset B,2 < (Q∩F).card → q∈shadow T (names F) := by
  rcases gen with qb|⟨a,ha,b,hb,c,hc,d,hd,ab,cd,ne,one,two⟩
  · let q' : B := ⟨q,qb⟩
    refine ⟨{q'},by simp,Or.inl (Finset.mem_image_of_mem Subtype.val (Finset.mem_singleton_self q')),?_,?_⟩
    · intro a ha; obtain rfl := Finset.mem_singleton.mp ha; exact in_fan qt qb (left_mem_affineSpan_pair ..)
    · intro F many
      have small := Finset.card_le_card (Finset.inter_subset_left (s₁:={q'}) (s₂:=F)); simp only [Finset.card_singleton] at small; omega
  · let a' : B := ⟨a,ha⟩
    let b' : B := ⟨b,hb⟩
    let c' : B := ⟨c,hc⟩
    let d' : B := ⟨d,hd⟩
    let A : Finset B := {a',b'}
    let D : Finset B := {c',d'}
    let Q := A∪D
    have lift (t : B) (h : t∈Q) : t.val∈levels (names Q) 0 := Finset.mem_image_of_mem Subtype.val h
    have oct : Q.card ≤ 4 := by
      have x : A.card ≤ 2 := Finset.card_le_two
      have y : D.card ≤ 2 := Finset.card_le_two
      exact (Finset.card_union_le ..).trans (by omega)
    refine ⟨Q,oct,Or.inr ⟨a,lift a' (by simp [Q,A]),b,lift b' (by simp [Q,A]),c,lift c' (by simp [Q,D]),
      d,lift d' (by simp [Q,D]),ab,cd,ne,one,two⟩,?_,?_⟩
    · intro t ht
      simp only [Q,A,D,Finset.mem_union,Finset.mem_insert,Finset.mem_singleton] at ht
      rcases ht with (rfl|rfl)|(rfl|rfl)
      · exact in_fan qt hb one
      · exact in_fan qt ha (by rwa [Set.pair_comm])
      · exact in_fan qt hd two
      · exact in_fan qt hc (by rwa [Set.pair_comm])
    · intro F many
      by_cases left : a'∈F ∧ b'∈F
      · exact two_named qt left.1 left.2 one
      by_cases right : c'∈F ∧ d'∈F
      · exact two_named qt right.1 right.2 two
      have less : (Q∩F).card ≤ (A∩F).card+(D∩F).card := by rw [show Q=A∪D from rfl,Finset.union_inter_distrib_right]; exact Finset.card_union_le ..
      have u := few_pair a' b' F left; have v := few_pair c' d' F right
      change (A∩F).card ≤ 1 at u; change (D∩F).card ≤ 1 at v; omega

private lemma line_support {T B : Finset ℝ²} (gen : ∀q∈T,q∈B ∨ determinedBy B q)
    {p : ℝ²} (pt : p∈T) {L : Erdos101AnchorGeometry.Line} (rich : L∈fourFamily T) (pl : p∈L) :
    ∃ Q : Finset B, Q.card ≤ 8 ∧ lineFrom (names Q) L ∧
      (∀a∈Q,∃q∈fan T B a.val,q≠p ∧ q∈L) ∧
      ∀F : Finset B,4<(Q∩F).card → ∃q∈shadow T (names F),q≠p ∧ q∈L := by
  obtain ⟨proper,size⟩ := Finset.mem_filter.mp rich
  have enough : 1<((incident T L).erase p).card := by
    rw [Finset.card_erase_of_mem (s:=incident T L) (Finset.mem_filter.mpr ⟨pt,pl⟩)]; change 1 < mult T L-1; omega
  obtain ⟨u,hu,v,hv,uv⟩ := Finset.one_lt_card.mp enough
  obtain ⟨up,iu⟩ := Finset.mem_erase.mp hu; obtain ⟨vp,iv⟩ := Finset.mem_erase.mp hv
  obtain ⟨ut,ul⟩ := Finset.mem_filter.mp iu; obtain ⟨vt,vl⟩ := Finset.mem_filter.mp iv
  obtain ⟨A,ac,ar,aw,ah⟩ := point_support ut (gen u ut)
  obtain ⟨D,dc,dr,dw,dh⟩ := point_support vt (gen v vt)
  refine ⟨A∪D,(Finset.card_union_le ..).trans (by omega),⟨u,levels_mono (Finset.image_mono Subtype.val Finset.subset_union_left) 1 ar,
    v,levels_mono (Finset.image_mono Subtype.val Finset.subset_union_right) 1 dr,uv,unique_line proper ul vl uv⟩,?_,?_⟩
  · intro a ha; rcases Finset.mem_union.mp ha with h|h
    · exact ⟨u,aw a h,up,ul⟩
    · exact ⟨v,dw a h,vp,vl⟩
  · intro F many
    by_cases big : 2<(A∩F).card
    · exact ⟨u,ah F big,up,ul⟩
    have le : ((A∪D)∩F).card ≤ (A∩F).card+(D∩F).card := by rw [Finset.union_inter_distrib_right]; exact Finset.card_union_le ..
    exact ⟨v,dh F (by omega),vp,vl⟩

open Erdos101OverlapSampling Erdos101AnchorSampling

/-- For the supports of lines through a fixed point, at most `32b` supports
overlap a specified one, and at most 256 share five or more anchors with it. -/
theorem family {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) {A : Finset Line} (four : A⊆fourFamily T) {p : ℝ²} (pt : p∈T) :
    let H := star A p
    ∃Q : H → Finset B,(∀i,(Q i).card ≤ 8) ∧
      (∀i,(Finset.univ.filter (fun j => 0<(Q i∩Q j).card)).card ≤ 32*B.card) ∧
      (∀i,(Finset.univ.filter (fun j => 4<(Q i∩Q j).card)).card ≤ 256) ∧
      ∀{k : ℕ} [NeZero k] (c : B → Fin k),2 ≤ successes Finset.univ Q c → p∈levels (sample c) 2 := by
  classical
  let H := star A p
  have data (L : H) := line_support gen pt (four (Finset.mem_filter.mp L.property).1) (Finset.mem_filter.mp L.property).2
  choose Q sz join touch heavy using data
  have determined' (L : H) : L.val∈determined T := (Finset.mem_filter.mp (four (Finset.mem_filter.mp L.property).1)).1
  have pl (L : H) : p∈L.val := (Finset.mem_filter.mp L.property).2
  have cover (F : Finset H) (D : Finset ℝ²) (on : ∀L∈F,∃q∈D,q≠p ∧ q∈L.val) : F.card ≤ D.card := by
    have sub : F.image Subtype.val ⊆ D.image (fun q => line[ℝ,p,q]) := by
      intro L hl; obtain ⟨i,hi,rfl⟩ := Finset.mem_image.mp hl
      obtain ⟨q,qd,qp,ql⟩ := on i hi
      exact Finset.mem_image.mpr ⟨q,qd,unique_line (determined' i) (pl i) ql qp.symm⟩
    simpa only [Finset.card_image_of_injective _ Subtype.val_injective] using (Finset.card_le_card sub).trans Finset.card_image_le
  refine ⟨Q,sz,?_,?_,?_⟩
  · intro i
    let D := (Q i).biUnion (fun a => fan T B a.val)
    have count : D.card ≤ 32*B.card := calc
      _ ≤ ∑a∈Q i,(fan T B a.val).card := Finset.card_biUnion_le
      _ ≤ ∑_∈Q i,B.card*4 := Finset.sum_le_sum (fun a _ => fan_card cap a.val)
      _ = (Q i).card*(B.card*4) := by simp
      _ ≤ 8*(B.card*4) := Nat.mul_le_mul_right _ (sz i)
      _ = 32*B.card := by ring
    apply (cover _ D _).trans count
    intro j hj
    obtain ⟨a,ha⟩ := Finset.card_pos.mp (Finset.mem_filter.mp hj).2
    obtain ⟨ai,aj⟩ := Finset.mem_inter.mp ha
    obtain ⟨q,qf,qp,ql⟩ := touch j a aj
    exact ⟨q,Finset.mem_biUnion.mpr ⟨a,ai,qf⟩,qp,ql⟩
  · intro i
    let D := shadow T (names (Q i))
    have n : (names (Q i)).card ≤ 8 := (names_card _).trans_le (sz i)
    have count : D.card ≤ 256 := calc
      _ ≤ ∑a∈names (Q i),(fan T (names (Q i)) a).card := Finset.card_biUnion_le
      _ ≤ ∑_∈names (Q i),(names (Q i)).card*4 := Finset.sum_le_sum (fun a _ => fan_card cap a)
      _ = (names (Q i)).card*((names (Q i)).card*4) := by simp
      _ ≤ 8*(8*4) := Nat.mul_le_mul n (Nat.mul_le_mul_right _ n)
      _ = 256 := rfl
    exact (cover _ D (fun j hj => heavy j (Q i) (by simpa only [Finset.inter_comm (Q j)] using (Finset.mem_filter.mp hj).2))).trans count
  · intro k _ c many
    obtain ⟨u,hu,v,hv,uv⟩ := Finset.one_lt_card.mp many
    obtain ⟨a,ha,b,hb,ab,e⟩ := join u
    obtain ⟨d,hd,g,hg,dg,f⟩ := join v
    have first : names (Q u)⊆sample c := Finset.image_mono Subtype.val (Finset.mem_filter.mp hu).2
    have second : names (Q v)⊆sample c := Finset.image_mono Subtype.val (Finset.mem_filter.mp hv).2
    refine Or.inr ⟨a,levels_mono first 1 ha,b,levels_mono first 1 hb,d,levels_mono second 1 hd,
      g,levels_mono second 1 hg,ab,dg,?_,?_,?_⟩
    · rw [e,f]; exact fun eq => uv (Subtype.ext eq)
    · rw [e]; exact pl u
    · rw [f]; exact pl v

end Erdos101OverlapSupports

/- A single sample of the original anchors recovers almost all high-degree
points in two straightedge rounds. -/
noncomputable section
namespace Erdos101OverlapSample
open Erdos101AnchorGeometry Erdos101AnchorSampling Erdos101OverlapSampling Erdos101AnchorJoins
open Erdos101AnchorField Erdos101AnchorGeneric Erdos101AnchorCore Erdos101OverlapSupports Erdos101DepthSample
open EuclideanGeometry Finset
open scoped BigOperators Classical


private theorem mean {T B U : Finset ℝ²} {A : Finset Line} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) (four : A⊆fourFamily T) (sub : U⊆T)
    {k m : ℕ} [NeZero k] (thresh : 2*k^8 ≤ m) (balanced : k^4 ≤ B.card)
    (rich : ∀p∈U,m ≤ (star A p).card) :
    (𝔼 c : B → Fin k, ((missedTwo U (sample c)).card:ℝ)) ≤ U.card*((2048*(B.card:ℝ)*(k:ℝ)^4)/m) := by
  classical
  have point (p : U) : (𝔼 c : B → Fin k, if p.val∉levels (sample c) 2 then (1:ℝ) else 0) ≤ (2048*(B.card:ℝ)*(k:ℝ)^4)/m := by
    let H := star A p.val
    obtain ⟨Q,sz,touch,heavy,recover⟩ := Erdos101OverlapSupports.family cap gen four (sub p.property)
    have deg : m ≤ H.card := rich p.val p.property
    have kp : 0<(k:ℝ) := by exact_mod_cast NeZero.pos k
    have mp : 0 < (m:ℝ) := by exact_mod_cast (lt_of_lt_of_le (by have := NeZero.pos k; positivity : 0<2*k^8) thresh)
    have per (c : B → Fin k) : (if p.val∉levels (sample c) 2 then (1:ℝ) else 0)  ≤ 
        if successes Finset.univ Q c<2 then (1:ℝ) else 0 := by
      by_cases small : successes Finset.univ Q c<2
      · rw [if_pos small]; split_ifs <;> norm_num
      · rw [if_neg small,if_neg (fun h => h (recover c (le_of_not_gt small)))]
    apply (Finset.expect_le_expect (fun c _ => per c)).trans
    have enough : 2*k^8 ≤ (Finset.univ : Finset H).card := by simpa using thresh.trans deg
    have val := Erdos101OverlapSampling.miss Q (fun i _ => sz i) (fun i _ => touch i) (fun i _ => heavy i) enough
    simp only [Finset.card_univ,Fintype.card_coe,Nat.cast_mul,Nat.cast_ofNat] at val
    apply val.trans
    have b : (k:ℝ)^4 ≤ B.card := by exact_mod_cast balanced
    have e8 : (k:ℝ)^8 ≤ B.card*k^4 := by
      calc (k:ℝ)^8 = k^4*k^4 := by ring
           _ ≤ _ := mul_le_mul_of_nonneg_right b (by positivity)
    apply (div_le_div_of_nonneg_left (by positivity) mp (by exact_mod_cast deg)).trans
    apply div_le_div_of_nonneg_right _ mp.le
    nlinarith only [e8,mul_nonneg (Nat.cast_nonneg B.card) (show 0 ≤ (k:ℝ)^4 by positivity)]
  have num (c : B → Fin k) : ((missedTwo U (sample c)).card:ℝ)=∑p : U,if p.val∉levels (sample c) 2 then (1:ℝ) else 0 := by
    rw [Finset.sum_boole]
    change _=((U.attach.filter (fun p : U => p.val∉levels (sample c) 2)).card:ℝ)
    rw [Finset.filter_attach (fun p : ℝ² => p∉levels (sample c) 2) U]
    simp [missedTwo]
  simp_rw [num,Finset.expect_sum_comm]
  exact (Finset.sum_le_sum (fun p _ => point p)).trans_eq (by simp)

theorem choose_seed {T B U : Finset ℝ²} {A : Finset Line} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) (four : A⊆fourFamily T) (sub : U⊆T)
    {k m : ℕ} [NeZero k] (thresh : 2*k^8 ≤ m) (balanced : k^4 ≤ B.card)
    (rich : ∀p∈U,m ≤ (star A p).card) :
    ∃R⊆B,k*R.card ≤ 2*B.card ∧ m*(missedTwo U R).card ≤ 4096*B.card*k^4*U.card := by
  classical
  by_cases posU : U.card=0
  · have uz := Finset.card_eq_zero.mp posU
    exact ⟨∅,Finset.empty_subset _,by simp,by simp [uz,missedTwo]⟩
  let t := (m:ℝ)/(2048*(B.card:ℝ)*(k:ℝ)^4)
  have kp : 0<(k:ℝ) := by exact_mod_cast NeZero.pos k
  have mp : 0 < (m:ℝ) := by exact_mod_cast (lt_of_lt_of_le (by have := NeZero.pos k; positivity : 0<2*k^8) thresh)
  have up : 0<(U.card:ℝ) := by exact_mod_cast Nat.pos_of_ne_zero posU
  have bp : 0<(B.card:ℝ) := by exact_mod_cast (lt_of_lt_of_le (Nat.pow_pos (NeZero.pos k) (n:=4)) balanced)
  have tp : 0<t := by dsimp [t]; positivity
  have mu := mean cap gen four sub thresh balanced rich (k:=k)
  have sc := mul_le_mul_of_nonneg_left mu tp.le
  have cancel : t*(U.card*((2048*(B.card:ℝ)*(k:ℝ)^4)/m))=U.card := by dsimp [t]; field_simp
  rw [cancel] at sc
  have total : (𝔼 c : B → Fin k, ((U.card:ℝ)*(k:ℝ)*(anchors c).card+(B.card:ℝ)*t*(missedTwo U (sample c)).card)) ≤ 2*(U.card:ℝ)*B.card := by
    rw [Finset.expect_add_distrib,←Finset.mul_expect,←Finset.mul_expect,mean_anchors]
    simp only [Fintype.card_coe]
    have v : (U.card:ℝ)*k*(B.card/k)=U.card*B.card := by field_simp
    rw [v,mul_assoc (B.card:ℝ)]
    nlinarith only [mul_le_mul_of_nonneg_left sc bp.le]
  obtain ⟨c,_,hc⟩ := Finset.exists_le_of_expect_le Finset.univ_nonempty total
  refine ⟨sample c,sample_sub c,?_,?_⟩
  · rw [sample_card]
    have le : (U.card:ℝ)*((k:ℝ)*(anchors c).card) ≤ (U.card:ℝ)*(2*B.card) := by
      nlinarith only [hc,mul_nonneg (mul_nonneg bp.le tp.le) (Nat.cast_nonneg (missedTwo U (sample c)).card)]
    exact_mod_cast (le_of_mul_le_mul_left le up)
  · have le : (B.card:ℝ)*(t*(missedTwo U (sample c)).card) ≤ (B.card:ℝ)*(2*U.card) := by
      nlinarith only [hc,mul_nonneg (mul_nonneg up.le kp.le) (Nat.cast_nonneg (anchors c).card)]
    have v := mul_le_mul_of_nonneg_left (le_of_mul_le_mul_left le bp) (show 0 ≤ 2048*(B.card:ℝ)*(k:ℝ)^4 by positivity)
    have eq : (2048*(B.card:ℝ)*(k:ℝ)^4)*(t*(missedTwo U (sample c)).card)=m*(missedTwo U (sample c)).card := by dsimp [t]; field_simp
    rw [eq] at v
    exact_mod_cast (by linarith only [v] : (m:ℝ)*(missedTwo U (sample c)).card ≤ 4096*(B.card:ℝ)*(k:ℝ)^4*U.card)

end Erdos101OverlapSample

/- Thin a one-round anchor set while keeping a positive fraction of the
original four-point lines after a second intersection round. -/
noncomputable section
namespace Erdos101OverlapCompression
open Erdos101AnchorGeometry Erdos101AnchorJoins Erdos101AnchorCore Erdos101AnchorField
open Erdos101AnchorGeneric Erdos101DepthSample EuclideanGeometry Finset
open scoped Classical

theorem compress {T B : Finset ℝ²} (cap : NonCollinearFor 5 (T : Set ℝ²))
    (gen : ∀q∈T,q∈B ∨ determinedBy B q) (bp : 0<B.card) (s k : ℕ) (sp : 0 < s) (kp : 0<k)
    (large : 32768*s^2*B.card*k^4 ≤ T.card) (dense : T.card^2 ≤ s*(fourFamily T).card) :
    ∃ R⊆B, k*R.card ≤ 2*B.card ∧ ∃G⊆fourFamily T,(fourFamily T).card ≤ 4*G.card ∧
      ∀L∈G,∀p∈T,p∈L → p∈levels R 2 := by
  classical
  let A := fourFamily T
  let d := 16384*s*B.card*k^4
  have capacity' : T.card ≤ B.card*(5*B.card) := (capacity cap gen).trans (by
    have sq : B.card ≤ B.card*B.card := Nat.le_mul_of_pos_right _ bp
    nlinarith only [sq])
  have factor : 32768*s^2*k^4 ≤ 5*B.card := Nat.le_of_mul_le_mul_left (c:=B.card) (by
    calc B.card*(32768*s^2*k^4) = 32768*s^2*B.card*k^4 := by ring
         _ ≤ _ := large.trans capacity') bp
  have balanced : k^4 ≤ B.card := by
    apply Nat.le_of_mul_le_mul_left (c:=5) _ (by decide)
    exact (Nat.mul_le_mul_right _ (show 5≤32768*s^2 by have := Nat.pow_pos sp (n:=2); omega)).trans factor
  have thresh : 2*k^8 ≤ d := by
    calc 2*k^8 = 2*(k^4*k^4) := by ring
         _ ≤ 2*(B.card*k^4) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ balanced)
         _ ≤ (16384*s)*(B.card*k^4) := Nat.mul_le_mul_right _ (by omega)
         _ = d := by dsimp [d]; ring
  have small : 2*d*s ≤ T.card := by
    calc 2*d*s = 32768*s^2*B.card*k^4 := by dsimp [d]; ring
         _ ≤ _ := large
  have full (L) (h : L∈A) : mult T L=4 := (Finset.mem_filter.mp h).2
  obtain ⟨U,us,F,fa,rich,keep,minD⟩ := peel T A 4 d (fun L h => (full L h).ge)
  let _ : NeZero k := ⟨kp.ne'⟩
  obtain ⟨R,rb,cheap,miss⟩ := Erdos101OverlapSample.choose_seed cap gen fa us thresh balanced minD
  let E := missedTwo U R
  have uc := Finset.card_le_card us
  have few : 4*s*E.card ≤ T.card := by
    apply Nat.le_of_mul_le_mul_left (c:=4096*B.card*k^4) _ (by positivity)
    calc 4096*B.card*k^4*(4*s*E.card) = d*E.card := by dsimp [d]; ring
         _ ≤ 4096*B.card*k^4*U.card := miss
         _ ≤ _ := Nat.mul_le_mul_left _ uc
  have half : A.card ≤ 2*F.card := by
    have pay : 2*d*T.card ≤ A.card := by
      apply Nat.le_of_mul_le_mul_left (c:=s) _ sp
      calc s*(2*d*T.card) = (2*d*s)*T.card := by ring
           _ ≤ T.card*T.card := Nat.mul_le_mul_right _ small
           _ ≤ s*A.card := by simpa only [pow_two] using dense
    have cost := Nat.mul_le_mul_left d (Nat.sub_le T.card U.card)
    have dec : 2*d*T.card=2*(d*T.card) := by ring
    omega
  let bad := E.biUnion (star F)
  let G := F\bad
  have badsize : bad.card ≤ E.card*T.card := by
    apply Finset.card_biUnion_le.trans
    apply (Finset.sum_le_sum (g:=fun _ => T.card) _).trans_eq (by simp)
    intro p hp
    have sub : star F p⊆star (fourFamily T) p := Finset.filter_subset_filter _ fa
    exact (Finset.card_le_card sub).trans (pencil_size (us (Finset.mem_filter.mp hp).1))
  have quarter : 4*bad.card ≤ A.card := by
    apply Nat.le_of_mul_le_mul_left (c:=s) _ sp
    calc s*(4*bad.card) ≤ s*(4*(E.card*T.card)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ badsize)
         _ = (4*s*E.card)*T.card := by ring
         _ ≤ T.card*T.card := Nat.mul_le_mul_right _ few
         _ ≤ _ := by simpa only [pow_two] using dense
  have bf : bad⊆F := fun L h => by obtain ⟨p,_,hl⟩ := Finset.mem_biUnion.mp h; exact (Finset.mem_filter.mp hl).1
  have eq : G.card+bad.card=F.card := Finset.card_sdiff_add_card_eq_card bf
  refine ⟨R,rb,cheap,G,Finset.sdiff_subset.trans fa,by change A.card ≤ 4*G.card; omega,?_⟩
  intro L hl p pt pl
  obtain ⟨lf,off⟩ := Finset.mem_sdiff.mp hl
  have eqI : incident U L=incident T L := Finset.eq_of_subset_of_card_le (incident_mono us L)
    (by change mult T L ≤ mult U L; rw [full _ (fa lf)]; exact rich L lf)
  have pu : p∈U := (Finset.mem_filter.mp (show p∈incident U L by rw [eqI]; exact Finset.mem_filter.mpr ⟨pt,pl⟩)).1
  by_contra no
  exact off (Finset.mem_biUnion.mpr ⟨p,Finset.mem_filter.mpr ⟨pu,no⟩,Finset.mem_filter.mpr ⟨lf,pl⟩⟩)

end Erdos101OverlapCompression

/- Two intersection rounds reduce the exponent for the number of anchors
from one half to three eighths in every sufficiently large dense witness. -/
noncomputable section
namespace Erdos101OverlapExponent
open Erdos101AnchorGeometry Erdos101AnchorField Erdos101AnchorCore Erdos101AnchorGeneric
open Erdos101DepthExponent EuclideanGeometry Finset Filter Asymptotics
open scoped Classical

def cost (s C : ℕ) := (16*(32768*s^2))^2*2^8*C^5

private lemma saving (s C b n r k : ℕ) (positive : 0<n) (small : b^2 ≤ C*n)
    (cheap : k*r ≤ 2*b) (scale : n ≤ 32768*s^2*b*(2*k)^4) : r^8 ≤ cost s C*n^3 := by
  let d := 32768*s^2
  apply Nat.le_of_mul_le_mul_left (c:=n^2) _ (by positivity)
  calc
    n^2*r^8 ≤ (d*b*(2*k)^4)^2*r^8 := Nat.mul_le_mul_right _ (Nat.pow_le_pow_left scale 2)
    _ = (16*d)^2*b^2*(k*r)^8 := by ring
    _ ≤ (16*d)^2*b^2*(2*b)^8 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left cheap 8)
    _ = (16*d)^2*2^8*(b^2)^5 := by ring
    _ ≤ (16*d)^2*2^8*(C*n)^5 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left small 5)
    _ = n^2*(cost s C*n^3) := by dsimp [cost,d]; ring

/-- Extract a dense subset with all of its points generated by two
intersection rounds. The anchor bound is relative to the extracted set. -/
theorem extract (s C : ℕ) (sp : 0<s) {T B : Finset ℝ²}
    (large : (32768*s^2)^2*C ≤ T.card) (positive : 0<T.card)
    (cap : NonCollinearFor 5 (T : Set ℝ²)) (bt : B⊆T) (small : B.card^2 ≤ C*T.card)
    (gen : ∀p∈T,p∈B ∨ determinedBy B p) (dense : T.card^2 ≤ s*(fourFamily T).card) :
    ∃V⊆T, ∃R⊆V, (∀p∈V,p∈levels R 2) ∧ T.card ≤ 4*s*V.card ∧
      R.card^8 ≤ (cost s C*(4*s)^3)*V.card^3 ∧ T.card^2 ≤ 4*s*(fourFamily V).card := by
  have bp : 0<B.card := by
    have fromCap := capacity cap gen
    by_contra! zero
    have z : B.card=0 := by omega
    exact positive.not_ge (by simpa only [z,zero_pow (by decide : 2≠0),mul_zero,add_zero] using fromCap)
  have scale : 32768*s^2*B.card ≤ T.card := by
    apply (Nat.pow_le_pow_iff_left (by decide : 2≠0)).mp
    calc (32768*s^2*B.card)^2=(32768*s^2)^2*B.card^2 := mul_pow ..
         _ ≤ (32768*s^2)^2*(C*T.card) := Nat.mul_le_mul_left _ small
         _ = ((32768*s^2)^2*C)*T.card := by ring
         _ ≤ T.card*T.card := Nat.mul_le_mul_right _ large
         _ = _ := (pow_two _).symm
  obtain ⟨k,kp,lo,hi⟩ := choose_scale (32768*s^2*B.card) T.card 4 (by positivity) (by decide) scale
  obtain ⟨R,rb,cheap,G,ga,keep,recover⟩ := Erdos101OverlapCompression.compress cap gen bp s k sp kp lo dense
  let V := R ∪ T.filter (fun p => p∈levels R 2)
  have vs : V⊆T := Finset.union_subset (rb.trans bt) (Finset.filter_subset ..)
  have hits : G⊆fourFamily V := by
    intro L hl
    obtain ⟨proper,size⟩ := Finset.mem_filter.mp (ga hl)
    have eq : incident V L=incident T L := by
      apply Finset.Subset.antisymm (incident_mono vs L)
      intro p hp; obtain ⟨pt,pl⟩ := Finset.mem_filter.mp hp
      exact Finset.mem_filter.mpr ⟨Finset.mem_union_right R (Finset.mem_filter.mpr ⟨pt,recover L hl p pt pl⟩),pl⟩
    have four : mult V L=4 := (congrArg Finset.card eq).trans size
    exact Finset.mem_filter.mpr ⟨determined_of_two proper (by omega),four⟩
  have remain : T.card^2 ≤ 4*s*(fourFamily V).card := calc
    _ ≤ s*(fourFamily T).card := dense
    _ ≤ s*(4*G.card) := Nat.mul_le_mul_left _ keep
    _ ≤ s*(4*(fourFamily V).card) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Finset.card_le_card hits))
    _ = _ := by ring
  have size : T.card ≤ 4*s*V.card := by
    apply Nat.le_of_mul_le_mul_right _ positive
    rw [←pow_two]
    calc _ ≤ 4*s*(fourFamily V).card := remain
         _ ≤ 4*s*V.card^2 := Nat.mul_le_mul_left _ (fourFamily_le_square _)
         _ = 4*s*V.card*V.card := by ring
         _ ≤ _ := Nat.mul_le_mul_left _ (Finset.card_le_card vs)
  refine ⟨V,vs,R,Finset.subset_union_left,?_,size,?_,remain⟩
  · intro p hp
    rcases Finset.mem_union.mp hp with h|h
    · exact initial_level h 2
    · exact (Finset.mem_filter.mp h).2
  · exact (saving s C _ _ _ _ positive small cheap hi).trans
      ((Nat.mul_le_mul_left _ (Nat.pow_le_pow_left size 3)).trans_eq (by ring))

/-- It suffices to rule out positive density on sets generated in two rounds
by `O(n^(3/8))` of their points. -/
def gap : Prop := ∀s C : ℕ,0<s → ∃N : ℕ,∀T R : Finset ℝ²,N ≤ T.card →
  NonCollinearFor 5 (T : Set ℝ²) → R⊆T → R.card^8 ≤ C*T.card^3 → (∀p∈T,p∈levels R 2) →
  s*(fourFamily T).card<T.card^2

theorem gap_iff : (type_of% @Erdos101.erdos_101) ↔ gap := by
  constructor
  · intro full s C sp
    obtain ⟨N,bound⟩ := eventually_atTop.mp (isLittleO_iff_nat_mul_le.mp full (2*s))
    refine ⟨max N 1,?_⟩
    intro T R large cap _ _ _
    have num := bound T.card ((le_max_left ..).trans large)
    change ((2*s : ℕ) : ℝ)*‖(Erdos101.numLinesWithFourPointMax T.card : ℝ)‖ ≤ ‖(T.card:ℝ)^2‖ at num
    rw [Real.norm_of_nonneg (Nat.cast_nonneg _),Real.norm_of_nonneg (sq_nonneg _)] at num
    have h : (2*s)*Erdos101.numLinesWithFourPointMax T.card ≤ T.card^2 := by exact_mod_cast num
    have less := (Nat.mul_le_mul_left (2*s) (count_le_max T cap)).trans h
    rw [←fourFamily_eq] at less
    have pos : 0<T.card := (le_max_right ..).trans large
    by_contra! bad
    have z := Nat.mul_le_mul_left 2 bad
    rw [←Nat.mul_assoc] at z; nlinarith only [z,less,Nat.pow_pos pos (n:=2)]
  · intro test
    apply anchored_iff.mpr
    intro s C sp
    obtain ⟨N,check⟩ := test (4*s) (cost s C*(4*s)^3) (by positivity)
    refine ⟨max 1 (max ((32768*s^2)^2*C) (4*s*N)),?_⟩
    intro T B big cap bt cheap gen
    rw [←fourFamily_eq]
    by_contra! dense
    obtain ⟨V,vt,R,rv,recover,size,pay,keep⟩ := extract s C sp ((le_max_left ..).trans ((le_max_right ..).trans big))
      ((le_max_left ..).trans big) cap bt cheap gen dense
    have minSize : 4*s*N ≤ T.card := (le_max_right ..).trans ((le_max_right ..).trans big)
    have enough := Nat.le_of_mul_le_mul_left (minSize.trans size) (show 0<4*s by positivity)
    have vcap := NonCollinearFor.subset (Finset.coe_subset.mpr vt) cap
    exact (check V R enough vcap rv pay recover).not_ge ((Nat.pow_le_pow_left (Finset.card_le_card vt) 2).trans keep)

/-- Direct extraction from an unrestricted large set with positive density of
four-point lines. One may retain at least `n/(64s²)` points and density at
least `1/(16s)`, while the seed satisfies `r⁸ ≤ D(s) |V|³`. -/
theorem dense_witness (s : ℕ) (sp : 0 < s) : ∃N D : ℕ, ∀S : Finset ℝ²,N ≤ S.card →
    NonCollinearFor 5 (S : Set ℝ²) → S.card^2 ≤ s*(linesWithPointsFor 4 (S : Set ℝ²)).ncard →
    ∃V⊆S, ∃R⊆V, S.card ≤ 64*s^2*V.card ∧ R.card^8 ≤ D*V.card^3 ∧
      V.card^2 ≤ 16*s*(linesWithPointsFor 4 (V : Set ℝ²)).ncard ∧ ∀p∈V,p∈levels R 2 := by
  let C := 4096*s^3
  let cut := max 1 ((32768*(4*s)^2)^2*C)
  obtain ⟨N,first⟩ := anchored_witness s sp
  refine ⟨max N (4*s*cut),cost (4*s) C*(4*(4*s))^3,?_⟩
  intro S big cap dense
  obtain ⟨T,B,ts,bt,size,cheap,many,gen⟩ := first S ((le_max_left ..).trans big) cap dense
  have threshold := Nat.le_of_mul_le_mul_left (((le_max_right ..).trans big).trans size) (show 0<4*s by positivity)
  change cut ≤ T.card at threshold
  have tcap := NonCollinearFor.subset (Finset.coe_subset.mpr ts) cap
  rw [←fourFamily_eq] at many
  obtain ⟨V,vt,R,rv,all,ratio,small,keep⟩ := extract (4*s) C (by positivity)
    ((le_max_right ..).trans threshold) ((le_max_left ..).trans threshold) tcap bt cheap gen many
  refine ⟨V,vt.trans ts,R,rv,?_,small,?_,all⟩
  · exact size.trans ((Nat.mul_le_mul_left (4*s) ratio).trans_eq (by ring))
  · rw [←fourFamily_eq]
    exact (Nat.pow_le_pow_left (Finset.card_le_card vt) 2).trans (keep.trans_eq (by ring))

end Erdos101OverlapExponent
